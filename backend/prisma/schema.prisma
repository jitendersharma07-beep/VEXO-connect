// ATC Infocom Solutions Pvt. Ltd. — ATC POS
// Multi-tenant schema. Tenant boundary = Company; Branch belongs to exactly one
// Company. ATC-level operators (POS_SUPER_ADMIN) have companyId = null and are
// the only cross-tenant principals. This database is dedicated to ATC POS —
// it shares nothing with ATC NOC, Megatel, Review Manager or WhatsApp.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PosRole {
  POS_SUPER_ADMIN // ATC staff, cross-company
  CUSTOMER_OWNER // owns one company, all its branches
  BRANCH_MANAGER // one branch of one company
  CASHIER // one branch of one company
  // Appended, never reordered or renamed: a Postgres enum value carries an
  // ordinal and the four above are already written into live PosUser rows.
  // BRANCH_MANAGER is the spec's Store Manager and keeps its old name, because
  // renaming it would rewrite every row that holds it.
  COMPANY_ADMIN // whole company; the admin work an owner delegates
  FINANCE // whole company; money and tax, sells nothing
  REGIONAL_MANAGER // the stores of one Region, never the whole company
  CAPTAIN // one store; takes orders, cannot bill
  KITCHEN // one store; KOT screens only
  INVENTORY // stock, at the store or the company
  PURCHASE // company; vendors and purchase orders
  DELIVERY // one store; delivery handover
  AUDITOR // reads what it is granted, writes nothing
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum PosUserStatus {
  ACTIVE
  DISABLED
}

enum BranchStatus {
  ACTIVE
  CLOSED
}

enum LicensePlan {
  FREE_TRIAL
  SINGLE_STORE
  MULTI_STORE
}

// EXPIRED is deliberately not a stored status: expiry is a fact about
// expiresAt vs now, computed at read time, so a lapsed licence can never be
// "un-expired" by a forgotten cron or a missed write.
enum LicenseStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LicenseAddonKind {
  ADDITIONAL_BRANCH
}

model Company {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  status       CompanyStatus @default(ACTIVE)
  // Demo tenants are first-class but unmistakable: the flag propagates to the
  // UI as a persistent badge and demo rows never mix with customer rows.
  isDemo       Boolean       @default(false)
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branches Branch[]
  users    PosUser[]
  licenses License[]

  taxRates   TaxRate[]
  categories Category[]
  products   Product[]
  orders     Order[]
  dayCloses  DayClose[]

  discountPolicies DiscountPolicy[]

  // LANE foundation
  legalEntities     LegalEntity[]
  gstRegistrations  GstRegistration[]
  brands            Brand[]
  regions           Region[]
  terminals         Terminal[]
  devices           Device[]
  permissionRules   PermissionRule[]
  supportGrants     SupportAccessGrant[]
  promotions        Promotion[]
  customers         Customer[]
  phoneOrders       PhoneOrder[]

  // LANE providers
  integrationConnections IntegrationConnection[]
}

model Branch {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  name        String
  code        String
  status      BranchStatus @default(ACTIVE)
  isDemo      Boolean      @default(false)
  addressLine String?
  city        String?
  state       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ---- LANE foundation ----------------------------------------------------
  // The VEXO Store ID: minted once, printed on invoices, quoted in support
  // tickets, never editable. `name` and `code` are the customer's to change;
  // this is the identity everything else points at. `id` is a cuid and stays
  // the database key — publicId exists because a human has to be able to read
  // it out over the phone.
  publicId          String           @unique
  pincode           String?
  // Which registered business this store trades as, and under which GSTIN.
  // Nullable because a tenant configures these after the store exists, and a
  // store that has not been mapped yet must not be unusable — billing refuses
  // to issue a GST invoice without a registration instead.
  //
  // These three are COMPOSITE references, carrying companyId alongside the id.
  // Tenancy is then a foreign key: the database itself refuses to link a store
  // to another customer's entity, GSTIN or region, on UPDATE as well as on
  // INSERT. Cross-table agreement expressed this way rather than as a CHECK,
  // because a CHECK cannot see another table and a trigger pretending to is
  // not a constraint — it is a race.
  //
  // MATCH SIMPLE (the default) skips the check when the nullable id is NULL,
  // which is exactly right: an unmapped store has nothing to verify. The
  // gstRegistrationId reference carries legalEntityId too, so the GSTIN must
  // belong to the entity this store trades as; the SQL CHECK
  // `Branch_gst_needs_entity` closes the one gap that leaves, a GSTIN set
  // while legalEntityId is still NULL.
  legalEntityId     String?
  legalEntity       LegalEntity?     @relation(fields: [legalEntityId, companyId], references: [id, companyId], onDelete: Restrict)
  gstRegistrationId String?
  gstRegistration   GstRegistration? @relation(fields: [gstRegistrationId, legalEntityId, companyId], references: [id, legalEntityId, companyId], onDelete: Restrict)
  regionId          String?
  region            Region?          @relation(fields: [regionId, companyId], references: [id, companyId], onDelete: Restrict)
  // Invoice series prefix. Null = use `code`, which is what every existing
  // store does. Set it once and a later code change cannot relabel the series,
  // because the counter is keyed by branch and FY, not by the prefix.
  invoicePrefix     String?
  // Per-premises, not per-company: an FSSAI licence is issued to the kitchen at
  // this address, and it is the number that has to appear on this store's bills.
  fssaiLicenseNo    String?
  fssaiValidUpto    DateTime?

  users PosUser[]

  tables          DiningTable[]
  orders          Order[]
  invoiceCounters InvoiceCounter[]
  dayCloses       DayClose[]

  discountPolicies DiscountPolicy[]
  kitchenStations  KitchenStation[]

  // LANE foundation
  terminals       Terminal[]
  devices         Device[]
  brandLinks      BranchBrand[]
  permissionRules PermissionRule[]
  userAssignments UserStoreAssignment[]
  promotionLinks  PromotionStore[]
  serviceAreas        BranchServiceArea[]
  hours               BranchHours[]
  prepCapacity        BranchPrepCapacity?
  phoneOrdersRouted   PhoneOrder[]        @relation("PhoneOrderRouted")
  phoneOrdersAccepted PhoneOrder[]        @relation("PhoneOrderAccepted")

  // LANE providers
  integrationOutlets IntegrationOutlet[]
  aggregatorOrders   AggregatorOrder[]

  @@unique([companyId, code])
  // Referenced by everything that happens AT a store — terminals, devices,
  // orders, assignments — so that each of those carries the tenant and has it
  // checked, instead of trusting whoever wrote the row.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@index([regionId])
  @@index([legalEntityId])
}

model PosUser {
  id                 String        @id @default(cuid())
  // null companyId = ATC operator. Every customer principal carries one.
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  // Branch-scoped roles (BRANCH_MANAGER, CASHIER) carry the branch they are
  // pinned to; owner/ATC rows leave it null.
  branchId           String?
  // Composite where it can be. A platform operator has a NULL companyId, and
  // MATCH SIMPLE skips the check when any referencing column is NULL — so this
  // constrains customer principals, which are the ones that have a branch at
  // all, and leaves operator rows alone. Operators are kept out of tenant data
  // by requireTenantPrincipal and the support-grant gate, not by this.
  //
  // Restrict, where the single-column version was SET NULL. Postgres nulls
  // EVERY referencing column of a composite key, so deleting a branch under the
  // old action would also blank companyId here — silently promoting a cashier
  // into something with no tenant at all, which is what a platform operator
  // looks like. Stores are retired by status, not deleted, so refusing the
  // delete costs nothing and removes that path entirely.
  branch             Branch?       @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  email              String        @unique
  fullName           String
  passwordHash       String
  role               PosRole
  status             PosUserStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions PosSession[]

  ordersOpened     Order[]         @relation("OrderOpenedBy")
  ordersVoided     Order[]         @relation("OrderVoidedBy")
  itemsVoided      OrderItem[]     @relation("OrderItemVoidedBy")
  paymentsReceived Payment[]       @relation("PaymentReceivedBy")
  refundsIssued    Refund[]        @relation("RefundBy")
  intentsCreated   PaymentIntent[] @relation("PaymentIntentCreatedBy")
  daysClosed       DayClose[]      @relation("DayClosedBy")

  discountPolicies  DiscountPolicy[] @relation("DiscountPolicySubject")
  discountsApproved Order[]          @relation("OrderDiscountApprovedBy")

  // ---- LANE foundation ----------------------------------------------------
  // A REGIONAL_MANAGER is scoped by region, not by a single branch, so it
  // cannot use branchId. Null for every other role.
  regionId String?
  region   Region? @relation(fields: [regionId, companyId], references: [id, companyId], onDelete: Restrict)

  // Explicit multi-store scope. A user with no assignments is scoped by role
  // alone; a user with assignments is scoped by exactly those stores. See the
  // authoritative statement on UserStoreAssignment and in lib/permissions.js
  // (`storeScopeFor`).
  storeAssignments   UserStoreAssignment[] @relation("StoreAssignmentUser")
  storeAssignmentsBy UserStoreAssignment[] @relation("StoreAssignmentCreatedBy")

  permissionRules    PermissionRule[]     @relation("PermissionRuleSubject")
  permissionRulesSet PermissionRule[]     @relation("PermissionRuleUpdatedBy")
  devicesEnrolled    Device[]             @relation("DeviceEnrolledBy")
  devicesRevoked     Device[]             @relation("DeviceRevokedBy")
  supportGrants      SupportAccessGrant[] @relation("SupportGrantOperator")
  supportGrantsGiven SupportAccessGrant[] @relation("SupportGrantGrantedBy")
  promotionsCreated  Promotion[]           @relation("PromotionCreatedBy")
  promotionsApplied  PromotionRedemption[] @relation("PromotionAppliedBy")
  customersCreated    Customer[]   @relation("CustomerCreatedBy")
  phoneOrdersOperated PhoneOrder[] @relation("PhoneOrderOperator")
  phoneOrdersAccepted PhoneOrder[] @relation("PhoneOrderAcceptedBy")
  phoneOrdersRejected PhoneOrder[] @relation("PhoneOrderRejectedBy")

  // LANE providers
  discrepanciesResolved IntegrationDiscrepancy[] @relation("DiscrepancyResolvedBy")
  loyaltyImportsStarted LoyaltyImportRun[]       @relation("LoyaltyImportStartedBy")

  // Referenced by PermissionRule and UserStoreAssignment so a tenant's rule or
  // assignment can only name a principal of that same tenant.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([regionId])
}

model PosSession {
  id        String    @id @default(cuid())
  userId    String
  user      PosUser   @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
}

model License {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  plan            LicensePlan
  status          LicenseStatus @default(ACTIVE)
  startsAt        DateTime      @default(now())
  expiresAt       DateTime
  // Branch entitlement of the base plan. SINGLE_STORE is clamped to 1 at read
  // time regardless of what is stored; MULTI_STORE adds active addons on top.
  baseBranchLimit Int           @default(1)
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  addons LicenseAddon[]

  @@index([companyId])
}

model LicenseAddon {
  id        String           @id @default(cuid())
  licenseId String
  license   License          @relation(fields: [licenseId], references: [id])
  kind      LicenseAddonKind @default(ADDITIONAL_BRANCH)
  quantity  Int              @default(1)
  expiresAt DateTime?
  notes     String?
  createdAt DateTime         @default(now())

  @@index([licenseId])
}

// ---------------------------------------------------------------------------
// Discount authority — who may take money off a bill, and how far.
//
// Resolved most-specific-first: USER override → BRANCH override → COMPANY
// default → nothing. A company with no rows discounts nothing at all, which
// is the right state for a till that has just been handed over: permission is
// granted, never assumed. There is deliberately no constant in this codebase
// that says "a cashier may give 10%" — every ceiling is data the customer's
// own admin sets.
// ---------------------------------------------------------------------------

enum DiscountPolicyLevel {
  COMPANY
  BRANCH
  USER
}

model DiscountPolicy {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id])
  level     DiscountPolicyLevel
  // Restrict, not the Prisma default of SET NULL: a policy row silently
  // widening from "this branch" to "the whole company" because somebody
  // removed a branch is not a state this table should be able to reach.
  branchId  String?
  branch    Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId    String?
  user      PosUser?            @relation("DiscountPolicySubject", fields: [userId], references: [id], onDelete: Restrict)

  // Postgres counts NULLs in a unique index as distinct, so a nullable
  // (branchId, userId) pair would happily hold a hundred "company defaults".
  // scopeKey is the same fact written so the index can actually bite:
  // "company" | "branch:<id>" | "user:<id>".
  scopeKey String

  // null = inherit from the level above. At COMPANY level there is nothing
  // above, so null there reads as "not allowed".
  allowLineDiscount  Boolean?
  allowOrderDiscount Boolean?

  // Ceilings on the COMBINED discount — every line discount plus the
  // order-level discount — measured against the order's gross. Both kinds may
  // be set at once, in which case both bind and the tighter one decides.
  // Percent is Decimal(6,3) like the tax rates; the flat cap is integer paise,
  // so no float ever takes part in a limit comparison.
  maxPercent   Decimal? @db.Decimal(6, 3)
  maxFlatPaise Int?

  // What this principal may authorise — for somebody else, or for themselves
  // above their own operating ceiling. A cashier approves nothing until an
  // admin says otherwise.
  canApprove           Boolean?
  maxApprovalPercent   Decimal? @db.Decimal(6, 3)
  maxApprovalFlatPaise Int?

  note        String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, scopeKey])
  @@index([companyId, level])
  @@index([branchId])
  @@index([userId])
}

model PosAuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  // The role the actor held when they did it, not the role they hold now.
  // Nullable because every row written before this column existed genuinely
  // does not know, and deriving one by joining PosUser today would backdate a
  // promotion onto an action taken before it.
  actorRole  String?
  companyId  String?
  action     String
  entity     String?
  entityId   String?
  ip         String?
  meta       Json?
  // LANE foundation — plain columns with no foreign key, like actorId above.
  // An audit write must never be the thing that fails a request, and a log row
  // that cannot be written because its subject was removed is worse than a log
  // row pointing at an id that no longer resolves.
  terminalId String?
  deviceId   String?

  @@index([companyId, at])
  @@index([action, at])
  @@index([deviceId, at])
}

// ---------------------------------------------------------------------------
// Phase 2 — catalog, tables, orders/KOT/billing, manual payments, reports.
// All money columns are DECIMAL(10,2) rupees; arithmetic happens in integer
// paise in src/lib/money.js and results are written back exact to 2dp.
// ---------------------------------------------------------------------------

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum TableStatus {
  ACTIVE
  RETIRED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  BILLED
  PAID
  VOID
  REFUNDED
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

enum DiscountType {
  FLAT
  PERCENT
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

// MANUAL = hand-recorded by staff, never presented as gateway-verified.
// GATEWAY = settled by the provider and confirmed by a signature-verified
// webhook. Nothing else may ever write GATEWAY.
enum PaymentChannel {
  MANUAL
  GATEWAY
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

// A manual refund is SUCCEEDED on creation — the cash is already out of the
// drawer. A gateway refund starts PENDING and only the provider can move it.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model TaxRate {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  ratePercent Decimal       @db.Decimal(6, 3)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products Product[]

  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  promotionRules PromotionItemRule[]

  @@unique([companyId, name])
  // Referenced by PromotionItemRule so a rule can only name this tenant's menu.
  @@unique([id, companyId])
  @@index([companyId])
}

model Product {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  name       String
  sku        String?
  basePrice  Decimal       @db.Decimal(10, 2)
  taxRateId  String?
  taxRate    TaxRate?      @relation(fields: [taxRateId], references: [id])
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  variants       ProductVariant[]
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  promotionRules PromotionItemRule[]

  @@unique([companyId, sku])
  // Referenced by PromotionItemRule — same rule as Category.
  @@unique([id, companyId])
  @@index([companyId, categoryId])
}

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  // Absolute unit price for this variant (not a delta on basePrice).
  price     Decimal       @db.Decimal(10, 2)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

// Optional add-ons on a product (extra cheese, toppings). A group bounds the
// choice (minSelect..maxSelect per unit); an option carries a per-unit price
// ADDED to the variant/base price. Promotion treatment (spec VC-102): the
// modifier price is part of the line the promotion computes on — an eligible
// line's benefit base includes its modifiers, an excluded line's modifiers
// are excluded with it.
model ModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  minSelect Int           @default(0)
  // Null = no upper bound.
  maxSelect Int?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  options ModifierOption[]

  @@unique([productId, name])
  @@index([productId])
}

model ModifierOption {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id])
  name    String
  // Per-unit price added on top of the variant/base price. Zero is allowed.
  price   Decimal       @db.Decimal(10, 2)
  status  CatalogStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([groupId, name])
  @@index([groupId])
}

// Snapshot of one chosen modifier on one order line — name and per-unit price
// frozen at add time, like the line itself. optionId is a plain string, not a
// foreign key: the receipt must survive any later catalog change.
model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  optionId    String
  groupName   String
  name        String
  price       Decimal   @db.Decimal(10, 2)

  @@index([orderItemId])
}

model DiningTable {
  id        String      @id @default(cuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  name      String
  capacity  Int?
  status    TableStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders Order[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Order {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id])
  branchId             String
  branch               Branch        @relation(fields: [branchId, companyId], references: [id, companyId])
  type                 OrderType
  status               OrderStatus   @default(OPEN)
  tableId              String?
  table                DiningTable?  @relation(fields: [tableId], references: [id])
  // Assigned at bill time; format <branchCode>/<fy>/<seq5>. Unique per
  // company (branch codes are unique per company, not globally).
  invoiceNumber        String?
  openedById           String
  openedBy             PosUser       @relation("OrderOpenedBy", fields: [openedById], references: [id])
  discountType         DiscountType?
  discountValue        Decimal?      @db.Decimal(10, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 2)
  // Who allowed the discount this bill carries, and why. Snapshotted, not
  // re-derived: tomorrow's policy edit must never make yesterday's invoice
  // unexplainable. Null means the discount sat inside the operator's own
  // limit and needed nobody — or that there is no discount at all.
  // Restrict: deleting the approver must not quietly turn an approved
  // discount into an unexplained one.
  discountApprovedById String?
  discountApprovedBy   PosUser?      @relation("OrderDiscountApprovedBy", fields: [discountApprovedById], references: [id], onDelete: Restrict)
  discountApprovedAt   DateTime?
  discountReason       String?
  subtotal             Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal       @default(0) @db.Decimal(10, 2)
  total                Decimal       @default(0) @db.Decimal(10, 2)
  note                 String?
  voidReason           String?
  voidedById           String?
  voidedBy             PosUser?      @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  billedAt             DateTime?
  closedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // ---- LANE foundation ----------------------------------------------------
  // Everything the issued invoice legally asserted about the seller, frozen at
  // bill time: legal name, GSTIN, registered address, state code, FSSAI, store
  // id and series prefix. The seller's master data is editable by design, so
  // re-deriving these at print time would let a GSTIN corrected in March
  // silently restate a January invoice. Null on every order billed before this
  // column existed — those receipts keep reading from the live records, which
  // is the only information that ever existed for them. Never backfilled with
  // today's values pretending to be that day's.
  billingSnapshot Json?
  // Which till and which physical device rang it up. Nullable: a bill taken on
  // a browser that never enrolled has no device, and that is not an error.
  //
  // Both carry branchId, so attribution is checked against the store the
  // transaction actually happened in. An order cannot claim to have been rung
  // up on another store's counter.
  terminalId      String?
  terminal        Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  deviceId        String?
  device          Device?   @relation(fields: [deviceId, branchId], references: [id, branchId], onDelete: Restrict)

  // ---- LANE providers -----------------------------------------------------
  // Where this order came FROM, which is a different question from how it is
  // served (that is `type`, DINE_IN or TAKEAWAY) and from how it is delivered
  // (that is PhoneOrder.fulfilment). B§9 p7 requires the Orders screen to be
  // able to tell these apart before any integration ships, so the column lands
  // with the integrations rather than after them.
  //
  // Defaulting to POS is what makes this safe to add to a live table: every
  // order that already exists was rung up at a counter, and that is exactly
  // what the default asserts. No backfill invents anything.
  channel         OrderChannel         @default(POS)
  // Which provider, when the channel is AGGREGATOR. The pair is deliberately
  // not a single "SWIGGY_ORDER" channel value: adding a provider must not
  // require a migration, which is the schema-churn B§9 p7 forbids.
  channelProvider IntegrationProvider?
  // The provider's own id for this order, denormalised onto the order so the
  // Orders screen and any export can quote it without joining. AggregatorOrder
  // holds the authoritative copy and the uniqueness constraint that stops a
  // repeated callback creating a second bill.
  externalOrderId String?

  items       OrderItem[]
  kots        Kot[]
  payments    Payment[]
  refunds     Refund[]
  intents     PaymentIntent[]
  redemptions PromotionRedemption[]
  phoneOrder  PhoneOrder?

  // LANE providers
  aggregatorOrder   AggregatorOrder?
  loyaltyOperations LoyaltyOperation[]

  @@unique([companyId, invoiceNumber])
  // Lets a payment reference (orderId, branchId), which is what ties the money
  // to the same store as the bill.
  @@unique([id, branchId])
  // Lets a promotion redemption reference (orderId, companyId, branchId) in
  // one foreign key, tying it to the same tenant AND store as the bill.
  @@unique([id, companyId, branchId])
  @@index([companyId, branchId, status])
  @@index([companyId, billedAt])
  @@index([tableId])
  @@index([discountApprovedById])
  @@index([terminalId])
  @@index([deviceId])
  // LANE providers — the Orders screen filters by where the order came from.
  @@index([companyId, channel, billedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  // Snapshots at add time — later catalog edits never change this line.
  name           String
  // Per-unit price INCLUDING chosen modifiers (base/variant + Σ modifier
  // prices). The modifiers relation below is the printed breakdown; all money
  // math reads this one column, so promotions and taxes see modifiers by
  // construction.
  unitPrice      Decimal         @db.Decimal(10, 2)
  qty            Int
  lineDiscount   Decimal         @default(0) @db.Decimal(10, 2)
  taxRateName    String?
  taxRatePercent Decimal?        @db.Decimal(6, 3)
  // Stored results of the §6 contract math (incl. order-discount share).
  lineSubtotal   Decimal         @default(0) @db.Decimal(10, 2)
  discountShare  Decimal         @default(0) @db.Decimal(10, 2)
  lineTax        Decimal         @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal         @default(0) @db.Decimal(10, 2)
  kotId          String?
  kot            Kot?            @relation(fields: [kotId], references: [id])
  status         OrderItemStatus @default(ACTIVE)
  voidReason     String?
  voidedById     String?
  voidedBy       PosUser?        @relation("OrderItemVoidedBy", fields: [voidedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Kitchen instruction for this line ("no onion"). Printed on the KOT and
  // shown on the station, never on the customer's receipt. See LANE kitchen.
  note           String?
  kitchenItem    KitchenItem?

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model Kot {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  seq       Int
  createdAt DateTime @default(now())

  items OrderItem[]
  kitchenItems KitchenItem[]

  @@unique([orderId, seq])
}

model Payment {
  id           String         @id @default(cuid())
  orderId      String
  // Carried on the payment, not looked up through the order, because it is the
  // column the terminal and device references below are checked against. A
  // payment therefore cannot be attributed to a till or a device belonging to
  // a store other than the one that issued the bill. Backfilled from the order
  // for every payment written before this column existed.
  branchId     String
  order        Order          @relation(fields: [orderId, branchId], references: [id, branchId])
  method       PaymentMethod
  channel      PaymentChannel @default(MANUAL)
  // amount = applied to the order (≤ remaining due). For cash, tendered is
  // what the customer handed over; change = tendered − amount, never stored.
  amount       Decimal        @db.Decimal(10, 2)
  tendered     Decimal?       @db.Decimal(10, 2)
  note         String?
  // Null for GATEWAY: the provider settled it, no member of staff received
  // anything. Recording the cashier here would misattribute the money.
  receivedById String?
  receivedBy   PosUser?       @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  // Unique, so one intent can never settle twice however often the provider
  // redelivers. This is the last line of defence behind webhook idempotency.
  intentId     String?        @unique
  intent       PaymentIntent? @relation(fields: [intentId], references: [id])
  // The provider's id for the CHARGE, which is not its id for the attempt.
  // A Razorpay refund posts to /payments/<this>/refund, while the attempt is
  // an order_… held on PaymentIntent.providerRef — so without this column a
  // gateway payment cannot be refunded at all. Null for MANUAL, and for any
  // provider that names the attempt and the charge with one id.
  providerRef  String?        @unique
  // Makes a RETRIED manual payment return the first one instead of collecting
  // the bill twice — the same job PaymentIntent.idempotencyKey does for the
  // gateway, which the manual path never had.
  //
  // It is needed because the guards on the payments route cannot see this case.
  // They refuse a second payment once the order is PAID or nothing is due, which
  // happens to cover a retried payment for the FULL amount — and so the hole
  // looked closed. A PARTIAL payment leaves the order BILLED with money still
  // due, so a retry passes both guards and is written again. Proven on the
  // deployed build against BSC-CP/26-27/00011: the response to a ₹47.25 card
  // payment was dropped after the server had committed it, the cashier pressed
  // Record payment again, and a ₹94.50 bill came out PAID on two ₹47.25 rows
  // for one swipe. Split bills are ordinary in a café, so this is the common
  // case, not the exotic one.
  //
  // Nullable, and unique only per order: gateway payments and every row written
  // before this column existed carry NULL, and Postgres treats NULLs as distinct
  // so any number of them coexist. Scoping to the order rather than making it
  // globally unique means a till that reuses a key across orders — a clock reset,
  // a cloned device — cannot suppress a real payment on a different bill.
  idempotencyKey String?

  createdAt    DateTime       @default(now())

  // LANE foundation — which till and device took the money. A cash variance is
  // only answerable if the drawer it came out of is on the row.
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId, branchId], references: [id, branchId], onDelete: Restrict)

  @@unique([orderId, idempotencyKey])
  @@index([branchId])
  @@index([orderId])
  @@index([createdAt])
  @@index([terminalId])
  @@index([deviceId])
}

// One attempt to collect an order's due amount through a provider. Order-linked
// so reconciliation can always put "what we asked for" beside "what arrived".
model PaymentIntent {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  provider       String
  // The provider's own id for the attempt; null until the provider answers.
  // Postgres treats NULLs as distinct, so many un-answered intents coexist.
  providerRef    String?
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("INR")
  status         PaymentIntentStatus @default(CREATED)
  // Sent to the provider, so a retried create returns the first attempt
  // instead of opening a second one the customer could also pay.
  idempotencyKey String              @unique
  failureReason  String?
  createdById    String
  createdBy      PosUser             @relation("PaymentIntentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  closedAt       DateTime?

  payment       Payment?
  webhookEvents GatewayWebhookEvent[]
  refunds       Refund[]              @relation("RefundIntent")

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status])
}

// Which code path wrote the row. WEBHOOK is a delivery that arrived at
// /api/gateway/webhook and passed signature verification. RECOVERY is one the
// pull-based reconcile built after ASKING the provider what it has, for an
// intent whose webhook never turned up.
//
// Authoritative about our side only. It records which of our code paths ran;
// it is not a claim about who originated the event, because a verified
// delivery can be signed by anything holding the webhook secret — which on a
// dev box includes this repository's own scripts.
enum GatewayEventSource {
  WEBHOOK
  RECOVERY
}

// One row per signature-VERIFIED delivery. Rejected deliveries are deliberately
// NOT stored here: eventId comes from the payload, so recording unverified ones
// would let anyone squat the unique key with a forged id and permanently block
// the genuine event from ever being applied. Rejections go to PosAuditLog.
model GatewayWebhookEvent {
  id            String             @id @default(cuid())
  provider      String
  eventId       String
  kind          String
  payloadHash   String
  // No default, so every writer has to say which it is. A default of WEBHOOK
  // would quietly label a future path's rows as provider deliveries.
  source        GatewayEventSource
  // Set only when the delivery matched a real intent. This is also the only
  // route by which an event can be attributed to a company, since events
  // carry no tenant of their own.
  intentId      String?
  intent        PaymentIntent?     @relation(fields: [intentId], references: [id])
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  // Why a verified delivery still changed nothing — unknown intent, already
  // settled, order no longer billable. Null once it has been applied.
  skippedReason String?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([processedAt])
  @@index([source])
}

model Refund {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  amount         Decimal        @db.Decimal(10, 2)
  reason         String
  // MANUAL: cash or card handed back across the counter. Done the moment it
  // happens, because a person did it.
  //
  // GATEWAY: only the provider can move this money back. Writing the row
  // returns nothing to anybody, so the refund stays a REQUEST until a
  // signature-verified webhook says the provider actually paid it out. A
  // PENDING refund must never be shown, totalled or reported as money returned.
  channel        PaymentChannel @default(MANUAL)
  status         RefundStatus   @default(SUCCEEDED)
  // How a MANUAL refund went back: notes out of the till, or a reversal on the
  // card terminal, or a UPI transfer. Only CASH leaves the drawer, and the day
  // close cannot tell the difference without it — every manual refund used to
  // be counted as cash, so refunding a card bill made an honest count read
  // "over" by exactly that amount.
  //
  // Null on GATEWAY rows (the provider returns it) and on every manual row
  // written before this column existed. Those old rows are still read as cash,
  // so no past closing, and no after-the-count figure, moves.
  method         PaymentMethod?
  // The gateway payment being reversed, and the provider's own reference for
  // the reversal. providerRef is unique so a redelivered refund webhook lands
  // on exactly one row.
  //
  // A GATEWAY row that is PENDING with a NULL providerRef is the unknown
  // state: the request was reserved here, but the provider never told us
  // whether it took it. It may already be paying out. It therefore keeps
  // holding its amount and must be reconciled, never re-requested.
  intentId       String?
  intent         PaymentIntent? @relation("RefundIntent", fields: [intentId], references: [id])
  providerRef    String?        @unique
  // Sent to the provider, and kept, so a request whose outcome we never
  // learned can be re-sent as THE SAME request. Without a stored key a retry
  // is a second refund and the customer is paid twice. Null for MANUAL, where
  // there is no provider to deduplicate against.
  idempotencyKey String?        @unique
  failureReason  String?
  byId           String
  by             PosUser        @relation("RefundBy", fields: [byId], references: [id])
  createdAt      DateTime       @default(now())
  settledAt      DateTime?

  @@index([orderId])
  @@index([status])
}

// One row per branch per financial year; bill transactions increment
// lastNumber atomically, so concurrent bills can never share a number.
model InvoiceCounter {
  id         String @id @default(cuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
  fyLabel    String
  lastNumber Int    @default(0)
  // The series this year's bills are issued under, frozen when the year's
  // first bill is issued. Read back for every later bill in the same series,
  // so editing Branch.code or Branch.invoicePrefix mid-year cannot relabel a
  // running series. See lib/invoice.js.
  //
  // Backfilled for existing counters from the invoice numbers already issued
  // under them — historical evidence, not today's branch values.
  seriesPrefix String

  @@unique([branchId, fyLabel])
}

// One branch's end-of-day cash count. The system already knows what it
// BELIEVES is in the drawer; this records what someone actually counted, and
// the difference between the two.
//
// The difference is the entire point. A POS that only ever reports its own
// figures cannot tell an owner about a till that is short — it has no
// independent measurement to disagree with. Cash is the only tender where the
// business holds the money physically and can therefore lose it physically,
// so it is the only one counted here; card and UPI are reported for the day
// but not declared, because the bank's figure settles those, not a cashier's.
//
// Immutable once written. A closing that can be edited after the fact is not
// evidence of anything, and the reason to reopen a day is almost always that
// someone disliked the variance. A correction is a new row, which is why
// (branchId, businessDate) is not unique and `supersededById` exists.
model DayClose {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id])
  // IST calendar day, 'YYYY-MM-DD'. A café's day is not a UTC day, and a
  // closing done at 23:40 IST must land on the day the staff were working.
  businessDate String

  // Counted by hand, in the drawer, including the float that started the day.
  countedCashPaise  Int
  openingFloatPaise Int @default(0)

  // What the system believed, frozen at the moment of closing. Recomputed
  // later these would drift — a refund settled the next morning would rewrite
  // history — and a closing that changes after it is signed is worthless.
  expectedCashPaise Int
  cashSalesPaise    Int
  cashRefundsPaise  Int
  // Non-cash is recorded for the day's report but never declared.
  cardSalesPaise    Int @default(0)
  upiSalesPaise     Int @default(0)
  otherSalesPaise   Int @default(0)
  gatewaySalesPaise Int @default(0)
  // countedCash − openingFloat − expectedCash. Positive is over, negative short.
  variancePaise     Int
  ordersBilled      Int @default(0)

  // Required when the count disagrees, enforced in the route: an unexplained
  // variance is the one an owner most needs explained.
  note String?

  closedById String
  closedBy   PosUser  @relation("DayClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime @default(now())

  // A correcting closing points at the one it replaces. Reading the latest row
  // per day gives the current truth; the chain keeps what was said before it.
  supersededById String?   @unique
  supersedes     DayClose? @relation("DayCloseCorrection", fields: [supersededById], references: [id])
  correctedBy    DayClose? @relation("DayCloseCorrection")

  @@index([companyId, businessDate])
  @@index([branchId, businessDate])
}

// ===========================================================================
// LANE foundation — Expansion Phase 1: organisation, identity, terminals,
// devices and the permission/scope layer. Spec Part A §7, Part B §3/§5/§11.
//
// The shape is Tenant (Company) → Legal Entity → GST Registration → Store
// (Branch) → Terminal → Device. Brand, Region and Inventory Location are
// deliberately NOT levels of that chain — they are separate dimensions a store
// is tagged with, because a single outlet can trade two brands and an inventory
// location does not own a bill. InventoryLocation belongs to the inventory
// lane and is not created here.
//
// Nothing below renames an existing table or column. `Branch` stays `Branch`
// in the database however the screens spell it.
// ===========================================================================

// The registered business that actually sells. One tenant can hold several —
// a group running two companies under one VEXO login is the ordinary case, not
// the exotic one.
model LegalEntity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Exactly as it appears on the certificate of incorporation, because this is
  // the string a tax invoice has to carry. The brand customers recognise lives
  // in `Brand`, and the two are usually different.
  legalName String
  tradeName String?
  // PAN and CIN are the entity's identity, not the tenant's. Nullable because a
  // tenant may configure stores before Finance hands over the paperwork, and
  // refusing to save a legal entity until then would just push the data into a
  // spreadsheet. The uniqueness is per tenant: two tenants legitimately holding
  // the same PAN (an agency setting up a client) must not be able to discover
  // each other through a 409.
  pan       String?
  cin       String?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gstRegistrations GstRegistration[]
  branches         Branch[]

  @@unique([companyId, legalName])
  @@unique([companyId, pan])
  // Redundant on its own — `id` is already the key. It exists so children can
  // point at (id, companyId) instead of (id), which is what makes "this row
  // belongs to that tenant" a foreign key rather than a hope. See the tenancy
  // note on Branch.
  @@unique([id, companyId])
  @@index([companyId])
}

// One GSTIN. A legal entity registered in four states has four of these, and a
// store maps to exactly one — that mapping is what decides the GSTIN, the
// place of supply and the invoice series a bill is issued under.
model GstRegistration {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  legalEntityId String
  // Composite: the entity must be one of THIS tenant's. A single-column
  // reference would happily accept another customer's legal entity id.
  legalEntity   LegalEntity @relation(fields: [legalEntityId, companyId], references: [id, companyId], onDelete: Restrict)
  gstin         String
  // The trade name on THIS registration. It can differ from the entity's, which
  // is why it is not read off LegalEntity.
  tradeName     String?
  // First two digits of the GSTIN. Stored rather than derived so the invoice
  // snapshot is self-contained, and constrained in SQL so it can never
  // disagree with the GSTIN it came from.
  stateCode     String
  stateName     String
  addressLine   String?
  city          String?
  pincode       String?
  status        CatalogStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branches Branch[]

  // Per tenant, not global. A globally unique GSTIN would answer "does another
  // VEXO customer already use this number?" to anyone who can type one in.
  @@unique([companyId, gstin])
  // Lets Branch reference a registration by (id, legalEntityId, companyId), so
  // a store's GSTIN is forced to belong both to the store's tenant AND to the
  // store's own legal entity. Without the middle column a branch could name
  // entity A and a GSTIN registered to entity B, and the invoice would assert
  // a pairing that does not exist.
  @@unique([id, legalEntityId, companyId])
  @@index([companyId])
  @@index([legalEntityId])
}

// Monotonic counters for ids that are public and permanent. Same idiom as
// InvoiceCounter: one row, incremented inside the caller's transaction, so two
// stores created at the same instant cannot be handed the same number.
model PlatformCounter {
  key        String @id
  lastNumber Int    @default(0)
}

// A customer-facing brand. A food court unit selling under two names is one
// store with two brands, not two stores — which is why this is a separate
// dimension and not a level above Branch.
model Brand {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  storeLinks BranchBrand[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId])
}

// Store ↔ brand. `companyId` is carried on the link row itself so BOTH sides
// can be tied to the same tenant by foreign key: without it the two ids are
// independently valid and nothing stops one tenant's store being linked to
// another tenant's brand.
model BranchBrand {
  branchId  String
  companyId String
  branch    Branch   @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  brandId   String
  brand     Brand    @relation(fields: [brandId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([branchId, brandId])
  @@index([brandId])
  @@index([companyId])
}

// A region or cluster of stores. `parentId` lets a tenant nest cluster inside
// region without a second table; it is not a reporting hierarchy and carries no
// permissions of its own — a REGIONAL_MANAGER's reach comes from the stores
// that point here.
model Region {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  parentId  String?
  // Composite, so a cluster can only nest inside a region of the same tenant.
  parent    Region?       @relation("RegionTree", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  children Region[]  @relation("RegionTree")
  branches Branch[]
  users    PosUser[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([parentId])
}

enum TerminalStatus {
  ACTIVE
  DISABLED
}

// A logical till: "Counter 1", "Drive-through". Bound to one store for its
// whole life — a terminal that could move between stores would make the day's
// cash belong to two places at once.
model Terminal {
  id        String @id @default(cuid())
  // Denormalised from the branch on purpose, and written by the server from the
  // branch it resolved — never from the request. Device authentication has to
  // establish the tenant on every single call, and it must not need a join to
  // do it.
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String
  // Composite: the denormalised companyId above is only trustworthy if the
  // database checks it against the branch. This is that check.
  branch    Branch  @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  code      String
  name      String
  status    TerminalStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  devices  Device[]
  orders   Order[]
  payments Payment[]

  @@unique([branchId, code])
  // So a device, an order or a payment can name (terminalId, branchId) and
  // have the pairing enforced — a till from another store can never be
  // attributed to this store's takings.
  @@unique([id, branchId])
  @@index([companyId])
  @@index([branchId])
}

enum DeviceType {
  COUNTER
  KDS
  CUSTOMER_DISPLAY
  HANDHELD
  OTHER
}

// PENDING = enrolled, no credential issued yet. ACTIVE = holds a live token.
// REVOKED = terminal state; the row stays for the audit trail and for the
// orders that point at it, but its token is gone.
enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ==== LANE kitchen ====
// VC-103 kitchen orchestration (stations, routing, per-line preparation state)
// and the Store Agent print queue. Everything here hangs off the EXISTING Kot
// and OrderItem rows: a kitchen ticket IS a KOT id, and a kitchen line IS an
// order line. Nothing in this block holds money, and nothing in it is read by
// billing, payment or reporting code.
//
// Foreign keys into Core cascade (OrderItem, Kot, Branch) because these rows
// are derived operational state, not records of their own: Core never hard-
// deletes a line that has been sent to the kitchen (it voids it), so the
// cascade only ever fires in a test wipe — where it keeps every other suite's
// delete order valid without that suite having to know these tables exist.

enum KitchenItemState {
  QUEUED
  IN_PREP
  READY
  SERVED
  CANCELLED
}

// A preparation station in one store — "Hot kitchen", "Barista bar". Status
// reuses Core's ACTIVE/ARCHIVED: a station with history is archived, never
// deleted, so yesterday's prep times keep the station they were measured at.
model KitchenStation {
  id                String        @id @default(cuid())
  companyId         String
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name              String
  // What "late" means at this station. Snapshotted onto each line when it is
  // routed, so editing the target tonight does not rewrite last week's
  // late-ticket figures.
  targetPrepSeconds Int           @default(600)
  // The station every unrouted line falls back to. Written as the branch id on
  // the one default station and NULL on every other, so a plain unique index
  // enforces "at most one default per store" — Postgres treats NULLs as
  // distinct, which is exactly the rest of the stations.
  defaultForBranch  String?       @unique
  sortOrder         Int           @default(0)
  status            CatalogStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  routes       KitchenRoute[]
  items        KitchenItem[]
  printTargets PrintTarget[]

  @@unique([branchId, name])
  @@index([companyId, branchId])
}

// Routing rule: this product, or anything in this category, goes to this
// station. A product rule beats a category rule; neither beats nothing — a
// line with no rule goes to the store's default station.
//
// productId/categoryId are deliberately NOT foreign keys: the catalog is
// company-wide and editable, and a rule naming a category that was later
// deleted is harmless (it never matches) where a foreign key would have made
// the catalog screen refuse the delete for a reason it cannot explain.
model KitchenRoute {
  id          String         @id @default(cuid())
  companyId   String
  branchId    String
  stationId   String
  station     KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  // "product:<id>" | "category:<id>" — one rule per subject per store.
  matchKey    String
  productId   String?
  categoryId  String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([branchId, matchKey])
  @@index([stationId])
}

// One order line's journey through the kitchen. Created in the same
// transaction that sends the KOT, one row per line, unique on the line — so a
// replayed routing step can never make a second ticket line.
model KitchenItem {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String
  orderId       String
  kotId         String
  kot           Kot              @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId   String           @unique
  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stationId     String
  station       KitchenStation   @relation(fields: [stationId], references: [id])
  state         KitchenItemState @default(QUEUED)
  // Optimistic lock. Every transition names the version it was decided on;
  // a stale or replayed bump matches no row and changes nothing.
  version       Int              @default(1)
  // The store's kitchen cursor at this row's last change. Clients poll for
  // "everything after N", which is how a reconnect resumes without refetching
  // — or duplicating — the board.
  changeSeq     Int
  targetSeconds Int
  queuedAt      DateTime
  startedAt     DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  cancelledAt   DateTime?
  // A station telling the pass "this one is held up, and why".
  delayReason   String?
  delayedAt     DateTime?
  lastActorId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([branchId, changeSeq])
  @@index([branchId, state])
  @@index([stationId, state])
  @@index([orderId])
  @@index([kotId])
}

// Per-store change counter, incremented under its own row lock inside every
// kitchen write — the InvoiceCounter pattern. Holding the lock until commit is
// what makes the numbers commit in order, so a reader that has seen N has seen
// everything up to N. A plain sequence would not: 11 can commit before 10.
model KitchenCursor {
  branchId  String   @id
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PrintAgentStatus {
  PENDING // created, one-time enrolment code issued, never enrolled
  ACTIVE
  REVOKED
}

// A physical or browser device. Its credential is scoped to exactly one store
// and at most one terminal, and that scope is checked server-side on every
// request — a token that leaks is a token for one counter, not for a tenant.
model Device {
  id String @id @default(cuid())
  // Quoted in support tickets and printed on the device's own settings screen.
  // Minted once, never editable.
  publicId String @unique
  // See Terminal.companyId — same reason, same rule: server-written.
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  terminalId  String?
  // (terminalId, branchId), not terminalId alone: a device's credential is
  // scoped to one store, and pointing it at a till in a different store would
  // make that scope a fiction.
  terminal    Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  name        String
  type        DeviceType   @default(COUNTER)
  status      DeviceStatus @default(PENDING)
  // Only the hash. The token itself is shown once, at activation, and is not
  // recoverable afterwards — the same contract as a staff temporary password.
  // Revoking clears this column, because status alone would leave a working
  // credential in the wild.
  tokenHash   String?   @unique
  lastSeenAt  DateTime?
  lastSeenIp  String?
  activatedAt DateTime?
  revokedAt   DateTime?
  revokedById String?
  revokedBy   PosUser?  @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  enrolledById String?
  enrolledBy   PosUser? @relation("DeviceEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders   Order[]
  payments Payment[]

  @@unique([id, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([terminalId])
  @@index([status])
}

enum PermissionLevel {
  COMPANY
  BRANCH
  USER
}

enum PermissionEffect {
  ALLOW
  DENY
}

// Narrowing rules over the role baseline in src/lib/permissions.js. Resolved
// most-specific-first the way DiscountPolicy already resolves — USER over
// BRANCH over COMPANY — and deliberately incapable of widening: an ALLOW can
// only switch something back on that a broader DENY switched off, never grant
// an action the role never had. That is what makes "a cashier cannot grant
// themselves more permission" a property of the data model instead of a check
// somebody has to remember to write.
//
// One exception to most-specific-wins, and it is the important one: a
// COMPANY-level DENY is a HARD prohibition, not an inherited default. It is the
// tenant saying "not in this business, by anyone", so a narrower ALLOW does not
// lift it — resolveRules reapplies it last, over the narrower winner. The rules
// route refuses to store such an ALLOW in the first place, so nobody is left
// looking at a rule that says ALLOW while the server says no.
model PermissionRule {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  level     PermissionLevel
  branchId  String?
  branch    Branch?         @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  userId    String?
  user      PosUser?        @relation("PermissionRuleSubject", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  // Same trick as DiscountPolicy.scopeKey: Postgres counts NULLs as distinct,
  // so a nullable (branchId, userId) pair cannot stop a hundred duplicate
  // "company default" rows. "company" | "branch:<id>" | "user:<id>".
  scopeKey  String
  action    String
  effect    PermissionEffect
  note        String?
  updatedById String?
  updatedBy   PosUser? @relation("PermissionRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, scopeKey, action])
  @@index([companyId, level])
  @@index([branchId])
  @@index([userId])
}

// Which stores a user may act in. THE AUTHORITATIVE RULE, stated once here and
// implemented once in lib/permissions.js `storeScopeFor`:
//
//   Assignment rows REPLACE the store scope the role implies. They do not only
//   narrow it. A BRANCH_MANAGER covering two outlets gets two rows and reaches
//   both — for a store-pinned role that is a widening, and it is intended;
//   "manager of the airport and the mall" is an ordinary job. A user with no
//   rows falls back to PosUser.branchId, which is how every existing account
//   already works and is why this table could be added without a backfill.
//
// An earlier comment here said this table "only ever narrows, never widens".
// That was wrong about the code and is corrected rather than reconciled: the
// resolver has always read the rows as the scope. What never widens is the set
// of ACTIONS — scope answers "where", never "what", so no number of assignment
// rows turns a cashier into someone who can issue a refund.
//
// Widening is safe because of who may write these rows, not because of what
// they say. The route requires `user.write`, refuses any store outside the
// caller's OWN scope, and refuses a row naming the caller — so nobody can
// assign themselves anywhere, and an admin cannot hand out reach they do not
// themselves hold.
model UserStoreAssignment {
  id          String   @id @default(cuid())
  userId      String
  // companyId carried on the row so both sides are tied to one tenant by
  // foreign key: without it, a row could name this tenant's user and another
  // tenant's store, and the scope it produced would cross the boundary the
  // rest of the system is built on.
  companyId   String
  user        PosUser  @relation("StoreAssignmentUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId    String
  branch      Branch   @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   PosUser? @relation("StoreAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([companyId])
}

// Platform support reaching into a tenant. Explicit, time-boxed and granted by
// that tenant's own owner — a POS_SUPER_ADMIN is cross-tenant by construction,
// so without this table "ATC looked at my data" has no record and no consent.
// Every grant, use and revocation is audited.
model SupportAccessGrant {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // The platform operator the grant is for. Named, never a blanket grant to the
  // role: "ATC can see it" is not consent, "this person until Friday" is.
  //
  // Single-column on purpose, and the one place in this file that stays that
  // way. The subject of a grant is by definition NOT a member of this company —
  // an operator's companyId is NULL — so there is no (id, companyId) pair to
  // match. requireTenantPrincipal on the grant routes is what checks the
  // operator is an operator; a composite key here would simply be unsatisfiable.
  userId    String
  user      PosUser @relation("SupportGrantOperator", fields: [userId], references: [id], onDelete: Restrict)
  reason      String
  grantedById String
  grantedBy   PosUser  @relation("SupportGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt   DateTime @default(now())
  // Required. A grant with no end is standing access wearing a consent label.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  @@index([companyId, expiresAt])
  @@index([userId, expiresAt])
}

// ---------------------------------------------------------------------------
// LANE foundation, Phase 2 — VC-102 promotion engine.
//
// A promotion is the OWNER's discount: published company-wide or to named
// stores, applied at the till by anyone holding promo.apply, and recorded on
// the order as a PromotionRedemption row that snapshots the rule version and
// the computed amount. The redemption row, not the promotion, is what the
// bill retains — tomorrow's edit to the promotion must never restate what
// yesterday's invoice granted.
//
// Money stays in the one engine: a promotion's benefit is folded into
// Order.discountAmount by recomputeOrder, distributed across lines and taxed
// exactly like a manual discount. There is no second calculation path.
// ---------------------------------------------------------------------------

enum PromotionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum PromotionRuleKind {
  INCLUDE_CATEGORY
  EXCLUDE_CATEGORY
  INCLUDE_PRODUCT
  EXCLUDE_PRODUCT
}

// APPLIED holds a campaign slot; REVERSED has given it back. Rows are never
// deleted — a reversed redemption is the record of a benefit that was granted
// and then withdrawn, with the reason.
enum PromotionRedemptionStatus {
  APPLIED
  REVERSED
}

model Promotion {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  name      String
  // The code a till types in. Null = applied by picking from the list.
  code      String?
  status    PromotionStatus @default(DRAFT)
  // Bumped on every edit of a promotion that has ever been published.
  // Redemptions snapshot it, so "which rules produced this amount" stays
  // answerable after the promotion is edited.
  version   Int             @default(1)

  benefitType DiscountType
  // Exactly one of these is set, matching benefitType — same convention as
  // DiscountPolicy: percent is Decimal(6,3), flat money is integer paise.
  percent     Decimal?     @db.Decimal(6, 3)
  flatPaise   Int?

  // Threshold checked against the whole basket's subtotal (after line
  // discounts); the benefit itself is computed on the ELIGIBLE lines only.
  minSpendPaise   Int?
  maxBenefitPaise Int?

  // Scheduling. Dates are instants; weekday/time-of-day are evaluated in IST,
  // the calendar every other daily boundary in this system already uses.
  startsAt    DateTime?
  endsAt      DateTime?
  // Bitmask, Sunday = bit 0 … Saturday = bit 6. Null = every day.
  weekdayMask Int?
  // Minutes since IST midnight; start inclusive, end exclusive. Null = all
  // day. Windows do not wrap midnight — write two promotions instead.
  startMinute Int?
  endMinute   Int?
  // Null = every channel.
  channel     OrderType?

  // STACKING, stated once: a non-stackable promotion must be the only
  // promotion on the order. Stackable promotions combine; each benefit is
  // computed independently on the undiscounted eligible base, then the
  // combined total (manual + promotions) is clamped to the subtotal, with the
  // HIGHEST precedence number absorbing the clamp first.
  stackable  Boolean @default(false)
  precedence Int     @default(100)

  // Campaign-wide cap. Enforced by a conditional increment inside the apply
  // transaction, so two concurrent redemptions cannot both take the last slot.
  totalLimit      Int?
  redemptionCount Int  @default(0)
  // Per-customer cap. Customers have no account in this phase, so the key is
  // the normalised phone number the till supplies at apply time; a promotion
  // with this set REFUSES an apply that names no customer.
  perCustomerLimit Int?

  createdById String?
  createdBy   PosUser?  @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  itemRules   PromotionItemRule[]
  storeLinks  PromotionStore[]
  redemptions PromotionRedemption[]

  @@unique([companyId, code])
  // Referenced by the child tables so every rule, store link and redemption
  // carries the tenant and has it checked by the database.
  @@unique([id, companyId])
  @@index([companyId, status])
}

// Which lines a promotion touches. No rows = the whole menu. If any INCLUDE
// rows exist the eligible set starts from them; EXCLUDE rows are then removed.
// A product-level rule outranks its category either way.
model PromotionItemRule {
  id          String            @id @default(cuid())
  promotionId String
  companyId   String
  promotion   Promotion         @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  kind        PromotionRuleKind
  // Exactly one of these is set, matching kind. Composite with companyId so a
  // rule cannot name another tenant's menu.
  categoryId  String?
  category    Category?         @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  productId   String?
  product     Product?          @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([promotionId])
  @@index([categoryId])
  @@index([productId])
}

// Store targeting. No rows = every store in the tenant.
model PromotionStore {
  id          String    @id @default(cuid())
  promotionId String
  companyId   String
  promotion   Promotion @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId    String
  branch      Branch    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([promotionId, branchId])
  @@index([branchId])
}

// One promotion applied to one order. THIS row is what the bill retains:
// promotionVersion and amount are snapshots, never re-derived from the
// promotion. amount is rupees DECIMAL(10,2) like every other stored money
// column; it is rewritten by recomputeOrder while the order is open and
// frozen once the order leaves OPEN.
model PromotionRedemption {
  id               String                    @id @default(cuid())
  companyId        String
  promotionId      String
  promotion        Promotion                 @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  orderId          String
  branchId         String
  // One composite reference carrying id + tenant + store, so a redemption
  // cannot point at another tenant's or another store's order.
  order            Order                     @relation(fields: [orderId, companyId, branchId], references: [id, companyId, branchId], onDelete: Restrict)
  // Snapshots at apply time.
  promotionName    String
  promotionVersion Int
  code             String?
  amount           Decimal                   @default(0) @db.Decimal(10, 2)
  status           PromotionRedemptionStatus @default(APPLIED)
  // Why a reversed redemption was reversed: REMOVED (staff took it off),
  // BASKET_CHANGE (re-evaluation found it no longer eligible), ORDER_VOID.
  reversedReason   String?
  reversedAt       DateTime?
  appliedById      String?
  appliedBy        PosUser?                  @relation("PromotionAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  // Normalised customer identity ("ph:<digits>") used by perCustomerLimit.
  customerKey      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  // A promotion lands on an order once; re-applying after a reversal revives
  // the same row rather than growing a second one.
  @@unique([promotionId, orderId])
  @@index([orderId])
  @@index([companyId, createdAt])
  @@index([promotionId, customerKey])
}

enum PrintTransport {
  TCP // raw socket, conventionally port 9100
  FILE // the agent's own spool directory — dry run, no printer
}

enum PrintPurpose {
  KOT
  RECEIPT
}

enum PrintJobKind {
  KOT
  RECEIPT
  TEST
}

// QUEUED     waiting for its agent
// DISPATCHED handed to the agent, lease running, outcome not yet reported
// CONFIRMED  the agent wrote every byte and the printer connection closed clean
// FAILED     definitely not printed (nothing was written), retries exhausted
// UNCERTAIN  bytes may have reached the printer and nobody can say whether
//            paper came out. NEVER retried automatically: a retry is a second
//            copy of a KOT, and a second KOT is a second dish.
enum PrintJobStatus {
  QUEUED
  DISPATCHED
  CONFIRMED
  FAILED
  UNCERTAIN
}

enum PrintJobResolution {
  REPRINTED // a person asked for a new copy (see PrintJob.reprintOfId)
  CONFIRMED_BY_STAFF // a person looked at the printer and saw the paper
  DISMISSED // a person decided no copy is needed any more
}

// The Store Agent: a small program on a Windows/Linux PC in the store that
// drives the printers the browser cannot. This is the lane's MINIMAL agent
// credential — INTEGRATION(foundation): the foundation lane owns
// Terminal/Device enrolment, and this model is meant to be replaced by (or
// linked to) that Device row; see src/lib/print/agentAuth.js.
model PrintAgent {
  id                 String           @id @default(cuid())
  companyId          String
  branchId           String
  name               String
  status             PrintAgentStatus @default(PENDING)
  // sha256 of the one-time code. Cleared the moment it is used, so a code
  // works exactly once.
  enrolCodeHash      String?          @unique
  enrolCodeExpiresAt DateTime?
  // sha256 of the agent's secret. The secret itself is shown to the agent
  // once and never stored.
  credentialHash     String?          @unique
  enrolledAt         DateTime?
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  lastIp             String?
  platform           String?
  agentVersion       String?
  hostname           String?
  // Last heartbeat as the agent reported it: queue depth, per-printer reach.
  health             Json?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  targets PrintTarget[]
  jobs    PrintJob[]

  @@unique([branchId, name])
  @@index([companyId, branchId])
}

// One printer, as its agent reaches it. `cut` and `drawerKick` say what the
// job may ASK for; whether a given printer obeys has not been tested on any
// physical hardware (see docs/lanes/KITCHEN.md).
model PrintTarget {
  id         String          @id @default(cuid())
  companyId  String
  branchId   String
  agentId    String
  agent      PrintAgent      @relation(fields: [agentId], references: [id])
  name       String
  purpose    PrintPurpose
  // KOT printers only: the station whose lines this printer gets. NULL is a
  // pass printer that gets every line. Restrict, not SET NULL: a station
  // printer silently widening into a pass printer is not a state to reach.
  stationId  String?
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: Restrict)
  transport  PrintTransport
  host       String?
  port       Int?
  // Characters per line in the printer's normal font: 48 for 80 mm, 32 for 58 mm.
  widthChars Int             @default(48)
  cut        Boolean         @default(true)
  drawerKick Boolean         @default(false)
  status     CatalogStatus   @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  jobs PrintJob[]

  @@unique([branchId, name])
  @@index([agentId])
}

model PrintJob {
  id             String              @id @default(cuid())
  companyId      String
  branchId       String
  agentId        String
  agent          PrintAgent          @relation(fields: [agentId], references: [id])
  targetId       String
  target         PrintTarget         @relation(fields: [targetId], references: [id])
  kind           PrintJobKind
  status         PrintJobStatus      @default(QUEUED)
  // "This document to this printer", stable across retries of the request
  // that created it. Unique per store, so a double-clicked print or a replayed
  // KOT is one job.
  idempotencyKey String
  // Device-neutral lines rendered here; the agent turns them into ESC/POS.
  document       Json
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  nextAttemptAt  DateTime            @default(now())
  // Client-chosen token of the claim that dispatched this attempt. A claim
  // repeated with the same token (response lost, agent restarted) gets the
  // same job back instead of a lease that expires into UNCERTAIN.
  claimToken     String?
  dispatchedAt   DateTime?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  lastError      String?
  // The agent's last report as sent — including one that arrived too late to
  // change anything, which is exactly what a person resolving an UNCERTAIN
  // job wants to see.
  lastReport     Json?
  sourceKotId    String?
  sourceOrderId  String?
  // A reprint is a new job pointing at the one it replaces. Unique: one job
  // is reprinted at most once, so a double-clicked reprint is not two copies.
  reprintOfId    String?             @unique
  reprintOf      PrintJob?           @relation("PrintJobReprint", fields: [reprintOfId], references: [id])
  reprintedAs    PrintJob?           @relation("PrintJobReprint")
  reason         String?
  resolution     PrintJobResolution?
  resolvedById   String?
  resolvedAt     DateTime?
  requestedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([branchId, idempotencyKey])
  @@index([agentId, status, nextAttemptAt])
  @@index([branchId, createdAt])
  @@index([sourceKotId])
}

// ============================================================================
// ==== LANE vc104-api ====
// VC-104 Central phone-order centre (spec A§3 VC-104, "Update 5").
//
// The sidecar principle, and the reason nothing below touches Order's money:
// a phone order IS an ordinary Order in the routed store from the moment it is
// submitted. Pricing, tax, KOT, payment and refund therefore reuse the existing
// lifecycle untouched, and recomputeOrder() in lib/orders.js stays the single
// evaluator. Everything this module adds — who called, where it goes, when it
// is wanted, which store accepted — hangs off PhoneOrder BESIDE that Order,
// never inside it.
// ============================================================================

enum PhoneFulfilment {
  PICKUP
  DELIVERY
}

enum PhoneOrderStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

// C-6, unresolved. The GST treatment of a delivery charge turns on two facts
// this project has not established: WHO supplies the delivery (the restaurant
// itself, or a third party), and whether the charge is separate consideration
// for a distinct supply or part of a composite supply of restaurant service.
//
// Those two answers point opposite ways, which is why neither is assumed here:
//   - composite supply by the restaurant  -> the charge belongs INSIDE the
//     order's tax base, at the restaurant rate
//   - separate consideration, third-party supplier -> the charge is not the
//     restaurant's supply at all and must never enter this invoice
//
// Recording the unknown as data rather than leaving it implicit in code means
// the resolution is a backfill, not a schema change — and, because issued
// invoices are immutable, it keeps us from issuing one we would have to correct.
enum DeliverySupplier {
  UNRESOLVED
  RESTAURANT
  THIRD_PARTY
}

enum DeliveryChargeTreatment {
  // The temporary fallback: quoted alongside the order, never folded into
  // Order.total, never taxed. Reversible toward either answer above.
  UNRESOLVED_POST_TAX_FALLBACK
  COMPOSITE_SUPPLY
  SEPARATE_CONSIDERATION
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  // One caller, one row per tenant. The unique pair below is what makes a
  // repeat caller findable by the number they are ringing from, instead of
  // quietly accumulating a second Anita Rao every time someone mistypes.
  phone String
  email String?
  note  String?

  createdById String?
  createdBy   PosUser? @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  addresses   CustomerAddress[]
  phoneOrders PhoneOrder[]

  // LANE providers
  loyaltyLinks      LoyaltyProfileLink[]
  loyaltyOperations LoyaltyOperation[]

  @@unique([companyId, phone])
  // Composite tenant target. Children key on (id, companyId) so a child row
  // straddling two tenants is a database impossibility, not a code review.
  @@unique([id, companyId])
  @@index([companyId, name])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)

  label    String
  line1    String
  line2    String?
  landmark String?
  city     String
  pincode  String

  isDefault  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  phoneOrders PhoneOrder[]

  @@unique([id, companyId])
  @@index([customerId])
  @@index([companyId, pincode])
}

// Serviceability by pincode. Deliberately not geo: a radius needs coordinates
// this product does not collect and a maps dependency it does not have, and an
// untestable "is 2.4 km within 3 km" is worse than an explicit list the owner
// can read. Radius/polygon can replace this behind the same API later.
model BranchServiceArea {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  pincode        String
  deliveryCharge Decimal  @default(0) @db.Decimal(10, 2)
  minOrder       Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, pincode])
  @@index([companyId, pincode])
}

model BranchHours {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  // 0 = Sunday .. 6 = Saturday, in IST — the business day this product already
  // runs on (istDateOf, UTC+05:30).
  dayOfWeek Int
  // Minutes from midnight IST. closesMinute may exceed 1440 for a store that
  // trades past midnight, which is exactly why these are integers and not
  // clock strings: 23:00-02:00 has to be expressible without a second row.
  opensMinute  Int
  closesMinute Int
  closed       Boolean @default(false)

  @@unique([branchId, dayOfWeek])
  @@index([companyId])
}

// Preparation capacity as orders-per-slot. The spec names "preparation
// capacity" without defining it; this is the narrowest reading that can be
// enforced and tested, and it is per store because kitchens differ.
model BranchPrepCapacity {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  slotMinutes      Int @default(15)
  maxOrdersPerSlot Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite, not @@unique([branchId]): the relation above is defined on the
  // (branchId, companyId) pair, and a one-to-one needs the unique to cover
  // exactly the fields the relation uses.
  @@unique([branchId, companyId])
  @@index([companyId])
}

model PhoneOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // What the operator reads back down the phone. Per tenant, never reused.
  reference String

  customerId String
  customer   Customer         @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  addressId  String?
  address    CustomerAddress? @relation(fields: [addressId, companyId], references: [id, companyId], onDelete: Restrict)

  fulfilment PhoneFulfilment
  // Explicit fulfilment time. NULL means as-soon-as-possible. The spec requires
  // a SCHEDULED order to carry one, so the route refuses a scheduled order
  // without it rather than inventing a default the caller never agreed to.
  scheduledFor DateTime?

  status PhoneOrderStatus @default(SUBMITTED)

  routedBranchId String
  routedBranch   Branch @relation("PhoneOrderRouted", fields: [routedBranchId, companyId], references: [id, companyId], onDelete: Cascade)

  // Written exactly once, by the winner of the accept race. Its NULL-ness is
  // the guard the conditional UPDATE keys on, which is what makes "exactly one
  // accepting store" a database outcome rather than an application hope.
  acceptedBranchId String?
  acceptedBranch   Branch?   @relation("PhoneOrderAccepted", fields: [acceptedBranchId, companyId], references: [id, companyId], onDelete: Cascade)
  acceptedAt       DateTime?
  acceptedById     String?
  acceptedBy       PosUser?  @relation("PhoneOrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedByName   String?

  rejectedAt     DateTime?
  rejectedById   String?
  rejectedBy     PosUser?  @relation("PhoneOrderRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedByName String?
  rejectReason   String?

  // The real order. One per phone order, enforced by @unique: this is what
  // makes a retried submission incapable of minting a second Order or KOT.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Operator attribution (A§3 VC-104: "with operator attribution").
  //
  // The NAME is the attribution and it is NOT NULL; the id is a convenience
  // join that may go SetNull. Snapshotting follows the same reasoning as the
  // invoice billing snapshot: attribution that depends on a mutable row being
  // present is attribution that can be edited or lost after the fact. It also
  // means a PosUser delete cannot be blocked by this table — which is what
  // stops one suite's leftovers from failing every other suite's teardown.
  operatorId   String?
  operator     PosUser? @relation("PhoneOrderOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorName String
  // INTEGRATION(foundation): the terminal the central desk worked from, when
  // that desk is itself enrolled. No FK yet — foundation owns Terminal.
  terminalId String?

  // QUOTED, not billed. This never reaches Order.total or Order.taxAmount while
  // the treatment below is UNRESOLVED — see the enum comment. recomputeOrder()
  // remains the only thing that writes order money, and it never sees this.
  deliveryCharge          Decimal                 @default(0) @db.Decimal(10, 2)
  deliverySupplier        DeliverySupplier        @default(UNRESOLVED)
  deliveryChargeTreatment DeliveryChargeTreatment @default(UNRESOLVED_POST_TAX_FALLBACK)
  note                    String?

  idempotencyKey String
  // Fingerprint of the body this key first succeeded with. A replay carrying a
  // DIFFERENT body is a caller bug, not a retry, and must not be answered with
  // someone else's order.
  requestHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PhoneOrderEvent[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, routedBranchId, status])
  @@index([customerId])
  @@index([scheduledFor])
}

// Routing history. Separate from PosAuditLog on purpose: this is operational
// narrative the operator screen shows back ("rejected by Indiranagar, moved to
// Church Street"), whereas the audit log is the tamper-evident record. Both are
// written; neither replaces the other.
model PhoneOrderEvent {
  id           String     @id @default(cuid())
  companyId    String
  phoneOrderId String
  phoneOrder   PhoneOrder @relation(fields: [phoneOrderId], references: [id], onDelete: Cascade)

  at      DateTime @default(now())
  action  String
  actorId String?

  fromBranchId String?
  toBranchId   String?
  reason       String?
  meta         Json?

  @@index([phoneOrderId, at])
  @@index([companyId, at])
}

// ==== LANE providers ====
// Third-party provider integrations: delivery aggregators (Swiggy, Zomato),
// loyalty/CRM (Reelo) and accounting (Tally).
//
// NOTHING IN THIS BLOCK IS CONNECTED TO A LIVE PROVIDER. Every adapter is
// registered behind the same refusal the payment gateway uses (lib/gateway/
// index.js): with no credentials configured, every route refuses and says so.
// These tables exist so that the day credentials arrive, the work that has to
// be right — idempotency, tenancy, reconciliation, the audit trail — is
// already built and tested rather than written under time pressure.
//
// Design rules this block obeys, from the master spec:
//   A§6 p7  provider credentials protected; signature/auth verification;
//           adapter isolation and reconciliation tools
//   B§9 p7  order gateway / provider-adapter boundary; provider and channel
//           fields present BEFORE integrations ship
//   B§14 p9 no parallel money ledgers, no parallel stock engines, no invoice
//           mutation, no provider lock-in in core, no claim without verification
//
// The last one is why several columns below store what a provider SAID rather
// than what we computed. An aggregator's commission and payout are its own
// arithmetic; recording them verbatim next to our own totals is what makes a
// discrepancy visible. Silently recomputing them would hide exactly the
// disagreement reconciliation exists to surface.

enum IntegrationProvider {
  SWIGGY
  ZOMATO
  REELO
  TALLY
}

enum IntegrationStatus {
  // No credentials have been supplied. The shipped state.
  NOT_CONFIGURED
  // Credentials stored but never yet proven against the provider. This is NOT
  // "connected" — it is the state a settings screen reaches on its own, and
  // calling it connected is the claim B§14 p9 forbids.
  CONFIGURED
  // The last credential check actually reached the provider and succeeded.
  CONNECTED
  // The last check or sync failed; lastError says how, sanitized.
  ERROR
  // Switched off by an operator. Distinct from NOT_CONFIGURED: the credentials
  // are still there, so turning it back on does not mean re-entering them.
  DISABLED
}

// One row per (tenant, provider). Outlets hang off it, because a Swiggy or
// Zomato account covers many restaurants under one set of credentials.
model IntegrationConnection {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider  IntegrationProvider

  status  IntegrationStatus @default(NOT_CONFIGURED)
  // Separate from status on purpose: an operator may disable a CONNECTED
  // integration without destroying the proof that it once worked.
  enabled Boolean           @default(false)

  // Secret material, sealed with POS_INTEGRATION_SECRET_KEY (AES-256-GCM, see
  // lib/integrations/secrets.js). Never selected into an API response — the
  // route layer picks columns explicitly rather than returning the row.
  credentialCiphertext  String?
  // sha256 of the plaintext credential bundle. Lets the UI say "the key was
  // changed on 12 March" and lets a test assert a rotation happened, without
  // anything being able to read the key back out. A hash is not a credential.
  credentialFingerprint String?
  credentialUpdatedAt   DateTime?

  // Non-secret settings: Tally company name and financial year, Reelo
  // programme id, aggregator webhook path. Shape is validated per provider by
  // a zod schema in lib/integrations/config.js, not by the database.
  config Json?

  // Three different clocks, because operators ask three different questions.
  // "Did anyone check?", "did anything work?", "what broke?" — collapsing them
  // into one timestamp is what makes a dead integration look alive.
  lastCheckedAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  lastErrorAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets        IntegrationOutlet[]
  events         IntegrationEvent[]
  jobs           IntegrationJob[]
  discrepancies  IntegrationDiscrepancy[]
  aggregatorOrders AggregatorOrder[]
  loyaltyLinks     LoyaltyProfileLink[]
  loyaltyOperations LoyaltyOperation[]
  loyaltyImports   LoyaltyImportRun[]
  postings         AccountingPosting[]
  ledgerMaps       AccountingLedgerMap[]

  @@unique([companyId, provider])
  // Composite tenant target, so every child below carries companyId and has it
  // checked by the database rather than by the code that wrote the row.
  @@unique([id, companyId])
}

// Maps one provider outlet/restaurant to one VEXO store. Both directions are
// unique: a store cannot quietly serve two Swiggy outlets, and one Swiggy
// outlet cannot fan out into two stores. Either would make an order's
// destination ambiguous, and an ambiguous destination is a wrong kitchen.
model IntegrationOutlet {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)
  branchId     String
  branch       Branch                @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  externalOutletId   String
  externalOutletName String?
  active             Boolean @default(true)

  // Menu publication state. The hash is of the payload we last pushed, so a
  // re-push that would change nothing can be skipped and, more importantly, a
  // menu that drifted since the last push is detectable.
  menuSyncedAt   DateTime?
  menuSyncHash   String?
  menuSyncStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aggregatorOrders AggregatorOrder[]

  @@unique([connectionId, externalOutletId])
  @@unique([connectionId, branchId])
  @@unique([id, companyId])
  @@index([companyId, branchId])
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  // Deliberately not applied, with a reason: a duplicate, an event for an
  // outlet we do not map, an event older than the state we already hold.
  SKIPPED
  FAILED
}

// Every inbound provider callback, recorded before it is acted on.
//
// This table IS the duplicate-callback guard. The unique constraint on
// (connectionId, externalEventId) means a provider that delivers the same
// event five times — which they all do, because at-least-once is the only
// delivery guarantee anyone offers — inserts once and collides four times.
// The collision is the detection; there is no "have we seen this?" read that
// a concurrent retry could race past.
model IntegrationEvent {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  externalEventId String
  kind            String

  // The normalised payload. The raw bytes are not kept: they can carry
  // customer addresses and phone numbers, and this table is read by support.
  payload Json

  // Whether the signature/auth check passed. Stored rather than assumed,
  // because an unsigned delivery that was nonetheless recorded is exactly the
  // thing a security review needs to be able to find.
  signatureValid Boolean
  receivedAt     DateTime @default(now())

  status      IntegrationEventStatus @default(RECEIVED)
  attempts    Int                    @default(0)
  processedAt DateTime?
  skipReason  String?
  lastError   String?

  // Which provider order this event concerns, and where it sits in the
  // provider's own ordering. Networks reorder; a CANCELLED that arrives after
  // a DELIVERED must not be applied just because it arrived later. The adapter
  // fills whichever of these the provider actually offers.
  externalOrderId  String?
  providerSequence Int?
  providerEventAt  DateTime?

  @@unique([connectionId, externalEventId])
  @@index([companyId, status, receivedAt])
  @@index([connectionId, externalOrderId])
}

enum IntegrationJobStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  // Attempts exhausted. Stops retrying, stays visible, needs a human.
  DEAD
}

// Outbound work: menu pushes, loyalty bill syncs, Tally vouchers. A durable
// queue rather than an in-process one, because the thing it mostly has to
// survive is this process restarting while a provider is down (A§4 p5-6, and
// the local-agent contract in A§6 p7: "durable queue").
//
// dedupeKey is the caller's promise that two rows with the same key are the
// same work. It is what stops a retried menu push, or a re-posted invoice,
// from becoming a second one at the provider.
model IntegrationJob {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  kind      String
  dedupeKey String
  payload   Json

  status      IntegrationJobStatus @default(PENDING)
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(8)
  // Backoff target. A worker claims rows where nextAttemptAt <= now, so a
  // provider outage costs one attempt per window instead of a hot loop.
  nextAttemptAt DateTime           @default(now())
  // Claim marker. A job held by a worker that died is reclaimable by age;
  // without the pair, a crash mid-flight strands the row forever.
  lockedAt      DateTime?
  lockedBy      String?

  // The provider's acknowledgement id, once it gives one.
  externalRef String?
  lastError   String?
  lastErrorAt DateTime?
  succeededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, dedupeKey])
  @@index([companyId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
}

enum DiscrepancyState {
  OPEN
  RESOLVED
  IGNORED
}

// Where the two sides disagree. Recorded, never auto-corrected.
//
// The task this serves is settlement reconciliation, and the rule there is
// that VEXO does not silently recompute a provider's totals. If Swiggy says it
// is paying 412.50 on a bill we totalled at 430.00, both numbers are written
// down and a human decides which is wrong. An integration that quietly adopted
// the provider's figure would be a second money ledger (B§14 p9).
model IntegrationDiscrepancy {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  kind        String
  externalRef String?
  orderId     String?

  // Ours and theirs, in rupees, to the same scale the rest of the product
  // stores money at. Both nullable because "they have a row we do not" is
  // itself a discrepancy, and it has only one side.
  expectedAmount Decimal? @db.Decimal(12, 2)
  observedAmount Decimal? @db.Decimal(12, 2)
  detail         Json?

  state          DiscrepancyState @default(OPEN)
  detectedAt     DateTime         @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     PosUser?         @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?

  @@index([companyId, state, detectedAt])
  @@index([connectionId, kind])
  @@index([resolvedById])
}

// How an order reached us. `type` says how it is served, PhoneOrder.fulfilment
// says how it leaves; this says who sent it. B§9 p7.
enum OrderChannel {
  POS
  PHONE
  AGGREGATOR
  ONLINE
  API
}

enum AggregatorOrderState {
  RECEIVED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

// The sidecar for an aggregator order, exactly as PhoneOrder is for a phone
// order: the Order is an ordinary Order from the moment it is accepted, so
// pricing, tax, KOT, payment and refund reuse the existing lifecycle and
// recomputeOrder() stays the only thing that writes order money.
//
// orderId is nullable AND unique. Nullable because an order that arrives for
// an outlet we cannot map, or that is rejected on arrival, must still be
// recorded — losing it is how a restaurant finds out from the customer.
// Unique because one provider order may never produce two bills.
model AggregatorOrder {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)
  outletId     String?
  // Restrict, not SetNull: the composite carries companyId, which is required
  // here, so nulling it is not available. Restrict is also the behaviour we
  // want — a mapping with order history is deactivated via `active`, never
  // deleted out from under the orders that came through it.
  outlet       IntegrationOutlet?    @relation(fields: [outletId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId     String?
  branch       Branch?               @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  provider               IntegrationProvider
  externalOrderId        String
  // The short code the rider and the customer actually say out loud. Not the
  // key — providers reuse display codes across outlets and days.
  externalOrderDisplayId String?

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  state AggregatorOrderState @default(RECEIVED)

  // The provider's own arithmetic, stored verbatim. See the block comment at
  // the head of this lane: these are never recomputed into our totals, they
  // are compared against them.
  grossAmount             Decimal? @db.Decimal(12, 2)
  providerDiscountAmount  Decimal? @db.Decimal(12, 2)
  restaurantDiscountAmount Decimal? @db.Decimal(12, 2)
  commissionAmount        Decimal? @db.Decimal(12, 2)
  taxAmount               Decimal? @db.Decimal(12, 2)
  deliveryFeeAmount       Decimal? @db.Decimal(12, 2)
  packagingFeeAmount      Decimal? @db.Decimal(12, 2)
  netPayoutAmount         Decimal? @db.Decimal(12, 2)
  currency                String   @default("INR")
  // PREPAID or COD as the provider reports it. Drives whether the POS should
  // expect to collect anything at all.
  paymentMode             String?

  // The normalised order as the adapter read it, kept so a mapping bug can be
  // diagnosed against what actually arrived rather than against a guess.
  normalised Json

  placedAt     DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  readyAt      DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Staleness guard. An event carrying a sequence at or below this one has
  // already been superseded and is skipped, not applied. This is what makes
  // out-of-order delivery safe rather than merely rare.
  lastSequence Int?
  lastEventAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalOrderId])
  @@index([companyId, state])
  @@index([branchId, placedAt])
  @@index([outletId])
}

// --- loyalty (Reelo) ---------------------------------------------------------
//
// SOURCE OF TRUTH: the provider. The client has an existing loyalty programme
// with roughly 100,000 customers and their balances, and that programme stays
// authoritative. VEXO does not keep a points ledger, does not recompute a
// balance and never writes one back as if it were its own. What it keeps is a
// mapping, a cache of the last balance the provider quoted, and a record of
// every instruction it sent — which is the minimum needed to avoid asking
// twice. This is the one place in the product where an external system, not
// VEXO, holds the ledger, and it is deliberate: B§14 p9 forbids a SECOND
// ledger, and building our own points engine alongside Reelo's would be one.

model LoyaltyProfileLink {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)
  customerId   String
  customer     Customer              @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)

  externalCustomerId String
  // E.164 without the +, as lib/integrations/identity.js normalises it. Stored
  // rather than derived so a later change to the normalisation rule cannot
  // silently re-point an existing link at a different person.
  normalizedPhone    String

  // A CACHE of what the provider last said, never an authority. Nothing in the
  // product may spend these points without asking the provider first; the
  // column exists so a cashier sees a number instead of a spinner, and so a
  // drift against the provider is detectable.
  lastKnownBalance Int?
  balanceAsOf      DateTime?
  membershipTier   String?
  pointsExpireAt   DateTime?

  // IMPORT (historical backfill), LOOKUP (matched at the till) or CREATE.
  source     String
  linkedAt   DateTime  @default(now())
  lastSyncedAt DateTime?

  @@unique([connectionId, externalCustomerId])
  @@unique([connectionId, customerId])
  @@index([connectionId, normalizedPhone])
  @@index([companyId])
}

enum LoyaltyOpKind {
  // A completed bill reported to the provider so it can award its own points.
  BILL_SYNC
  // Points spent against a bill.
  REDEEM
  // An earlier operation undone, because the bill was voided or refunded.
  REVERSE
}

enum LoyaltyOpStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

// Every instruction sent to the loyalty provider, with the key that makes
// sending it twice harmless. The unique constraint on (connectionId,
// idempotencyKey) is what stops a retried bill sync crediting a customer
// twice, and a double-tapped redeem button spending the points twice.
model LoyaltyOperation {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)
  customerId   String?
  // Restrict for the same reason as AggregatorOrder.outlet: the composite
  // carries a required companyId. It is also the right rule — a customer with
  // loyalty instructions on record is archived (Customer.archivedAt), not
  // erased, and erasing one would destroy the evidence of what we told the
  // provider to do with their points.
  customer     Customer?             @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  kind           LoyaltyOpKind
  idempotencyKey String

  // Signed: negative for a redemption, positive for a credit. Null when the
  // provider decides the award itself and we only reported the bill.
  pointsDelta Int?
  amount      Decimal? @db.Decimal(12, 2)

  status      LoyaltyOpStatus @default(PENDING)
  externalRef String?
  // A reversal names what it undid, so "was this refund's points taken back?"
  // is a lookup rather than a reconstruction.
  reversesId  String?
  reverses    LoyaltyOperation?  @relation("LoyaltyReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy  LoyaltyOperation[] @relation("LoyaltyReversal")

  requestedAt DateTime  @default(now())
  confirmedAt DateTime?
  lastError   String?

  @@unique([connectionId, idempotencyKey])
  @@index([companyId, status])
  @@index([customerId])
  @@index([orderId])
  @@index([reversesId])
}

enum ImportRunState {
  // Counted and reported, nothing written. Always the first state.
  PREVIEW
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

// A resumable historical import of an existing loyalty account.
//
// Resumable because 100,000 customers is not one request, and a run that has
// to start from zero after every network blip never finishes. `cursor` is the
// number of the last row COMMITTED: on resume the file is re-read but rows up
// to and including the cursor are stepped over, so no work is repeated and none
// is lost. Every counter is COUNTED as rows are processed, never estimated —
// they are what the operator reconciles against the provider's own total.
model LoyaltyImportRun {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  state  ImportRunState @default(PREVIEW)
  // A preview run writes nothing. Leaving this true is the default, so the
  // destructive form has to be asked for.
  dryRun Boolean        @default(true)

  cursor String?

  // Digest of the export this run is reading. Resuming at row 64,001 is only
  // safe against the SAME file: the same row number in a re-export is a
  // different customer, so a resume that did not check this would import the
  // wrong hundred thousand rows and report success. Refusing a resume is
  // recoverable; a silently misaligned one is not.
  sourceFingerprint String?

  // What the provider said the account holds, if it will tell us. The point of
  // comparison for "did we get everything".
  totalReported   Int?
  fetched         Int @default(0)
  matchedExisting Int @default(0)
  created         Int @default(0)
  skipped         Int @default(0)
  failed          Int @default(0)
  // Sum of the balances seen, for a reconciliation total. Decimal rather than
  // Int because 100,000 customers' points sum past a 32-bit column sooner than
  // anyone expects, and a silently wrapped total is worse than no total.
  balanceSumPoints Decimal @default(0) @db.Decimal(18, 0)

  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  lastError       String?
  startedById     String?
  startedBy       PosUser?  @relation("LoyaltyImportStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions LoyaltyImportException[]

  @@index([companyId, state])
  @@index([startedById])
}

// One row per record the import could not take. An import that reports
// "99,412 of 100,000" without saying which 588 and why is not reportable.
model LoyaltyImportException {
  id    String           @id @default(cuid())
  runId String
  run   LoyaltyImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  rowNumber          Int?
  externalCustomerId String?
  // The contact detail as the provider gave it, unnormalised — the whole point
  // of the exception is usually that it could not be normalised.
  phoneRaw           String?
  reason             String
  detail             Json?
  at                 DateTime @default(now())

  @@index([runId, at])
}

// --- accounting (Tally) ------------------------------------------------------
//
// DIRECTION: VEXO -> Tally, one way. VEXO's own POS and inventory records stay
// authoritative for the transactions it originates; Tally receives them as
// vouchers. Nothing in this block reads a balance back from Tally and treats
// it as truth about a VEXO order, because that would be the parallel money
// ledger B§14 p9 forbids.

enum AccountingDocType {
  SALES
  CREDIT_NOTE
  RECEIPT
  PAYMENT
  PURCHASE
}

enum AccountingPostingStatus {
  PENDING
  QUEUED
  SENT
  // Tally answered and named the voucher it created.
  ACKNOWLEDGED
  FAILED
  DEAD
}

// One posting per (source document, document type). The unique constraint is
// the duplicate-voucher guard: an invoice can produce exactly one SALES
// voucher, however many times the queue retries.
model AccountingPosting {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)
  branchId     String?

  docType AccountingDocType
  // What in VEXO this represents: ORDER, REFUND or PAYMENT, and its id.
  sourceType String
  sourceId   String

  voucherType String
  // Our stable external reference, which is the invoice number. Tally is asked
  // to store it, so a re-import can be matched instead of duplicated.
  voucherNumber String?
  voucherDate   DateTime
  amount        Decimal  @db.Decimal(12, 2)

  // What Tally gave back. MASTERID and REMOTEID are Tally's own handles for
  // the voucher it created; holding them is what makes a later amendment
  // target the right row instead of adding another.
  externalMasterId   String?
  externalVoucherKey String?
  acknowledgedAt     DateTime?

  status    AccountingPostingStatus @default(PENDING)
  attempts  Int                     @default(0)
  lastError String?
  // sha256 of the request we built. If a retry would send a different payload
  // than the attempt that may already have landed, that is a bug worth
  // failing on rather than a difference worth ignoring.
  payloadHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, sourceType, sourceId, docType])
  @@index([companyId, status])
  @@index([connectionId, voucherNumber])
}

// The names Tally already uses, supplied by whoever maintains the client's
// books. Tally matches ledgers BY NAME and creates a new one when the name is
// unknown, so a typo here does not fail — it silently opens a second account.
// That is why these are configured and verifiable rather than derived.
model AccountingLedgerMap {
  id           String                @id @default(cuid())
  companyId    String
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade)

  // SALES_BY_TAX | TAX_OUTPUT | ROUNDING | PAYMENT_METHOD | PARTY_DEFAULT |
  // COST_CENTRE — see LEDGER_KINDS in lib/integrations/accounting.js. A free
  // string rather than an enum so a later posting type (PURCHASE) can name its
  // ledgers without a migration.
  kind String
  // The VEXO-side key this maps from: a tax percent ("5"), a payment method
  // ("UPI"), a store id.
  key  String

  ledgerName String
  costCentre String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, kind, key])
  @@index([companyId])
}
