// ATC Infocom Solutions Pvt. Ltd. — ATC POS
// Multi-tenant schema. Tenant boundary = Company; Branch belongs to exactly one
// Company. ATC-level operators (POS_SUPER_ADMIN) have companyId = null and are
// the only cross-tenant principals. This database is dedicated to ATC POS —
// it shares nothing with ATC NOC, Megatel, Review Manager or WhatsApp.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PosRole {
  POS_SUPER_ADMIN // ATC staff, cross-company
  CUSTOMER_OWNER // owns one company, all its branches
  BRANCH_MANAGER // one branch of one company
  CASHIER // one branch of one company
  // Appended, never reordered or renamed: a Postgres enum value carries an
  // ordinal and the four above are already written into live PosUser rows.
  // BRANCH_MANAGER is the spec's Store Manager and keeps its old name, because
  // renaming it would rewrite every row that holds it.
  COMPANY_ADMIN // whole company; the admin work an owner delegates
  FINANCE // whole company; money and tax, sells nothing
  REGIONAL_MANAGER // the stores of one Region, never the whole company
  CAPTAIN // one store; takes orders, cannot bill
  KITCHEN // one store; KOT screens only
  INVENTORY // stock, at the store or the company
  PURCHASE // company; vendors and purchase orders
  DELIVERY // one store; delivery handover
  AUDITOR // reads what it is granted, writes nothing
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum PosUserStatus {
  ACTIVE
  DISABLED
}

enum BranchStatus {
  ACTIVE
  CLOSED
}

enum LicensePlan {
  FREE_TRIAL
  SINGLE_STORE
  MULTI_STORE
}

// EXPIRED is deliberately not a stored status: expiry is a fact about
// expiresAt vs now, computed at read time, so a lapsed licence can never be
// "un-expired" by a forgotten cron or a missed write.
enum LicenseStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LicenseAddonKind {
  ADDITIONAL_BRANCH
}

model Company {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  status       CompanyStatus @default(ACTIVE)
  // Demo tenants are first-class but unmistakable: the flag propagates to the
  // UI as a persistent badge and demo rows never mix with customer rows.
  isDemo       Boolean       @default(false)
  contactName  String?
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branches Branch[]
  users    PosUser[]
  licenses License[]

  taxRates   TaxRate[]
  categories Category[]
  products   Product[]
  orders     Order[]
  dayCloses  DayClose[]

  discountPolicies DiscountPolicy[]

  // LANE inventory
  inventoryLocations InventoryLocation[]
  inventoryItems     InventoryItem[]
  suppliers          Supplier[]
  recipes            Recipe[]

  // LANE foundation
  legalEntities     LegalEntity[]
  gstRegistrations  GstRegistration[]
  brands            Brand[]
  regions           Region[]
  terminals         Terminal[]
  devices           Device[]
  permissionRules   PermissionRule[]
  supportGrants     SupportAccessGrant[]
  promotions        Promotion[]
  customers         Customer[]
  phoneOrders       PhoneOrder[]

  // LANE accounts
  invitations UserInvitation[]
}

model Branch {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  name        String
  code        String
  status      BranchStatus @default(ACTIVE)
  isDemo      Boolean      @default(false)
  addressLine String?
  city        String?
  state       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ---- LANE foundation ----------------------------------------------------
  // The VEXO Store ID: minted once, printed on invoices, quoted in support
  // tickets, never editable. `name` and `code` are the customer's to change;
  // this is the identity everything else points at. `id` is a cuid and stays
  // the database key — publicId exists because a human has to be able to read
  // it out over the phone.
  publicId          String           @unique
  pincode           String?
  // Which registered business this store trades as, and under which GSTIN.
  // Nullable because a tenant configures these after the store exists, and a
  // store that has not been mapped yet must not be unusable — billing refuses
  // to issue a GST invoice without a registration instead.
  //
  // These three are COMPOSITE references, carrying companyId alongside the id.
  // Tenancy is then a foreign key: the database itself refuses to link a store
  // to another customer's entity, GSTIN or region, on UPDATE as well as on
  // INSERT. Cross-table agreement expressed this way rather than as a CHECK,
  // because a CHECK cannot see another table and a trigger pretending to is
  // not a constraint — it is a race.
  //
  // MATCH SIMPLE (the default) skips the check when the nullable id is NULL,
  // which is exactly right: an unmapped store has nothing to verify. The
  // gstRegistrationId reference carries legalEntityId too, so the GSTIN must
  // belong to the entity this store trades as; the SQL CHECK
  // `Branch_gst_needs_entity` closes the one gap that leaves, a GSTIN set
  // while legalEntityId is still NULL.
  legalEntityId     String?
  legalEntity       LegalEntity?     @relation(fields: [legalEntityId, companyId], references: [id, companyId], onDelete: Restrict)
  gstRegistrationId String?
  gstRegistration   GstRegistration? @relation(fields: [gstRegistrationId, legalEntityId, companyId], references: [id, legalEntityId, companyId], onDelete: Restrict)
  regionId          String?
  region            Region?          @relation(fields: [regionId, companyId], references: [id, companyId], onDelete: Restrict)
  // Invoice series prefix. Null = use `code`, which is what every existing
  // store does. Set it once and a later code change cannot relabel the series,
  // because the counter is keyed by branch and FY, not by the prefix.
  invoicePrefix     String?
  // Per-premises, not per-company: an FSSAI licence is issued to the kitchen at
  // this address, and it is the number that has to appear on this store's bills.
  fssaiLicenseNo    String?
  fssaiValidUpto    DateTime?

  users PosUser[]

  tables          DiningTable[]
  orders          Order[]
  invoiceCounters InvoiceCounter[]
  dayCloses       DayClose[]

  discountPolicies DiscountPolicy[]
  kitchenStations  KitchenStation[]

  // LANE foundation
  terminals       Terminal[]
  devices         Device[]
  brandLinks      BranchBrand[]
  permissionRules PermissionRule[]
  userAssignments UserStoreAssignment[]
  promotionLinks  PromotionStore[]
  serviceAreas        BranchServiceArea[]
  hours               BranchHours[]
  prepCapacity        BranchPrepCapacity?
  phoneOrdersRouted   PhoneOrder[]        @relation("PhoneOrderRouted")
  phoneOrdersAccepted PhoneOrder[]        @relation("PhoneOrderAccepted")

  // LANE inventory
  inventoryLocations InventoryLocation[]

  @@unique([companyId, code])
  // Referenced by everything that happens AT a store — terminals, devices,
  // orders, assignments — so that each of those carries the tenant and has it
  // checked, instead of trusting whoever wrote the row.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([gstRegistrationId])
  @@index([regionId])
  @@index([legalEntityId])
}

model PosUser {
  id                 String        @id @default(cuid())
  // null companyId = ATC operator. Every customer principal carries one.
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  // Branch-scoped roles (BRANCH_MANAGER, CASHIER) carry the branch they are
  // pinned to; owner/ATC rows leave it null.
  branchId           String?
  // Composite where it can be. A platform operator has a NULL companyId, and
  // MATCH SIMPLE skips the check when any referencing column is NULL — so this
  // constrains customer principals, which are the ones that have a branch at
  // all, and leaves operator rows alone. Operators are kept out of tenant data
  // by requireTenantPrincipal and the support-grant gate, not by this.
  //
  // Restrict, where the single-column version was SET NULL. Postgres nulls
  // EVERY referencing column of a composite key, so deleting a branch under the
  // old action would also blank companyId here — silently promoting a cashier
  // into something with no tenant at all, which is what a platform operator
  // looks like. Stores are retired by status, not deleted, so refusing the
  // delete costs nothing and removes that path entirely.
  branch             Branch?       @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  email              String        @unique
  fullName           String
  passwordHash       String
  role               PosRole
  status             PosUserStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // ---- LANE accounts ------------------------------------------------------
  // Proof that this mailbox answered: set when an invitation is accepted or an
  // email change is confirmed, never by an administrator typing an address.
  // Password recovery is only sent to a verified address, so an unverified row
  // cannot be used to mail a code to an attacker-supplied mailbox.
  emailVerifiedAt DateTime?
  // An email change in flight. The address moves into `email` only after a
  // code sent TO THE NEW ADDRESS is verified; until then the old address still
  // signs in, so a mistyped change cannot lock anyone out.
  pendingEmail    String?

  // Invitation-pending is deliberately NOT a PosUserStatus: statuses are a
  // Postgres enum written into live rows, and the pending state is a fact
  // about an open UserInvitation, not about the user. A PosUser row is only
  // created when the invitation is accepted.
  invitationsSent UserInvitation[]  @relation("InvitationCreatedBy")
  invitations     UserInvitation[]  @relation("InvitationAcceptedBy")
  authChallenges  AuthChallenge[]
  totpCredential  TotpCredential?
  recoveryCodes   MfaRecoveryCode[]

  sessions PosSession[]

  ordersOpened     Order[]         @relation("OrderOpenedBy")
  ordersVoided     Order[]         @relation("OrderVoidedBy")
  itemsVoided      OrderItem[]     @relation("OrderItemVoidedBy")
  paymentsReceived Payment[]       @relation("PaymentReceivedBy")
  refundsIssued    Refund[]        @relation("RefundBy")
  intentsCreated   PaymentIntent[] @relation("PaymentIntentCreatedBy")
  daysClosed       DayClose[]      @relation("DayClosedBy")

  discountPolicies  DiscountPolicy[] @relation("DiscountPolicySubject")
  discountsApproved Order[]          @relation("OrderDiscountApprovedBy")

  // LANE inventory
  inventoryLocationAccess InventoryLocationAccess[]

  // ---- LANE foundation ----------------------------------------------------
  // A REGIONAL_MANAGER is scoped by region, not by a single branch, so it
  // cannot use branchId. Null for every other role.
  regionId String?
  region   Region? @relation(fields: [regionId, companyId], references: [id, companyId], onDelete: Restrict)

  // Explicit multi-store scope. A user with no assignments is scoped by role
  // alone; a user with assignments is scoped by exactly those stores. See the
  // authoritative statement on UserStoreAssignment and in lib/permissions.js
  // (`storeScopeFor`).
  storeAssignments   UserStoreAssignment[] @relation("StoreAssignmentUser")
  storeAssignmentsBy UserStoreAssignment[] @relation("StoreAssignmentCreatedBy")

  permissionRules    PermissionRule[]     @relation("PermissionRuleSubject")
  permissionRulesSet PermissionRule[]     @relation("PermissionRuleUpdatedBy")
  devicesEnrolled    Device[]             @relation("DeviceEnrolledBy")
  devicesRevoked     Device[]             @relation("DeviceRevokedBy")
  supportGrants      SupportAccessGrant[] @relation("SupportGrantOperator")
  supportGrantsGiven SupportAccessGrant[] @relation("SupportGrantGrantedBy")
  promotionsCreated  Promotion[]           @relation("PromotionCreatedBy")
  promotionsApplied  PromotionRedemption[] @relation("PromotionAppliedBy")
  customersCreated    Customer[]   @relation("CustomerCreatedBy")
  phoneOrdersOperated PhoneOrder[] @relation("PhoneOrderOperator")
  phoneOrdersAccepted PhoneOrder[] @relation("PhoneOrderAcceptedBy")
  phoneOrdersRejected PhoneOrder[] @relation("PhoneOrderRejectedBy")

  // Referenced by PermissionRule and UserStoreAssignment so a tenant's rule or
  // assignment can only name a principal of that same tenant.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([regionId])
}

model PosSession {
  id        String    @id @default(cuid())
  userId    String
  user      PosUser   @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
}

model License {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  plan            LicensePlan
  status          LicenseStatus @default(ACTIVE)
  startsAt        DateTime      @default(now())
  expiresAt       DateTime
  // Branch entitlement of the base plan. SINGLE_STORE is clamped to 1 at read
  // time regardless of what is stored; MULTI_STORE adds active addons on top.
  baseBranchLimit Int           @default(1)
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ---- LANE accounts ------------------------------------------------------
  // Days a lapsed licence stays usable after expiresAt. Grace is a property of
  // the licence that was sold, not a global constant, so a customer who was
  // promised a fortnight gets a fortnight without editing code. 0 = none.
  graceDays             Int      @default(0)
  // Entitled extension modules, from EXTENSION_POINTS in lib/permissions.js
  // (INVENTORY, PURCHASE, KITCHEN, DELIVERY). Empty = core POS only. A module
  // absent here is refused at the permission layer, not merely hidden.
  modules               String[] @default([])
  // Per-store hardware ceilings. null = unlimited, which is what every
  // pre-existing licence means: this column arrived after they were sold, and
  // a silent 0 would strand live tills.
  maxTerminalsPerBranch Int?
  maxDevicesPerBranch   Int?

  addons LicenseAddon[]

  @@index([companyId])
}

model LicenseAddon {
  id        String           @id @default(cuid())
  licenseId String
  license   License          @relation(fields: [licenseId], references: [id])
  kind      LicenseAddonKind @default(ADDITIONAL_BRANCH)
  quantity  Int              @default(1)
  expiresAt DateTime?
  notes     String?
  createdAt DateTime         @default(now())

  @@index([licenseId])
}

// ---------------------------------------------------------------------------
// Discount authority — who may take money off a bill, and how far.
//
// Resolved most-specific-first: USER override → BRANCH override → COMPANY
// default → nothing. A company with no rows discounts nothing at all, which
// is the right state for a till that has just been handed over: permission is
// granted, never assumed. There is deliberately no constant in this codebase
// that says "a cashier may give 10%" — every ceiling is data the customer's
// own admin sets.
// ---------------------------------------------------------------------------

enum DiscountPolicyLevel {
  COMPANY
  BRANCH
  USER
}

model DiscountPolicy {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id])
  level     DiscountPolicyLevel
  // Restrict, not the Prisma default of SET NULL: a policy row silently
  // widening from "this branch" to "the whole company" because somebody
  // removed a branch is not a state this table should be able to reach.
  branchId  String?
  branch    Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId    String?
  user      PosUser?            @relation("DiscountPolicySubject", fields: [userId], references: [id], onDelete: Restrict)

  // Postgres counts NULLs in a unique index as distinct, so a nullable
  // (branchId, userId) pair would happily hold a hundred "company defaults".
  // scopeKey is the same fact written so the index can actually bite:
  // "company" | "branch:<id>" | "user:<id>".
  scopeKey String

  // null = inherit from the level above. At COMPANY level there is nothing
  // above, so null there reads as "not allowed".
  allowLineDiscount  Boolean?
  allowOrderDiscount Boolean?

  // Ceilings on the COMBINED discount — every line discount plus the
  // order-level discount — measured against the order's gross. Both kinds may
  // be set at once, in which case both bind and the tighter one decides.
  // Percent is Decimal(6,3) like the tax rates; the flat cap is integer paise,
  // so no float ever takes part in a limit comparison.
  maxPercent   Decimal? @db.Decimal(6, 3)
  maxFlatPaise Int?

  // What this principal may authorise — for somebody else, or for themselves
  // above their own operating ceiling. A cashier approves nothing until an
  // admin says otherwise.
  canApprove           Boolean?
  maxApprovalPercent   Decimal? @db.Decimal(6, 3)
  maxApprovalFlatPaise Int?

  note        String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, scopeKey])
  @@index([companyId, level])
  @@index([branchId])
  @@index([userId])
}

model PosAuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  // The role the actor held when they did it, not the role they hold now.
  // Nullable because every row written before this column existed genuinely
  // does not know, and deriving one by joining PosUser today would backdate a
  // promotion onto an action taken before it.
  actorRole  String?
  companyId  String?
  action     String
  entity     String?
  entityId   String?
  ip         String?
  meta       Json?
  // LANE foundation — plain columns with no foreign key, like actorId above.
  // An audit write must never be the thing that fails a request, and a log row
  // that cannot be written because its subject was removed is worse than a log
  // row pointing at an id that no longer resolves.
  terminalId String?
  deviceId   String?

  @@index([companyId, at])
  @@index([action, at])
  @@index([deviceId, at])
}

// ---------------------------------------------------------------------------
// Phase 2 — catalog, tables, orders/KOT/billing, manual payments, reports.
// All money columns are DECIMAL(10,2) rupees; arithmetic happens in integer
// paise in src/lib/money.js and results are written back exact to 2dp.
// ---------------------------------------------------------------------------

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum TableStatus {
  ACTIVE
  RETIRED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  BILLED
  PAID
  VOID
  REFUNDED
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

enum DiscountType {
  FLAT
  PERCENT
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

// MANUAL = hand-recorded by staff, never presented as gateway-verified.
// GATEWAY = settled by the provider and confirmed by a signature-verified
// webhook. Nothing else may ever write GATEWAY.
enum PaymentChannel {
  MANUAL
  GATEWAY
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

// A manual refund is SUCCEEDED on creation — the cash is already out of the
// drawer. A gateway refund starts PENDING and only the provider can move it.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model TaxRate {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  ratePercent Decimal       @db.Decimal(6, 3)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products Product[]

  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  promotionRules PromotionItemRule[]

  @@unique([companyId, name])
  // Referenced by PromotionItemRule so a rule can only name this tenant's menu.
  @@unique([id, companyId])
  @@index([companyId])
}

model Product {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  name       String
  sku        String?
  basePrice  Decimal       @db.Decimal(10, 2)
  taxRateId  String?
  taxRate    TaxRate?      @relation(fields: [taxRateId], references: [id])
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  variants       ProductVariant[]
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  promotionRules PromotionItemRule[]
  // LANE inventory
  recipeLinks    RecipeProductLink[]

  @@unique([companyId, sku])
  // Referenced by PromotionItemRule — same rule as Category.
  @@unique([id, companyId])
  @@index([companyId, categoryId])
}

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  // Absolute unit price for this variant (not a delta on basePrice).
  price     Decimal       @db.Decimal(10, 2)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orderItems OrderItem[]
  // LANE inventory
  recipeLinks RecipeProductLink[]

  @@index([productId])
}

// Optional add-ons on a product (extra cheese, toppings). A group bounds the
// choice (minSelect..maxSelect per unit); an option carries a per-unit price
// ADDED to the variant/base price. Promotion treatment (spec VC-102): the
// modifier price is part of the line the promotion computes on — an eligible
// line's benefit base includes its modifiers, an excluded line's modifiers
// are excluded with it.
model ModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  minSelect Int           @default(0)
  // Null = no upper bound.
  maxSelect Int?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  options ModifierOption[]

  @@unique([productId, name])
  @@index([productId])
}

model ModifierOption {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id])
  name    String
  // Per-unit price added on top of the variant/base price. Zero is allowed.
  price   Decimal       @db.Decimal(10, 2)
  status  CatalogStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([groupId, name])
  @@index([groupId])
}

// Snapshot of one chosen modifier on one order line — name and per-unit price
// frozen at add time, like the line itself. optionId is a plain string, not a
// foreign key: the receipt must survive any later catalog change.
model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  optionId    String
  groupName   String
  name        String
  price       Decimal   @db.Decimal(10, 2)

  @@index([orderItemId])
}

model DiningTable {
  id        String      @id @default(cuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  name      String
  capacity  Int?
  status    TableStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders Order[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Order {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id])
  branchId             String
  branch               Branch        @relation(fields: [branchId, companyId], references: [id, companyId])
  type                 OrderType
  status               OrderStatus   @default(OPEN)
  tableId              String?
  table                DiningTable?  @relation(fields: [tableId], references: [id])
  // Assigned at bill time; format <branchCode>/<fy>/<seq5>. Unique per
  // company (branch codes are unique per company, not globally).
  invoiceNumber        String?
  openedById           String
  openedBy             PosUser       @relation("OrderOpenedBy", fields: [openedById], references: [id])
  discountType         DiscountType?
  discountValue        Decimal?      @db.Decimal(10, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 2)
  // Who allowed the discount this bill carries, and why. Snapshotted, not
  // re-derived: tomorrow's policy edit must never make yesterday's invoice
  // unexplainable. Null means the discount sat inside the operator's own
  // limit and needed nobody — or that there is no discount at all.
  // Restrict: deleting the approver must not quietly turn an approved
  // discount into an unexplained one.
  discountApprovedById String?
  discountApprovedBy   PosUser?      @relation("OrderDiscountApprovedBy", fields: [discountApprovedById], references: [id], onDelete: Restrict)
  discountApprovedAt   DateTime?
  discountReason       String?
  subtotal             Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal       @default(0) @db.Decimal(10, 2)
  total                Decimal       @default(0) @db.Decimal(10, 2)
  note                 String?
  voidReason           String?
  voidedById           String?
  voidedBy             PosUser?      @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  billedAt             DateTime?
  closedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // ---- LANE foundation ----------------------------------------------------
  // Everything the issued invoice legally asserted about the seller, frozen at
  // bill time: legal name, GSTIN, registered address, state code, FSSAI, store
  // id and series prefix. The seller's master data is editable by design, so
  // re-deriving these at print time would let a GSTIN corrected in March
  // silently restate a January invoice. Null on every order billed before this
  // column existed — those receipts keep reading from the live records, which
  // is the only information that ever existed for them. Never backfilled with
  // today's values pretending to be that day's.
  billingSnapshot Json?
  // Which till and which physical device rang it up. Nullable: a bill taken on
  // a browser that never enrolled has no device, and that is not an error.
  //
  // Both carry branchId, so attribution is checked against the store the
  // transaction actually happened in. An order cannot claim to have been rung
  // up on another store's counter.
  terminalId      String?
  terminal        Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  deviceId        String?
  device          Device?   @relation(fields: [deviceId, branchId], references: [id, branchId], onDelete: Restrict)

  items       OrderItem[]
  kots        Kot[]
  payments    Payment[]
  refunds     Refund[]
  intents     PaymentIntent[]
  redemptions PromotionRedemption[]
  phoneOrder  PhoneOrder?

  @@unique([companyId, invoiceNumber])
  // Lets a payment reference (orderId, branchId), which is what ties the money
  // to the same store as the bill.
  @@unique([id, branchId])
  // Lets a promotion redemption reference (orderId, companyId, branchId) in
  // one foreign key, tying it to the same tenant AND store as the bill.
  @@unique([id, companyId, branchId])
  @@index([companyId, branchId, status])
  @@index([companyId, billedAt])
  @@index([tableId])
  @@index([discountApprovedById])
  @@index([terminalId])
  @@index([deviceId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  // Snapshots at add time — later catalog edits never change this line.
  name           String
  // Per-unit price INCLUDING chosen modifiers (base/variant + Σ modifier
  // prices). The modifiers relation below is the printed breakdown; all money
  // math reads this one column, so promotions and taxes see modifiers by
  // construction.
  unitPrice      Decimal         @db.Decimal(10, 2)
  qty            Int
  lineDiscount   Decimal         @default(0) @db.Decimal(10, 2)
  taxRateName    String?
  taxRatePercent Decimal?        @db.Decimal(6, 3)
  // Stored results of the §6 contract math (incl. order-discount share).
  lineSubtotal   Decimal         @default(0) @db.Decimal(10, 2)
  discountShare  Decimal         @default(0) @db.Decimal(10, 2)
  lineTax        Decimal         @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal         @default(0) @db.Decimal(10, 2)
  kotId          String?
  kot            Kot?            @relation(fields: [kotId], references: [id])
  status         OrderItemStatus @default(ACTIVE)
  voidReason     String?
  voidedById     String?
  voidedBy       PosUser?        @relation("OrderItemVoidedBy", fields: [voidedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Kitchen instruction for this line ("no onion"). Printed on the KOT and
  // shown on the station, never on the customer's receipt. See LANE kitchen.
  note           String?
  kitchenItem    KitchenItem?

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model Kot {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  seq       Int
  createdAt DateTime @default(now())

  items OrderItem[]
  kitchenItems KitchenItem[]

  @@unique([orderId, seq])
}

model Payment {
  id           String         @id @default(cuid())
  orderId      String
  // Carried on the payment, not looked up through the order, because it is the
  // column the terminal and device references below are checked against. A
  // payment therefore cannot be attributed to a till or a device belonging to
  // a store other than the one that issued the bill. Backfilled from the order
  // for every payment written before this column existed.
  branchId     String
  order        Order          @relation(fields: [orderId, branchId], references: [id, branchId])
  method       PaymentMethod
  channel      PaymentChannel @default(MANUAL)
  // amount = applied to the order (≤ remaining due). For cash, tendered is
  // what the customer handed over; change = tendered − amount, never stored.
  amount       Decimal        @db.Decimal(10, 2)
  tendered     Decimal?       @db.Decimal(10, 2)
  note         String?
  // Null for GATEWAY: the provider settled it, no member of staff received
  // anything. Recording the cashier here would misattribute the money.
  receivedById String?
  receivedBy   PosUser?       @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  // Unique, so one intent can never settle twice however often the provider
  // redelivers. This is the last line of defence behind webhook idempotency.
  intentId     String?        @unique
  intent       PaymentIntent? @relation(fields: [intentId], references: [id])
  // The provider's id for the CHARGE, which is not its id for the attempt.
  // A Razorpay refund posts to /payments/<this>/refund, while the attempt is
  // an order_… held on PaymentIntent.providerRef — so without this column a
  // gateway payment cannot be refunded at all. Null for MANUAL, and for any
  // provider that names the attempt and the charge with one id.
  providerRef  String?        @unique
  // Makes a RETRIED manual payment return the first one instead of collecting
  // the bill twice — the same job PaymentIntent.idempotencyKey does for the
  // gateway, which the manual path never had.
  //
  // It is needed because the guards on the payments route cannot see this case.
  // They refuse a second payment once the order is PAID or nothing is due, which
  // happens to cover a retried payment for the FULL amount — and so the hole
  // looked closed. A PARTIAL payment leaves the order BILLED with money still
  // due, so a retry passes both guards and is written again. Proven on the
  // deployed build against BSC-CP/26-27/00011: the response to a ₹47.25 card
  // payment was dropped after the server had committed it, the cashier pressed
  // Record payment again, and a ₹94.50 bill came out PAID on two ₹47.25 rows
  // for one swipe. Split bills are ordinary in a café, so this is the common
  // case, not the exotic one.
  //
  // Nullable, and unique only per order: gateway payments and every row written
  // before this column existed carry NULL, and Postgres treats NULLs as distinct
  // so any number of them coexist. Scoping to the order rather than making it
  // globally unique means a till that reuses a key across orders — a clock reset,
  // a cloned device — cannot suppress a real payment on a different bill.
  idempotencyKey String?

  createdAt    DateTime       @default(now())

  // LANE foundation — which till and device took the money. A cash variance is
  // only answerable if the drawer it came out of is on the row.
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId, branchId], references: [id, branchId], onDelete: Restrict)

  @@unique([orderId, idempotencyKey])
  @@index([branchId])
  @@index([orderId])
  @@index([createdAt])
  @@index([terminalId])
  @@index([deviceId])
}

// One attempt to collect an order's due amount through a provider. Order-linked
// so reconciliation can always put "what we asked for" beside "what arrived".
model PaymentIntent {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  provider       String
  // The provider's own id for the attempt; null until the provider answers.
  // Postgres treats NULLs as distinct, so many un-answered intents coexist.
  providerRef    String?
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("INR")
  status         PaymentIntentStatus @default(CREATED)
  // Sent to the provider, so a retried create returns the first attempt
  // instead of opening a second one the customer could also pay.
  idempotencyKey String              @unique
  failureReason  String?
  createdById    String
  createdBy      PosUser             @relation("PaymentIntentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  closedAt       DateTime?

  payment       Payment?
  webhookEvents GatewayWebhookEvent[]
  refunds       Refund[]              @relation("RefundIntent")

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status])
}

// Which code path wrote the row. WEBHOOK is a delivery that arrived at
// /api/gateway/webhook and passed signature verification. RECOVERY is one the
// pull-based reconcile built after ASKING the provider what it has, for an
// intent whose webhook never turned up.
//
// Authoritative about our side only. It records which of our code paths ran;
// it is not a claim about who originated the event, because a verified
// delivery can be signed by anything holding the webhook secret — which on a
// dev box includes this repository's own scripts.
enum GatewayEventSource {
  WEBHOOK
  RECOVERY
}

// One row per signature-VERIFIED delivery. Rejected deliveries are deliberately
// NOT stored here: eventId comes from the payload, so recording unverified ones
// would let anyone squat the unique key with a forged id and permanently block
// the genuine event from ever being applied. Rejections go to PosAuditLog.
model GatewayWebhookEvent {
  id            String             @id @default(cuid())
  provider      String
  eventId       String
  kind          String
  payloadHash   String
  // No default, so every writer has to say which it is. A default of WEBHOOK
  // would quietly label a future path's rows as provider deliveries.
  source        GatewayEventSource
  // Set only when the delivery matched a real intent. This is also the only
  // route by which an event can be attributed to a company, since events
  // carry no tenant of their own.
  intentId      String?
  intent        PaymentIntent?     @relation(fields: [intentId], references: [id])
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  // Why a verified delivery still changed nothing — unknown intent, already
  // settled, order no longer billable. Null once it has been applied.
  skippedReason String?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([processedAt])
  @@index([source])
}

model Refund {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  amount         Decimal        @db.Decimal(10, 2)
  reason         String
  // MANUAL: cash or card handed back across the counter. Done the moment it
  // happens, because a person did it.
  //
  // GATEWAY: only the provider can move this money back. Writing the row
  // returns nothing to anybody, so the refund stays a REQUEST until a
  // signature-verified webhook says the provider actually paid it out. A
  // PENDING refund must never be shown, totalled or reported as money returned.
  channel        PaymentChannel @default(MANUAL)
  status         RefundStatus   @default(SUCCEEDED)
  // How a MANUAL refund went back: notes out of the till, or a reversal on the
  // card terminal, or a UPI transfer. Only CASH leaves the drawer, and the day
  // close cannot tell the difference without it — every manual refund used to
  // be counted as cash, so refunding a card bill made an honest count read
  // "over" by exactly that amount.
  //
  // Null on GATEWAY rows (the provider returns it) and on every manual row
  // written before this column existed. Those old rows are still read as cash,
  // so no past closing, and no after-the-count figure, moves.
  method         PaymentMethod?
  // The gateway payment being reversed, and the provider's own reference for
  // the reversal. providerRef is unique so a redelivered refund webhook lands
  // on exactly one row.
  //
  // A GATEWAY row that is PENDING with a NULL providerRef is the unknown
  // state: the request was reserved here, but the provider never told us
  // whether it took it. It may already be paying out. It therefore keeps
  // holding its amount and must be reconciled, never re-requested.
  intentId       String?
  intent         PaymentIntent? @relation("RefundIntent", fields: [intentId], references: [id])
  providerRef    String?        @unique
  // Sent to the provider, and kept, so a request whose outcome we never
  // learned can be re-sent as THE SAME request. Without a stored key a retry
  // is a second refund and the customer is paid twice. Null for MANUAL, where
  // there is no provider to deduplicate against.
  idempotencyKey String?        @unique
  failureReason  String?
  byId           String
  by             PosUser        @relation("RefundBy", fields: [byId], references: [id])
  createdAt      DateTime       @default(now())
  settledAt      DateTime?

  @@index([orderId])
  @@index([status])
}

// One row per branch per financial year; bill transactions increment
// lastNumber atomically, so concurrent bills can never share a number.
model InvoiceCounter {
  id         String @id @default(cuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
  fyLabel    String
  lastNumber Int    @default(0)
  // The series this year's bills are issued under, frozen when the year's
  // first bill is issued. Read back for every later bill in the same series,
  // so editing Branch.code or Branch.invoicePrefix mid-year cannot relabel a
  // running series. See lib/invoice.js.
  //
  // Backfilled for existing counters from the invoice numbers already issued
  // under them — historical evidence, not today's branch values.
  seriesPrefix String

  @@unique([branchId, fyLabel])
}

// One branch's end-of-day cash count. The system already knows what it
// BELIEVES is in the drawer; this records what someone actually counted, and
// the difference between the two.
//
// The difference is the entire point. A POS that only ever reports its own
// figures cannot tell an owner about a till that is short — it has no
// independent measurement to disagree with. Cash is the only tender where the
// business holds the money physically and can therefore lose it physically,
// so it is the only one counted here; card and UPI are reported for the day
// but not declared, because the bank's figure settles those, not a cashier's.
//
// Immutable once written. A closing that can be edited after the fact is not
// evidence of anything, and the reason to reopen a day is almost always that
// someone disliked the variance. A correction is a new row, which is why
// (branchId, businessDate) is not unique and `supersededById` exists.
model DayClose {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id])
  // IST calendar day, 'YYYY-MM-DD'. A café's day is not a UTC day, and a
  // closing done at 23:40 IST must land on the day the staff were working.
  businessDate String

  // Counted by hand, in the drawer, including the float that started the day.
  countedCashPaise  Int
  openingFloatPaise Int @default(0)

  // What the system believed, frozen at the moment of closing. Recomputed
  // later these would drift — a refund settled the next morning would rewrite
  // history — and a closing that changes after it is signed is worthless.
  expectedCashPaise Int
  cashSalesPaise    Int
  cashRefundsPaise  Int
  // Non-cash is recorded for the day's report but never declared.
  cardSalesPaise    Int @default(0)
  upiSalesPaise     Int @default(0)
  otherSalesPaise   Int @default(0)
  gatewaySalesPaise Int @default(0)
  // countedCash − openingFloat − expectedCash. Positive is over, negative short.
  variancePaise     Int
  ordersBilled      Int @default(0)

  // Required when the count disagrees, enforced in the route: an unexplained
  // variance is the one an owner most needs explained.
  note String?

  closedById String
  closedBy   PosUser  @relation("DayClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime @default(now())

  // A correcting closing points at the one it replaces. Reading the latest row
  // per day gives the current truth; the chain keeps what was said before it.
  supersededById String?   @unique
  supersedes     DayClose? @relation("DayCloseCorrection", fields: [supersededById], references: [id])
  correctedBy    DayClose? @relation("DayCloseCorrection")

  @@index([companyId, businessDate])
  @@index([branchId, businessDate])
}

// ==== LANE inventory ====
// ---------------------------------------------------------------------------
// Inventory, purchasing, recipes and THE stock ledger (VC-105 reads it).
// Design notes live in docs/lanes/INVENTORY.md; the rules that matter most:
//
// * StockMovement is the only record of stock. It is append-only — no route
//   updates or deletes a row — and every figure an owner sees (on hand, value,
//   average cost, the cost of a sale) is either read from it or from
//   StockBalance, a cache that is written in the same transaction as the
//   movement and can be rebuilt from the ledger at any time.
// * Quantities are stored in the item's BASE unit (g, ml or pcs) at 3
//   decimals and handled in code as integer thousandths ("milli"), the same
//   way money is handled as integer paise. Values are integer paise (BigInt,
//   because a warehouse's stock value can pass the 32-bit ceiling of ₹2.1 cr).
// * Costing method: perpetual WEIGHTED AVERAGE per location per item. See
//   src/lib/inventory/ledger.js for the issue rule and negative-stock policy.
// * Core models are referenced by FK only where integrity is worth a shared
//   schema edit (tenant, store, product). Users and source documents are plain
//   ids: a movement's source is polymorphic (GRN line, order line, count line)
//   and Postgres cannot put one foreign key on that anyway.
// ---------------------------------------------------------------------------

enum InventoryLocationKind {
  STORE
  WAREHOUSE
  CENTRAL_KITCHEN
}

enum InventoryItemKind {
  RAW
  SEMI_FINISHED
  FINISHED
  // Cups, lids, boxes, sleeves. Bought, stored, counted and consumed by recipe
  // exactly like an ingredient, but never an edible input — food-cost reports
  // separate it so packaging does not inflate a dish's ingredient cost.
  PACKAGING
}

// What a location physically is, for items whose storage conditions matter.
// Independent of InventoryLocationKind: a store has a freezer and a bar, a
// warehouse has dry storage and a cold room.
enum InventoryStorageKind {
  AMBIENT
  DRY
  CHILLED
  FROZEN
  KITCHEN
  BAR
}

// Whether a batch may be issued at all. Expiry is NOT a state here — it is
// derived from expiryDate at the moment of every eligibility check, so expired
// stock is refused even when no scheduler has run for a week.
enum StockBatchState {
  AVAILABLE
  QUARANTINED
  RECALLED
}

// The unit every quantity of an item is stored in. Three, because every
// conversion a kitchen makes (kg→g, l→ml, dozen→pcs, box→pcs) lands on one of
// them, and a ledger in one unit per item is one that can be summed.
enum InventoryBaseUnit {
  G
  ML
  PCS
}

enum InventoryStatus {
  ACTIVE
  ARCHIVED
}

// For a SEMI_FINISHED item: BATCH is made ahead (a sauce, a cold-brew
// concentrate) and sold out of stock; MADE_TO_ORDER is made per portion (an
// espresso shot) and exploded into its own recipe's ingredients at sale.
enum InventoryProductionMode {
  BATCH
  MADE_TO_ORDER
}

enum StockMovementType {
  GRN
  PURCHASE_RETURN
  SALE_CONSUMPTION
  SALE_REVERSAL
  WASTAGE
  COUNT_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  PRODUCTION_IN
  PRODUCTION_OUT
}

// How much the value on a movement can be trusted.
//   ACTUAL    — issued out of recorded stock at its weighted average.
//   ESTIMATED — some or all of it was issued beyond what the ledger held, and
//               that part was valued at the last known average: a stale cost.
//   MISSING   — nothing was ever received at this location with a value, so
//               there is no cost to use. The value is 0 and must never be read
//               as "free".
enum StockCostStatus {
  ACTUAL
  ESTIMATED
  MISSING
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum StockTransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum WastageReason {
  EXPIRED
  SPOILED
  DAMAGED
  PREP_ERROR
  OTHER
}

enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SaleConsumptionStatus {
  POSTED
  UNCOSTED
}

enum LandedCostBasis {
  VALUE
  QUANTITY
}

model InventoryLocation {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Optional: a warehouse or central kitchen need not belong to any store.
  branchId  String?
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  kind      InventoryLocationKind
  name      String
  code      String
  status    InventoryStatus       @default(ACTIVE)
  // The one location a store's sales consume from, written as the branch id
  // so the unique index can hold it to one per store (NULLs are distinct, so
  // every other location leaves it null). A store with no such location sells
  // exactly as before — its lines are reported as uncosted, never blocked.
  saleSourceBranchId String?      @unique
  // A sublocation: the freezer inside a store, dry storage inside a warehouse.
  // One level only — a shelf inside a freezer is a labelling problem, not a
  // stock one, and nesting turns every balance query into a recursive CTE.
  // A sublocation inherits kind and branchId from its parent; the routes
  // enforce that rather than duplicating the columns' meaning.
  parentId  String?
  parent    InventoryLocation?    @relation("LocationParent", fields: [parentId], references: [id], onDelete: Restrict)
  children  InventoryLocation[]   @relation("LocationParent")
  storageKind InventoryStorageKind @default(AMBIENT)
  // What this location can physically hold, in base units, for the capacity
  // check a replenishment suggestion makes. Null means "not modelled" and the
  // check is skipped — never silently treated as zero.
  capacityBaseQty Decimal?         @db.Decimal(18, 3)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  movements     StockMovement[]
  balances      StockBalance[]
  batchBalances StockBatchBalance[]
  reservations  StockReservation[]
  reorderRules  StockReorderRule[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts GoodsReceipt[]
  counts        StockCount[]
  wastages      StockWastage[]
  transfersOut  StockTransfer[]   @relation("TransferFrom")
  transfersIn   StockTransfer[]   @relation("TransferTo")
  productions   ProductionBatch[]
  batchOpenings StockBatchOpening[]
  requestsFrom  StoreRequest[]    @relation("RequestDestination")
  requestsTo    StoreRequest[]    @relation("RequestSource")
  plansTo       ReplenishmentPlan[] @relation("PlanDestination")
  plansFrom     ReplenishmentPlan[] @relation("PlanSource")
  accessGrants  InventoryLocationAccess[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([parentId])
}

model InventoryItem {
  id             String                  @id @default(cuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  kind           InventoryItemKind
  name           String
  sku            String?
  baseUnit       InventoryBaseUnit
  status         InventoryStatus         @default(ACTIVE)
  trackBatches   Boolean                 @default(false)
  trackExpiry    Boolean                 @default(false)
  productionMode InventoryProductionMode @default(BATCH)
  // A whole chicken, a wheel of cheese: the pack is a piece but what it weighs
  // has to be measured, not assumed. Receipts and issues of such an item carry
  // an actual weight and the ledger records THAT, never a nominal pack size.
  variableWeight Boolean                 @default(false)
  // The base unit the measured weight of a variable-weight item is given in.
  // Separate from baseUnit, which stays PCS so a count still counts birds.
  weightUnit     InventoryBaseUnit?
  // Refuse a receipt whose batch has less than this much life left. Null means
  // no rule; 0 means "anything not already expired".
  minShelfLifeDaysAtReceipt Int?
  // Once a container is opened it spoils on its own clock. Null disables the
  // whole mechanism for this item. Opening a container NEVER moves the batch's
  // own expiry date — the two run side by side.
  openedShelfLifeHours      Int?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  units          InventoryItemUnit[]
  batches        StockBatch[]
  movements      StockMovement[]
  balances       StockBalance[]
  batchBalances  StockBatchBalance[]
  reservations   StockReservation[]
  reorderRules   StockReorderRule[]
  supplierPrices SupplierItemPrice[]
  poLines        PurchaseOrderLine[]
  grnLines       GoodsReceiptLine[]
  recipeLines    RecipeLine[]
  producedBy     Recipe?                 @relation("RecipeOutput")
  modifierAdjustments RecipeModifierAdjustment[]
  countLines     StockCountLine[]
  wastageLines   StockWastageLine[]
  transferLines  StockTransferLine[]
  productions    ProductionBatch[]
  requestLines   StoreRequestLine[]
  planLines      ReplenishmentPlanLine[]

  @@unique([companyId, name])
  @@unique([companyId, sku])
  @@index([companyId, kind])
}

// An item-specific unit: a "box" of 12 pcs, a "bag" of 25 kg, a "cup" of
// 120 g of flour. Standard units (g/kg, ml/l, pcs/dozen) are code, not rows.
// Never edited or deleted once written: a PO line or recipe line entered in
// "box" has to mean the same number of pcs tomorrow.
model InventoryItemUnit {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Lower-case, so "Box" and "box" cannot become two different sizes.
  name        String
  // Base-unit thousandths in ONE of this unit: box of 12 pcs = 12000.
  factorMilli Int
  createdAt   DateTime      @default(now())

  @@unique([itemId, name])
}

// Company-wide per item: the same batch keeps its code and expiry wherever a
// transfer takes it. On-hand per batch is derived from the ledger.
model StockBatch {
  id         String        @id @default(cuid())
  companyId  String
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchCode  String
  expiryDate DateTime?     @db.Date
  // The supplier's or manufacturer's own number for the same goods, kept
  // beside ours because a recall notice quotes theirs, not ours.
  supplierBatchCode String?
  manufacturedOn    DateTime? @db.Date
  receivedAt        DateTime?
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // AVAILABLE / QUARANTINED / RECALLED. Expiry is deliberately NOT in here:
  // see the enum's comment.
  state             StockBatchState @default(AVAILABLE)
  stateReason       String?
  stateChangedAt    DateTime?
  stateChangedById  String?
  createdAt  DateTime      @default(now())

  movements      StockMovement[]
  balances       StockBatchBalance[]
  openings       StockBatchOpening[]
  reservationLines StockReservationLine[]
  transferLines  StockTransferLineBatch[]

  @@unique([itemId, batchCode])
  @@index([companyId, expiryDate])
  @@index([companyId, state])
}

// On-hand per location PER BATCH — quantity only. Value stays on StockBalance
// because the costing method is weighted average per location+item, and
// splitting value per batch would quietly turn it into specific identification.
// FEFO reads this; valuation never does. Written in the same transaction as
// the movement, and rebuildable from the ledger exactly like StockBalance.
model StockBatchBalance {
  id         String            @id @default(cuid())
  companyId  String
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId    String
  batch      StockBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  qty        Decimal           @default(0) @db.Decimal(18, 3)
  updatedAt  DateTime          @updatedAt

  @@unique([locationId, itemId, batchId])
  @@index([companyId, itemId])
}

// A container of a batch that has been opened at a location. Its useByAt runs
// on its own clock and does NOT touch the batch's expiryDate — an opened 5 l
// carton going off in 48 hours must not condemn the four unopened ones beside
// it. Quantity is what is left inside the opened container.
model StockBatchOpening {
  id         String            @id @default(cuid())
  companyId  String
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batchId    String
  batch      StockBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  openedAt   DateTime          @default(now())
  useByAt    DateTime
  qty        Decimal           @db.Decimal(18, 3)
  closedAt   DateTime?
  openedById String?
  note       String?

  @@index([companyId, useByAt])
  @@index([locationId, batchId])
}

// THE stock ledger. Append-only. See the note at the top of this block.
model StockMovement {
  id             String            @id @default(cuid())
  // Total posting order, so a replay of the ledger is deterministic even when
  // two rows share a timestamp.
  seq            BigInt            @default(autoincrement())
  companyId      String
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId         String
  item           InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          StockBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type           StockMovementType
  // Signed, base units: positive into this location, negative out of it.
  qty            Decimal           @db.Decimal(18, 3)
  // Signed integer paise, same sign as qty. This — not unitCostPaise — is the
  // authoritative value; the unit cost is the same fact divided out for people.
  valuePaise     BigInt
  // Paise per BASE unit at the time (sugar at ₹45/kg is 0.045000). Null only
  // when the cost is MISSING.
  unitCostPaise  Decimal?          @db.Decimal(20, 6)
  costStatus     StockCostStatus
  // When the average this movement was valued at was last refreshed by a
  // valued receipt. Frozen here so "was this cost stale when it was used" has
  // the same answer next year as today.
  costBasisAt    DateTime?
  // The location+item position straight after this row. Lets anyone check the
  // ledger against itself without trusting the balance cache.
  balanceQtyAfter   Decimal        @db.Decimal(18, 3)
  balanceValueAfter BigInt
  // What caused it: 'GRN' | 'PURCHASE_RETURN' | 'ORDER_ITEM' | 'SALE_RETURN'
  // | 'WASTAGE' | 'STOCK_COUNT' | 'TRANSFER' | 'PRODUCTION'.
  sourceType     String
  sourceId       String
  sourceLineId   String?
  // Deterministic per source line, so a retried post can never write twice.
  idempotencyKey String            @unique
  // Business time (a sale's billedAt). postedAt is server time and is what
  // as-of valuation reads, so a valuation taken at 18:00 is reproducible.
  occurredAt     DateTime
  postedAt       DateTime          @default(now())
  createdById    String?
  // B§3.1 p6: transactions carry terminal/device attribution where operationally
  // relevant, and a stock movement is named there explicitly. Null stays the
  // honest answer for a posting no till caused — a scheduler pass, a goods
  // receipt, a back-office correction — which is most of this table.
  //
  // For a sale it is the ORDER's till, not whichever till pressed "bill".
  // Order.terminalId is what the day's takings are attributed to; a ledger that
  // named a different till for the same sale would make the sales report and
  // the stock report disagree about one event with nothing to say which was
  // right. The two are the same till in the ordinary case anyway, because a
  // device may only touch an order in its own store.
  //
  // Paired with companyId rather than referencing a bare id, the way Order and
  // Device pair it with branchId: the denormalised companyId on this row is
  // only worth something if the database checks it, and this is that check — a
  // till belonging to another tenant cannot be stamped on this tenant's ledger.
  // The pair is MATCH SIMPLE, so a movement with no till still writes.
  terminalId     String?
  terminal       Terminal?         @relation(fields: [terminalId, companyId], references: [id, companyId], onDelete: Restrict)
  note           String?

  @@index([companyId, locationId, itemId, seq])
  @@index([companyId, type, occurredAt])
  @@index([companyId, postedAt])
  @@index([sourceType, sourceId])
  @@index([locationId, itemId, batchId])
}

// Cache of Σ ledger per location+item, updated under a row lock in the same
// transaction as the movement. GET /api/inventory/ledger/verify proves it
// equals the ledger; POST /api/inventory/ledger/rebuild rewrites it from there.
model StockBalance {
  id                String            @id @default(cuid())
  companyId         String
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId            String
  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qty               Decimal           @default(0) @db.Decimal(18, 3)
  valuePaise        BigInt            @default(0)
  // The weighted average the last time this position held stock. Used only to
  // value an issue that goes beyond what the ledger holds (ESTIMATED).
  lastUnitCostPaise Decimal?          @db.Decimal(20, 6)
  costBasisAt       DateTime?
  lastSeq           BigInt?
  updatedAt         DateTime          @updatedAt

  @@unique([locationId, itemId])
  @@index([companyId])
}

model StockReorderRule {
  id          String            @id @default(cuid())
  companyId   String
  locationId  String
  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Base units. At or below minQty the item is on the alert list; reorderQty
  // is what the alert suggests ordering.
  minQty      Decimal           @db.Decimal(18, 3)
  reorderQty  Decimal           @db.Decimal(18, 3)
  updatedById String?
  updatedAt   DateTime          @updatedAt

  @@unique([locationId, itemId])
  @@index([companyId])
}

// Per-company inventory policy. Absent row = the defaults below.
model InventorySettings {
  companyId         String   @id
  // Whether GST paid on purchases is part of what stock costs. TRUE by default
  // because a restaurant on 5% GST without input tax credit cannot recover it,
  // and leaving it out would understate every cost and overstate every margin.
  // INTEGRATION(foundation): derive from the GST registration's ITC status.
  purchaseTaxIsCost Boolean  @default(true)
  // A cost basis older than this at the time of a sale is reported as stale.
  staleCostDays     Int      @default(90)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

// Per-company, per-document-type, per-FY counter — PO/26-27/0001 etc.
model InventoryDocCounter {
  id         String @id @default(cuid())
  companyId  String
  docType    String
  fyLabel    String
  lastNumber Int    @default(0)

  @@unique([companyId, docType, fyLabel])
}

model Supplier {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name             String
  code             String?
  // INTEGRATION(foundation): validate against the GST registration model.
  gstin            String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  paymentTermsDays Int?
  status           InventoryStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  prices         SupplierItemPrice[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  batches        StockBatch[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Append-only price history. The current price is the latest effectiveFrom
// at or before now; nothing is edited, so a PO can always be traced to the
// price that was on file when it was raised.
model SupplierItemPrice {
  id            String        @id @default(cuid())
  companyId     String
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit          String
  // Integer paise per ONE purchase unit, ex-tax.
  pricePaise    Int
  taxPctMilli   Int           @default(0)
  effectiveFrom DateTime      @default(now())
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([supplierId, itemId, effectiveFrom])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String
  number       String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // Deliver-to location; the store/warehouse whose manager may raise it.
  locationId   String
  location     InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  expectedAt   DateTime?
  note         String?
  subtotalPaise BigInt             @default(0)
  taxPaise     BigInt              @default(0)
  totalPaise   BigInt              @default(0)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  closedById   String?
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([locationId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  poId            String
  po              PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  lineNo          Int
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit            String
  qty             Decimal       @db.Decimal(18, 3)
  qtyBase         Decimal       @db.Decimal(18, 3)
  unitPricePaise  Int
  taxPctMilli     Int           @default(0)
  linePaise       BigInt
  taxPaise        BigInt
  // Σ base qty received by GRNs, maintained under the PO row lock.
  receivedQtyBase Decimal       @default(0) @db.Decimal(18, 3)

  grnLines GoodsReceiptLine[]

  @@unique([poId, lineNo])
}

// A goods receipt is posted once and never edited; a mistake is corrected by
// a purchase return (and, for a shortfall, by closing the PO short).
model GoodsReceipt {
  id                  String            @id @default(cuid())
  companyId           String
  number              String
  poId                String?
  po                  PurchaseOrder?    @relation(fields: [poId], references: [id], onDelete: Restrict)
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  locationId          String
  location            InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?         @db.Date
  note                String?
  // Integer paise. goods = Σ qty × price ex-tax; stockValue is what entered
  // the ledger (goods + landed + tax when tax is a cost).
  goodsPaise          BigInt
  taxPaise            BigInt
  landedCostPaise     BigInt            @default(0)
  stockValuePaise     BigInt
  taxIsCost           Boolean
  idempotencyKey      String?
  receivedById        String
  receivedAt          DateTime          @default(now())

  lines       GoodsReceiptLine[]
  landedCosts GoodsReceiptLandedCost[]
  returns     PurchaseReturn[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, receivedAt])
  @@index([poId])
}

model GoodsReceiptLine {
  id                 String             @id @default(cuid())
  grnId              String
  grn                GoodsReceipt       @relation(fields: [grnId], references: [id], onDelete: Restrict)
  lineNo             Int
  poLineId           String?
  poLine             PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  itemId             String
  item               InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit               String
  qty                Decimal            @db.Decimal(18, 3)
  qtyBase            Decimal            @db.Decimal(18, 3)
  unitPricePaise     Int
  // Variance against the PO, frozen at receipt. Null on a receipt with no PO.
  poUnitPricePaise   Int?
  outstandingQtyBase Decimal?           @db.Decimal(18, 3)
  qtyVarianceBase    Decimal?           @db.Decimal(18, 3)
  priceVariancePaise BigInt?
  taxPctMilli        Int                @default(0)
  goodsPaise         BigInt
  taxPaise           BigInt
  landedCostPaise    BigInt             @default(0)
  valuePaise         BigInt
  batchId            String?
  returnedQtyBase    Decimal            @default(0) @db.Decimal(18, 3)

  returnLines PurchaseReturnLine[]

  @@unique([grnId, lineNo])
}

model GoodsReceiptLandedCost {
  id          String          @id @default(cuid())
  grnId       String
  grn         GoodsReceipt    @relation(fields: [grnId], references: [id], onDelete: Restrict)
  kind        String
  description String?
  amountPaise BigInt
  basis       LandedCostBasis @default(VALUE)
}

model PurchaseReturn {
  id              String       @id @default(cuid())
  companyId       String
  number          String
  grnId           String
  grn             GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Restrict)
  supplierId      String
  locationId      String
  reason          String
  // What the supplier owes back (at the receipt's cost) vs what left the
  // ledger (at today's weighted average). The difference is recorded, not
  // hidden in the average.
  creditPaise     BigInt
  stockValuePaise BigInt
  idempotencyKey  String?
  createdById     String
  createdAt       DateTime     @default(now())

  lines PurchaseReturnLine[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
}

model PurchaseReturnLine {
  id              String           @id @default(cuid())
  returnId        String
  return          PurchaseReturn   @relation(fields: [returnId], references: [id], onDelete: Restrict)
  grnLineId       String
  grnLine         GoodsReceiptLine @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  itemId          String
  qtyBase         Decimal          @db.Decimal(18, 3)
  creditPaise     BigInt
  stockValuePaise BigInt
}

// A recipe makes either a menu item (linked through RecipeProductLink, output
// one portion) or an inventory item (outputItemId: a semi-finished sauce, a
// finished packaged good). Its content lives in versions.
model Recipe {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  outputItemId String?         @unique
  outputItem   InventoryItem?  @relation("RecipeOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  status       InventoryStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  versions            RecipeVersion[]
  productLinks        RecipeProductLink[]
  modifierAdjustments RecipeModifierAdjustment[]

  @@unique([companyId, name])
}

// Immutable once ACTIVE. Changing a recipe is a new version, so the version a
// sale consumed is still exactly what it was when the sale is read back.
model RecipeVersion {
  id            String              @id @default(cuid())
  recipeId      String
  recipe        Recipe              @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  version       Int
  status        RecipeVersionStatus @default(DRAFT)
  // Share of the nominal output actually obtained, 3dp. 80 = trim/cook loss
  // of a fifth, so every input is divided by 0.8.
  yieldPercent  Decimal             @default(100) @db.Decimal(6, 3)
  // Nominal output in the output item's base unit; 1 for a menu portion.
  outputQty     Decimal             @default(1) @db.Decimal(18, 3)
  note          String?
  createdById   String?
  createdAt     DateTime            @default(now())
  activatedById String?
  activatedAt   DateTime?
  retiredAt     DateTime?

  lines       RecipeLine[]
  productions ProductionBatch[]

  @@unique([recipeId, version])
  @@index([recipeId, status])
}

model RecipeLine {
  id        String        @id @default(cuid())
  versionId String
  version   RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  lineNo    Int
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qty       Decimal       @db.Decimal(18, 3)
  unit      String
  qtyBase   Decimal       @db.Decimal(18, 3)

  @@unique([versionId, lineNo])
}

// Menu item → recipe. variantKey is variantId or '' so the unique index can
// hold "one recipe per product" and "one per variant" at once (NULLs would be
// distinct). A variant's own link wins over its product's.
model RecipeProductLink {
  id         String          @id @default(cuid())
  companyId  String
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantKey String
  recipeId   String
  recipe     Recipe          @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())

  @@unique([productId, variantKey])
  @@index([companyId])
  @@index([recipeId])
}

// INTEGRATION(promotions): catalog modifiers are the promotions lane's model.
// This maps a modifier id (no FK until that model lands) to a change in what
// a sale consumes: "extra shot" +1 espresso, "oat milk" −150 ml milk and
// +150 ml oat milk. recipeKey is recipeId or '' ('' = whatever recipe the
// modifier is sold with), for the same NULL-distinct reason as variantKey.
model RecipeModifierAdjustment {
  id         String        @id @default(cuid())
  companyId  String
  modifierId String
  recipeId   String?
  recipe     Recipe?       @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeKey  String
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Signed, base units per portion.
  qtyDelta   Decimal       @db.Decimal(18, 3)
  createdAt  DateTime      @default(now())

  @@unique([companyId, modifierId, recipeKey, itemId])
}

// One row per sold order line, written by the bill hook (or the sync). The
// unique orderItemId is what makes the hook idempotent: a retried or doubled
// hook finds this row and posts nothing.
model SaleConsumption {
  id              String                @id @default(cuid())
  companyId       String
  branchId        String
  orderId         String
  orderItemId     String                @unique
  locationId      String?
  recipeVersionId String?
  status          SaleConsumptionStatus
  // NO_STOCK_LOCATION | NO_RECIPE | NO_ACTIVE_VERSION | EMPTY_RECIPE
  uncostedReason  String?
  qtySold         Int
  // −Σ valuePaise of this line's SALE_CONSUMPTION movements.
  costPaise       BigInt                @default(0)
  // Worst of its movements; MISSING when uncosted.
  costStatus      StockCostStatus
  costBasisAt     DateTime?
  returnedQty     Int                   @default(0)
  occurredAt      DateTime
  postedAt        DateTime              @default(now())

  returns SaleStockReturn[]

  @@index([companyId, occurredAt])
  @@index([orderId])
}

// The explicit "returned to stock" action. A refund never returns stock on
// its own — a refunded coffee has been drunk.
model SaleStockReturn {
  id                String          @id @default(cuid())
  companyId         String
  saleConsumptionId String
  saleConsumption   SaleConsumption @relation(fields: [saleConsumptionId], references: [id], onDelete: Restrict)
  qty               Int
  reason            String
  valuePaise        BigInt
  idempotencyKey    String
  createdById       String
  createdAt         DateTime        @default(now())

  @@unique([saleConsumptionId, idempotencyKey])
}

// A count sheet. The variance is frozen when it is SUBMITTED (counted minus
// the ledger at that moment) and posted only when someone else APPROVES it,
// so sales made between the two can never be counted as a variance.
model StockCount {
  id            String            @id @default(cuid())
  companyId     String
  number        String
  locationId    String
  location      InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status        StockCountStatus  @default(DRAFT)
  note          String?
  createdById   String
  createdAt     DateTime          @default(now())
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  rejectReason  String?
  updatedAt     DateTime          @updatedAt

  lines StockCountLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model StockCountLine {
  id               String           @id @default(cuid())
  countId          String
  count            StockCount       @relation(fields: [countId], references: [id], onDelete: Restrict)
  itemId           String
  item             InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  enteredQty       Decimal?         @db.Decimal(18, 3)
  enteredUnit      String?
  countedQty       Decimal?         @db.Decimal(18, 3)
  systemQty        Decimal?         @db.Decimal(18, 3)
  varianceQty      Decimal?         @db.Decimal(18, 3)
  // Paise per base unit, entered by the counter for a surplus at a location
  // that has never held this item with a value (the opening count).
  unitCostPaise    Decimal?         @db.Decimal(20, 6)
  postedValuePaise BigInt?
  costStatus       StockCostStatus?

  @@unique([countId, itemId])
}

model StockWastage {
  id              String            @id @default(cuid())
  companyId       String
  number          String
  locationId      String
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reason          WastageReason
  note            String?
  totalValuePaise BigInt
  idempotencyKey  String
  createdById     String
  createdAt       DateTime          @default(now())

  lines StockWastageLine[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model StockWastageLine {
  id          String          @id @default(cuid())
  wastageId   String
  wastage     StockWastage    @relation(fields: [wastageId], references: [id], onDelete: Restrict)
  itemId      String
  item        InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  enteredQty  Decimal         @db.Decimal(18, 3)
  enteredUnit String
  qtyBase     Decimal         @db.Decimal(18, 3)
  batchId     String?
  valuePaise  BigInt
  costStatus  StockCostStatus
}

// Indent → dispatch → receipt. Between dispatch and receipt the goods are in
// transit: gone from the source, not yet at the destination, and valued at
// what they left the source at.
model StockTransfer {
  id             String              @id @default(cuid())
  companyId      String
  number         String
  fromLocationId String
  fromLocation   InventoryLocation   @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String
  toLocation     InventoryLocation   @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  status         StockTransferStatus @default(REQUESTED)
  note           String?
  // The store request this dispatch serves, when there is one. A request may
  // be served by several transfers (partial dispatch); a transfer may exist
  // with no request at all (a warehouse pushing stock out). Keeping the link
  // optional and one-way is what lets request quantities and transfer
  // quantities be reconciled against each other instead of assumed equal.
  storeRequestId String?
  storeRequest   StoreRequest?       @relation(fields: [storeRequestId], references: [id], onDelete: Restrict)
  requestedById  String
  requestedAt    DateTime            @default(now())
  dispatchedById String?
  dispatchedAt   DateTime?
  receivedById   String?
  receivedAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  updatedAt      DateTime            @updatedAt
  // Deterministic per dispatch attempt, so a retried dispatch cannot send the
  // goods twice.
  idempotencyKey String?

  lines StockTransferLine[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([storeRequestId])
}

model StockTransferLine {
  id                 String        @id @default(cuid())
  transferId         String
  transfer           StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  itemId             String
  item               InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // The request line this serves, so "asked 10, sent 6, arrived 5" is three
  // separately stored numbers rather than one that keeps being overwritten.
  storeRequestLineId String?
  storeRequestLine   StoreRequestLine? @relation(fields: [storeRequestLineId], references: [id], onDelete: Restrict)
  requestedQty       Decimal       @db.Decimal(18, 3)
  dispatchedQty      Decimal?      @db.Decimal(18, 3)
  dispatchValuePaise BigInt?
  // What the destination took into good stock. NOT the same as dispatched:
  // the difference is split below, never rolled into one "variance".
  acceptedQty        Decimal?      @db.Decimal(18, 3)
  acceptedValuePaise BigInt?
  // Arrived, but broken or spoiled. Physically present, so it is received and
  // then written off at the destination — it does not vanish from the ledger.
  damagedQty         Decimal?      @db.Decimal(18, 3)
  damagedValuePaise  BigInt?
  // Dispatched and never arrived. Written off at the SOURCE's value, because
  // it never reached the destination to be worth anything there.
  shortageQty        Decimal?      @db.Decimal(18, 3)
  shortageValuePaise BigInt?

  batches StockTransferLineBatch[]

  @@index([storeRequestLineId])
}

// Which batches a transfer line carried. Without this a batch's identity and
// expiry die at the loading bay: the destination would receive an anonymous
// quantity and traceability would stop at dispatch.
model StockTransferLineBatch {
  id             String            @id @default(cuid())
  transferLineId String
  transferLine   StockTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  batchId        String
  batch          StockBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  dispatchedQty  Decimal           @db.Decimal(18, 3)
  acceptedQty    Decimal?          @db.Decimal(18, 3)
  damagedQty     Decimal?          @db.Decimal(18, 3)
  shortageQty    Decimal?          @db.Decimal(18, 3)

  @@unique([transferLineId, batchId])
  @@index([batchId])
}

// A batch of a semi-finished or finished item made from its recipe. Inputs
// leave as PRODUCTION_OUT, the output arrives as PRODUCTION_IN carrying their
// exact value, so cost flows through a sub-recipe unchanged.
model ProductionBatch {
  id              String            @id @default(cuid())
  companyId       String
  number          String
  locationId      String
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  recipeVersionId String
  recipeVersion   RecipeVersion     @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  outputItemId    String
  outputItem      InventoryItem     @relation(fields: [outputItemId], references: [id], onDelete: Restrict)
  // What came out, and what the run was set up to make. Both are kept because
  // the difference between them is the yield variance, and the ingredients
  // were charged against the second one — so a reader shown only outputQty is
  // shown a cost per unit with no way to see why it is high. It cannot be
  // recovered later either: the inputs were scaled through a rounding
  // division, so inverting them approximates the planned size rather than
  // returning it. Nullable, because runs recorded before the column existed do
  // not know, and NULL says so rather than claiming they went to plan.
  outputQty       Decimal           @db.Decimal(18, 3)
  plannedQty      Decimal?          @db.Decimal(18, 3)
  inputValuePaise BigInt
  batchId         String?
  note            String?
  idempotencyKey  String
  createdById     String
  createdAt       DateTime          @default(now())

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
}

// A valuation frozen at a moment. Recomputing it later from the ledger must
// give the same numbers — that is what makes a period-end stock figure
// evidence rather than a claim. GET .../verify does the recomputation.
model StockValuationSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  locationId      String?
  asOf            DateTime
  totalValuePaise BigInt
  lineCount       Int
  // sha256 over the sorted lines, so a verify can say "identical" in one line.
  digest          String
  takenById       String
  takenAt         DateTime @default(now())

  lines StockValuationSnapshotLine[]

  @@index([companyId, asOf])
}

model StockValuationSnapshotLine {
  id         String                 @id @default(cuid())
  snapshotId String
  snapshot   StockValuationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  locationId String
  itemId     String
  qty        Decimal                @db.Decimal(18, 3)
  valuePaise BigInt

  @@index([snapshotId])
}
// ---- store replenishment: reservations, requests, plans, reminders ---------
//
// The ledger above answers "what is physically here". This section answers the
// three questions a multi-store operation actually asks: what of it is spoken
// for, what has been asked for and not yet delivered, and who has to do
// something about it before it is too late.
//
// Six quantities are kept apart on purpose, because collapsing any two of them
// is how stock gets sold twice:
//   physical    Σ ledger at the location. What a person would find on a shelf.
//   blocked     physical held in an expired, quarantined or recalled batch.
//   usable      physical − blocked.
//   reserved    usable committed to an approved request, not yet dispatched.
//   available   usable − reserved. The only figure an allocation may spend.
//   in transit  dispatched and not yet settled at the destination. Belongs to
//               neither location's physical figure and is derived from open
//               transfers, never stored as a balance.

enum StockReservationState {
  HELD
  CONSUMED
  RELEASED
}

enum StoreRequestStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  IN_FULFILMENT
  FULFILLED
  // Fulfilled short and explicitly signed off. A request NEVER reaches a
  // terminal state with an outstanding quantity that nobody has decided about.
  CLOSED_SHORT
  CANCELLED
}

enum StoreRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StoreRequestIssueKind {
  SHORTAGE
  DAMAGE
}

enum StoreRequestIssueResolution {
  REPLACED
  CREDITED
  WRITTEN_OFF
  CANCELLED
}

enum ReplenishmentPlanStatus {
  ACTIVE
  PAUSED
}

enum InventoryReminderKind {
  SUBMISSION_CUTOFF
  PENDING_APPROVAL
  DISPATCH_DUE
  DELIVERY_OVERDUE
  RECEIPT_PENDING
  UNRESOLVED_SHORTAGE
  BATCH_EXPIRING
  OPENED_CONTAINER_EXPIRING
}

enum InventoryReminderState {
  PENDING
  NOTIFIED
  ESCALATED
  ACKNOWLEDGED
  // The thing it was about happened. Obsolete reminders are never notified
  // again and are kept, not deleted, so "why did nobody chase this" has an
  // answer.
  OBSOLETE
}

enum InventoryNotificationState {
  QUEUED
  DELIVERED
  FAILED
  // FAILED means "did not arrive, and we will try again". UNDELIVERABLE means
  // "did not arrive, and trying again cannot help" — the address does not
  // exist, the recipient has opted out. They are kept apart because the
  // scheduler must stop on one and not on the other, and because a portal
  // that says "still trying" about a message that will never arrive is worse
  // than one that admits it gave up.
  UNDELIVERABLE
  READ
}

// Usable stock committed to something that has not taken it yet. Held against
// a location+item, and against specific batches on the lines so an allocation
// made under FEFO still ships the batch it promised.
model StockReservation {
  id         String                @id @default(cuid())
  companyId  String
  locationId String
  location   InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId     String
  item       InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qty        Decimal               @db.Decimal(18, 3)
  state      StockReservationState @default(HELD)
  // 'STORE_REQUEST_LINE' today; the column exists so a future caller does not
  // have to widen the model.
  sourceType String
  sourceId   String
  // One reservation per source, enforced. A double-clicked approval finds the
  // row and reserves nothing further.
  idempotencyKey String            @unique
  heldById   String?
  heldAt     DateTime              @default(now())
  settledAt  DateTime?
  note       String?

  lines StockReservationLine[]

  @@index([companyId, state])
  @@index([locationId, itemId, state])
  @@index([sourceType, sourceId])
}

model StockReservationLine {
  id            String           @id @default(cuid())
  reservationId String
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  batchId       String
  batch         StockBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  qty           Decimal          @db.Decimal(18, 3)

  @@unique([reservationId, batchId])
  @@index([batchId])
}

// A store asking a warehouse for goods. Deliberately NOT the same entity as
// the transfer that answers it: one request can be served by several partial
// dispatches, and the quantity asked for has to stay readable after the
// quantity sent has changed three times.
model StoreRequest {
  id              String               @id @default(cuid())
  companyId       String
  number          String
  // Where the goods are going — a store's stock location.
  destinationLocationId String
  destinationLocation   InventoryLocation @relation("RequestDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  // Where they are being asked from. Null on a request raised before anyone
  // decided which warehouse serves it.
  sourceLocationId String?
  sourceLocation   InventoryLocation? @relation("RequestSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  status          StoreRequestStatus   @default(DRAFT)
  priority        StoreRequestPriority @default(NORMAL)
  // Store-local wall time the goods are needed by, stored as an instant. The
  // plan that generated it carries the timezone that produced this instant.
  requiredBy      DateTime
  reason          String?
  note            String?
  // Who must decide. Null means "anyone with the approval right at the source".
  assignedApproverId String?
  raisedById      String
  raisedAt        DateTime             @default(now())
  submittedAt     DateTime?
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  closedById      String?
  closedAt        DateTime?
  closeReason     String?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelReason    String?
  // Set when a replenishment plan raised this rather than a person.
  originPlanId    String?
  originPlan      ReplenishmentPlan?   @relation(fields: [originPlanId], references: [id], onDelete: Restrict)
  originRunId     String?
  originRun       ReplenishmentRun?    @relation(fields: [originRunId], references: [id], onDelete: Restrict)
  // Identifies the requirement this request covers — plan, destination and
  // delivery cycle. Unique per company, which is what stops a scheduler retry,
  // a restarted process and an impatient manager from raising the same
  // Tuesday order three times.
  requirementKey  String?
  idempotencyKey  String?
  updatedAt       DateTime             @updatedAt

  lines       StoreRequestLine[]
  attachments StoreRequestAttachment[]
  issues      StoreRequestIssue[]
  events      StoreRequestEvent[]
  transfers   StockTransfer[]
  reminders   InventoryReminder[]

  @@unique([companyId, number])
  @@unique([companyId, requirementKey])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([destinationLocationId, status])
  @@index([sourceLocationId, status])
  @@index([companyId, requiredBy])
}

// Every quantity on this line is stored separately and none is derived from
// another by subtraction at read time. "Asked 10, approved 8, reserved 8,
// sent 6, took 5, one broken, one never arrived" is seven facts, and a report
// that recomputes any of them from the others will disagree with the ledger
// the first time a partial dispatch is followed by a partial receipt.
model StoreRequestLine {
  id           String       @id @default(cuid())
  requestId    String
  request      StoreRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // What the store typed and in which unit, kept verbatim beside the base
  // quantity it converted to. The factor used is frozen on the line, so
  // re-reading this request in a year does not re-run today's conversion.
  enteredQty   Decimal      @db.Decimal(18, 3)
  enteredUnit  String
  enteredFactorMilli Int
  requestedQty Decimal      @db.Decimal(18, 3)
  approvedQty  Decimal?     @db.Decimal(18, 3)
  allocatedQty Decimal      @default(0) @db.Decimal(18, 3)
  dispatchedQty Decimal     @default(0) @db.Decimal(18, 3)
  acceptedQty  Decimal      @default(0) @db.Decimal(18, 3)
  damagedQty   Decimal      @default(0) @db.Decimal(18, 3)
  shortageQty  Decimal      @default(0) @db.Decimal(18, 3)
  // approved − accepted, minus anything explicitly written off. The request
  // cannot be closed while this is non-zero unless someone says so in writing.
  outstandingQty Decimal    @default(0) @db.Decimal(18, 3)
  rejectedReason String?
  note         String?

  transferLines StockTransferLine[]
  issues        StoreRequestIssue[]

  @@unique([requestId, itemId])
  @@index([itemId])
}

// Metadata only. The binary lives wherever the URL points; this product has no
// file store of its own yet, so nothing here pretends to hold one.
model StoreRequestAttachment {
  id           String       @id @default(cuid())
  requestId    String
  request      StoreRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String?
  byteSize     Int?
  url          String
  uploadedById String?
  uploadedAt   DateTime     @default(now())

  @@index([requestId])
}

// A shortage or a damage that somebody still has to decide about. Created when
// a receipt records one and closed only by an explicit resolution — which is
// what "explicitly resolved" means in practice.
model StoreRequestIssue {
  id           String                @id @default(cuid())
  companyId    String
  requestId    String
  request      StoreRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestLineId String
  requestLine  StoreRequestLine      @relation(fields: [requestLineId], references: [id], onDelete: Cascade)
  kind         StoreRequestIssueKind
  qty          Decimal               @db.Decimal(18, 3)
  valuePaise   BigInt
  note         String?
  raisedAt     DateTime              @default(now())
  raisedById   String?
  resolution   StoreRequestIssueResolution?
  resolutionNote String?
  resolvedById String?
  resolvedAt   DateTime?
  // The replacement request raised to cover it, when the resolution was
  // REPLACED.
  replacementRequestId String?

  reminders InventoryReminder[]

  @@index([companyId, resolvedAt])
  @@index([requestId])
}

// The workflow's own history. The audit log records that a route was called;
// this records what the request looked like on either side of it, which is
// what an operations manager actually asks for.
model StoreRequestEvent {
  id        String       @id @default(cuid())
  requestId String
  request   StoreRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String
  fromStatus StoreRequestStatus?
  toStatus   StoreRequestStatus?
  actorId   String?
  actorRole String?
  detail    Json?
  createdAt DateTime     @default(now())

  @@index([requestId, createdAt])
}

// A standing arrangement: this store is served from that warehouse, on these
// days, ordering by this time, for delivery by that time.
model ReplenishmentPlan {
  id             String                  @id @default(cuid())
  companyId      String
  name           String
  destinationLocationId String
  destinationLocation   InventoryLocation @relation("PlanDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  sourceLocationId String
  sourceLocation   InventoryLocation     @relation("PlanSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  status         ReplenishmentPlanStatus @default(ACTIVE)
  // IANA name, e.g. Asia/Kolkata. The store's clock, not the server's: a
  // cutoff of 18:00 means six in the evening where the store is, and a server
  // in another zone must not move it.
  timezone       String                  @default("Asia/Kolkata")
  // ISO weekday numbers, 1 = Monday. Deliveries happen only on these days.
  deliveryDays   Int[]
  // Local time of day, minutes past midnight in the plan's timezone.
  cutoffMinute   Int
  requiredByMinute Int
  leadTimeDays   Int                     @default(1)
  // Cover this many days of expected consumption when suggesting quantities.
  coverDays      Int                     @default(7)
  // Auto-submit a generated request, or leave it in DRAFT for a person. False
  // by default: a plan that files its own orders without anyone looking is how
  // a mis-set target quantity becomes a truckload.
  autoSubmit     Boolean                 @default(false)
  status_note    String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  lines    ReplenishmentPlanLine[]
  runs     ReplenishmentRun[]
  requests StoreRequest[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([status, nextRunAt])
}

model ReplenishmentPlanLine {
  id        String            @id @default(cuid())
  planId    String
  plan      ReplenishmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Base units. A store with no consumption history is driven by these two
  // alone — the suggestion engine never invents a rate it has not measured.
  minQty    Decimal           @db.Decimal(18, 3)
  targetQty Decimal           @db.Decimal(18, 3)
  safetyQty Decimal           @default(0) @db.Decimal(18, 3)
  // Skip this item without deleting the line and losing its numbers.
  active    Boolean           @default(true)

  @@unique([planId, itemId])
  @@index([itemId])
}

// One firing of a plan. Persisted before any request is raised, so a process
// that dies halfway through resumes instead of starting again.
model ReplenishmentRun {
  id        String            @id @default(cuid())
  companyId String
  planId    String
  plan      ReplenishmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // The delivery cycle this run covers, as a local date in the plan's
  // timezone. Unique per plan: a restarted scheduler recognises the cycle it
  // already handled instead of raising the order a second time.
  cycleDate DateTime          @db.Date
  startedAt DateTime          @default(now())
  finishedAt DateTime?
  // COMPLETED | FAILED | SKIPPED_NOTHING_NEEDED | SKIPPED_ALREADY_COVERED
  outcome   String?
  detail    Json?
  attempts  Int               @default(1)
  lastError String?

  requests StoreRequest[]

  @@unique([planId, cycleDate])
  @@index([companyId, startedAt])
}

// Something that has to happen by a time, and who has to do it. Reminders are
// derived state: the scheduler recreates the set on every tick and marks the
// ones whose subject has moved on as OBSOLETE, so a status change silently
// stops the chasing without anyone having to remember to cancel it.
model InventoryReminder {
  id         String                 @id @default(cuid())
  companyId  String
  kind       InventoryReminderKind
  // Stable per (kind, subject, due window). The unique index is what makes
  // "recreate on every tick" safe to run every minute for a year.
  dedupeKey  String
  subjectType String
  subjectId  String
  storeRequestId String?
  storeRequest   StoreRequest?      @relation(fields: [storeRequestId], references: [id], onDelete: Cascade)
  issueId    String?
  issue      StoreRequestIssue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  locationId String?
  dueAt      DateTime
  state      InventoryReminderState @default(PENDING)
  assigneeId String?
  // 0 = the assignee. Each step up notifies one rung higher and is recorded,
  // so "nobody told me" is answerable.
  escalationLevel Int               @default(0)
  escalateAt DateTime?
  title      String
  body       String
  firstSeenAt DateTime              @default(now())
  lastNotifiedAt DateTime?
  acknowledgedById String?
  acknowledgedAt DateTime?
  obsoletedAt DateTime?
  obsoleteReason String?
  updatedAt  DateTime               @updatedAt

  notifications InventoryNotification[]

  @@unique([companyId, dedupeKey])
  @@index([companyId, state, dueAt])
  @@index([assigneeId, state])
  @@index([state, escalateAt])
}

// A message to a person. Delivery is a recorded fact with its own state,
// because a reminder nobody received must not look like one that was ignored.
//
// The seam an external transport attaches to is src/lib/inventory/
// notifyTransport.js. No email or WhatsApp adapter is written: the transports
// that exist are in-app, where the row is itself the message, and a test one
// that never leaves the process. Nothing this product does today sends
// anything to anybody outside it.
model InventoryNotification {
  id         String                     @id @default(cuid())
  companyId  String
  reminderId String?
  reminder   InventoryReminder?         @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recipientId String
  channel    String                     @default("INAPP")
  title      String
  body       String
  state      InventoryNotificationState @default(QUEUED)
  attempts   Int                        @default(0)
  lastError  String?
  // The transport's own id for the message. It is what lets "we delivered it"
  // be checked against the provider later instead of only asserted from this
  // row — the same job the charge reference does on a payment. Null for
  // in-app, where the row is the message and there is no provider to ask.
  providerRef String?
  deliveredAt DateTime?
  readAt     DateTime?
  createdAt  DateTime                   @default(now())

  @@index([recipientId, state, createdAt])
  @@index([companyId, state])
}

// Which inventory locations a user may act on, and how.
//
// PosUser.branchId cannot express this. A warehouse usually belongs to no
// branch at all, so a branch-pinned manager can never reach one through the
// branch scope — yet "warehouse operators see their assigned warehouses" is a
// requirement. This grant is the missing edge, and it is additive: it can only
// widen a principal within its own company, never across companies, and the
// routes still apply the role check first.
//
// INTEGRATION(foundation): when the permission foundation lands, this becomes
// the scope half of its action/scope model. The action half already lives in
// src/lib/inventory/permissions.js as one exported map.
model InventoryLocationAccess {
  id         String            @id @default(cuid())
  companyId  String
  userId     String
  user       PosUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // Read is implied by the row existing. These three are the actions that
  // move or commit stock, and each is granted separately because the person
  // who loads a van is rarely the person who approves what goes in it.
  canDispatch Boolean          @default(false)
  canReceive  Boolean          @default(false)
  canApprove  Boolean          @default(false)
  grantedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, locationId])
  @@index([companyId])
  @@index([locationId])
}

// One row per named background job. Holds the lease that keeps two processes
// from ticking the same job at once, and the cursor that lets a restarted
// process pick up where the last one stopped rather than replaying from zero.
model InventorySchedulerState {
  name        String    @id
  lastTickAt  DateTime?
  lastOkAt    DateTime?
  cursorAt    DateTime?
  lockedBy    String?
  lockedUntil DateTime?
  runCount    Int       @default(0)
  failCount   Int       @default(0)
  lastError   String?
  updatedAt   DateTime  @updatedAt
}

// ==== END LANE inventory ====

// ===========================================================================
// LANE foundation — Expansion Phase 1: organisation, identity, terminals,
// devices and the permission/scope layer. Spec Part A §7, Part B §3/§5/§11.
//
// The shape is Tenant (Company) → Legal Entity → GST Registration → Store
// (Branch) → Terminal → Device. Brand, Region and Inventory Location are
// deliberately NOT levels of that chain — they are separate dimensions a store
// is tagged with, because a single outlet can trade two brands and an inventory
// location does not own a bill. InventoryLocation belongs to the inventory
// lane and is not created here.
//
// Nothing below renames an existing table or column. `Branch` stays `Branch`
// in the database however the screens spell it.
// ===========================================================================

// The registered business that actually sells. One tenant can hold several —
// a group running two companies under one VEXO login is the ordinary case, not
// the exotic one.
model LegalEntity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Exactly as it appears on the certificate of incorporation, because this is
  // the string a tax invoice has to carry. The brand customers recognise lives
  // in `Brand`, and the two are usually different.
  legalName String
  tradeName String?
  // PAN and CIN are the entity's identity, not the tenant's. Nullable because a
  // tenant may configure stores before Finance hands over the paperwork, and
  // refusing to save a legal entity until then would just push the data into a
  // spreadsheet. The uniqueness is per tenant: two tenants legitimately holding
  // the same PAN (an agency setting up a client) must not be able to discover
  // each other through a 409.
  pan       String?
  cin       String?
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gstRegistrations GstRegistration[]
  branches         Branch[]

  @@unique([companyId, legalName])
  @@unique([companyId, pan])
  // Redundant on its own — `id` is already the key. It exists so children can
  // point at (id, companyId) instead of (id), which is what makes "this row
  // belongs to that tenant" a foreign key rather than a hope. See the tenancy
  // note on Branch.
  @@unique([id, companyId])
  @@index([companyId])
}

// One GSTIN. A legal entity registered in four states has four of these, and a
// store maps to exactly one — that mapping is what decides the GSTIN, the
// place of supply and the invoice series a bill is issued under.
model GstRegistration {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  legalEntityId String
  // Composite: the entity must be one of THIS tenant's. A single-column
  // reference would happily accept another customer's legal entity id.
  legalEntity   LegalEntity @relation(fields: [legalEntityId, companyId], references: [id, companyId], onDelete: Restrict)
  gstin         String
  // The trade name on THIS registration. It can differ from the entity's, which
  // is why it is not read off LegalEntity.
  tradeName     String?
  // First two digits of the GSTIN. Stored rather than derived so the invoice
  // snapshot is self-contained, and constrained in SQL so it can never
  // disagree with the GSTIN it came from.
  stateCode     String
  stateName     String
  addressLine   String?
  city          String?
  pincode       String?
  status        CatalogStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branches Branch[]

  // Per tenant, not global. A globally unique GSTIN would answer "does another
  // VEXO customer already use this number?" to anyone who can type one in.
  @@unique([companyId, gstin])
  // Lets Branch reference a registration by (id, legalEntityId, companyId), so
  // a store's GSTIN is forced to belong both to the store's tenant AND to the
  // store's own legal entity. Without the middle column a branch could name
  // entity A and a GSTIN registered to entity B, and the invoice would assert
  // a pairing that does not exist.
  @@unique([id, legalEntityId, companyId])
  @@index([companyId])
  @@index([legalEntityId])
}

// Monotonic counters for ids that are public and permanent. Same idiom as
// InvoiceCounter: one row, incremented inside the caller's transaction, so two
// stores created at the same instant cannot be handed the same number.
model PlatformCounter {
  key        String @id
  lastNumber Int    @default(0)
}

// A customer-facing brand. A food court unit selling under two names is one
// store with two brands, not two stores — which is why this is a separate
// dimension and not a level above Branch.
model Brand {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  storeLinks BranchBrand[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId])
}

// Store ↔ brand. `companyId` is carried on the link row itself so BOTH sides
// can be tied to the same tenant by foreign key: without it the two ids are
// independently valid and nothing stops one tenant's store being linked to
// another tenant's brand.
model BranchBrand {
  branchId  String
  companyId String
  branch    Branch   @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  brandId   String
  brand     Brand    @relation(fields: [brandId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([branchId, brandId])
  @@index([brandId])
  @@index([companyId])
}

// A region or cluster of stores. `parentId` lets a tenant nest cluster inside
// region without a second table; it is not a reporting hierarchy and carries no
// permissions of its own — a REGIONAL_MANAGER's reach comes from the stores
// that point here.
model Region {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  parentId  String?
  // Composite, so a cluster can only nest inside a region of the same tenant.
  parent    Region?       @relation("RegionTree", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  children Region[]  @relation("RegionTree")
  branches Branch[]
  users    PosUser[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([parentId])
}

enum TerminalStatus {
  ACTIVE
  DISABLED
}

// A logical till: "Counter 1", "Drive-through". Bound to one store for its
// whole life — a terminal that could move between stores would make the day's
// cash belong to two places at once.
model Terminal {
  id        String @id @default(cuid())
  // Denormalised from the branch on purpose, and written by the server from the
  // branch it resolved — never from the request. Device authentication has to
  // establish the tenant on every single call, and it must not need a join to
  // do it.
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String
  // Composite: the denormalised companyId above is only trustworthy if the
  // database checks it against the branch. This is that check.
  branch    Branch  @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  code      String
  name      String
  status    TerminalStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  devices  Device[]
  orders   Order[]
  payments Payment[]
  stockMovements StockMovement[]

  @@unique([branchId, code])
  // So a device, an order or a payment can name (terminalId, branchId) and
  // have the pairing enforced — a till from another store can never be
  // attributed to this store's takings.
  @@unique([id, branchId])
  // The same guarantee one level up, for rows that carry companyId but not
  // branchId. A stock movement's store is its location's, and a location may
  // have none at all — a central kitchen or a warehouse belongs to the company
  // and to no store — so (id, branchId) is not a pairing the ledger can name.
  // (id, companyId) is, and it is the one that matters there: the ledger's
  // tenant boundary.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([branchId])
}

enum DeviceType {
  COUNTER
  KDS
  CUSTOMER_DISPLAY
  HANDHELD
  OTHER
}

// PENDING = enrolled, no credential issued yet. ACTIVE = holds a live token.
// REVOKED = terminal state; the row stays for the audit trail and for the
// orders that point at it, but its token is gone.
enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ==== LANE kitchen ====
// VC-103 kitchen orchestration (stations, routing, per-line preparation state)
// and the Store Agent print queue. Everything here hangs off the EXISTING Kot
// and OrderItem rows: a kitchen ticket IS a KOT id, and a kitchen line IS an
// order line. Nothing in this block holds money, and nothing in it is read by
// billing, payment or reporting code.
//
// Foreign keys into Core cascade (OrderItem, Kot, Branch) because these rows
// are derived operational state, not records of their own: Core never hard-
// deletes a line that has been sent to the kitchen (it voids it), so the
// cascade only ever fires in a test wipe — where it keeps every other suite's
// delete order valid without that suite having to know these tables exist.

enum KitchenItemState {
  QUEUED
  IN_PREP
  READY
  SERVED
  CANCELLED
}

// A preparation station in one store — "Hot kitchen", "Barista bar". Status
// reuses Core's ACTIVE/ARCHIVED: a station with history is archived, never
// deleted, so yesterday's prep times keep the station they were measured at.
model KitchenStation {
  id                String        @id @default(cuid())
  companyId         String
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name              String
  // What "late" means at this station. Snapshotted onto each line when it is
  // routed, so editing the target tonight does not rewrite last week's
  // late-ticket figures.
  targetPrepSeconds Int           @default(600)
  // The station every unrouted line falls back to. Written as the branch id on
  // the one default station and NULL on every other, so a plain unique index
  // enforces "at most one default per store" — Postgres treats NULLs as
  // distinct, which is exactly the rest of the stations.
  defaultForBranch  String?       @unique
  sortOrder         Int           @default(0)
  status            CatalogStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  routes       KitchenRoute[]
  items        KitchenItem[]
  printTargets PrintTarget[]

  @@unique([branchId, name])
  @@index([companyId, branchId])
}

// Routing rule: this product, or anything in this category, goes to this
// station. A product rule beats a category rule; neither beats nothing — a
// line with no rule goes to the store's default station.
//
// productId/categoryId are deliberately NOT foreign keys: the catalog is
// company-wide and editable, and a rule naming a category that was later
// deleted is harmless (it never matches) where a foreign key would have made
// the catalog screen refuse the delete for a reason it cannot explain.
model KitchenRoute {
  id          String         @id @default(cuid())
  companyId   String
  branchId    String
  stationId   String
  station     KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  // "product:<id>" | "category:<id>" — one rule per subject per store.
  matchKey    String
  productId   String?
  categoryId  String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([branchId, matchKey])
  @@index([stationId])
}

// One order line's journey through the kitchen. Created in the same
// transaction that sends the KOT, one row per line, unique on the line — so a
// replayed routing step can never make a second ticket line.
model KitchenItem {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String
  orderId       String
  kotId         String
  kot           Kot              @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId   String           @unique
  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stationId     String
  station       KitchenStation   @relation(fields: [stationId], references: [id])
  state         KitchenItemState @default(QUEUED)
  // Optimistic lock. Every transition names the version it was decided on;
  // a stale or replayed bump matches no row and changes nothing.
  version       Int              @default(1)
  // The store's kitchen cursor at this row's last change. Clients poll for
  // "everything after N", which is how a reconnect resumes without refetching
  // — or duplicating — the board.
  changeSeq     Int
  targetSeconds Int
  queuedAt      DateTime
  startedAt     DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  cancelledAt   DateTime?
  // A station telling the pass "this one is held up, and why".
  delayReason   String?
  delayedAt     DateTime?
  lastActorId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([branchId, changeSeq])
  @@index([branchId, state])
  @@index([stationId, state])
  @@index([orderId])
  @@index([kotId])
}

// Per-store change counter, incremented under its own row lock inside every
// kitchen write — the InvoiceCounter pattern. Holding the lock until commit is
// what makes the numbers commit in order, so a reader that has seen N has seen
// everything up to N. A plain sequence would not: 11 can commit before 10.
model KitchenCursor {
  branchId  String   @id
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PrintAgentStatus {
  PENDING // created, one-time enrolment code issued, never enrolled
  ACTIVE
  REVOKED
}

// A physical or browser device. Its credential is scoped to exactly one store
// and at most one terminal, and that scope is checked server-side on every
// request — a token that leaks is a token for one counter, not for a tenant.
model Device {
  id String @id @default(cuid())
  // Quoted in support tickets and printed on the device's own settings screen.
  // Minted once, never editable.
  publicId String @unique
  // See Terminal.companyId — same reason, same rule: server-written.
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  branchId    String
  branch      Branch    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  terminalId  String?
  // (terminalId, branchId), not terminalId alone: a device's credential is
  // scoped to one store, and pointing it at a till in a different store would
  // make that scope a fiction.
  terminal    Terminal? @relation(fields: [terminalId, branchId], references: [id, branchId], onDelete: Restrict)
  name        String
  type        DeviceType   @default(COUNTER)
  status      DeviceStatus @default(PENDING)
  // Only the hash. The token itself is shown once, at activation, and is not
  // recoverable afterwards — the same contract as a staff temporary password.
  // Revoking clears this column, because status alone would leave a working
  // credential in the wild.
  tokenHash   String?   @unique
  lastSeenAt  DateTime?
  lastSeenIp  String?
  activatedAt DateTime?
  revokedAt   DateTime?
  revokedById String?
  revokedBy   PosUser?  @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  enrolledById String?
  enrolledBy   PosUser? @relation("DeviceEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders   Order[]
  payments Payment[]

  @@unique([id, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([terminalId])
  @@index([status])
}

enum PermissionLevel {
  COMPANY
  BRANCH
  USER
}

enum PermissionEffect {
  ALLOW
  DENY
}

// Narrowing rules over the role baseline in src/lib/permissions.js. Resolved
// most-specific-first the way DiscountPolicy already resolves — USER over
// BRANCH over COMPANY — and deliberately incapable of widening: an ALLOW can
// only switch something back on that a broader DENY switched off, never grant
// an action the role never had. That is what makes "a cashier cannot grant
// themselves more permission" a property of the data model instead of a check
// somebody has to remember to write.
//
// One exception to most-specific-wins, and it is the important one: a
// COMPANY-level DENY is a HARD prohibition, not an inherited default. It is the
// tenant saying "not in this business, by anyone", so a narrower ALLOW does not
// lift it — resolveRules reapplies it last, over the narrower winner. The rules
// route refuses to store such an ALLOW in the first place, so nobody is left
// looking at a rule that says ALLOW while the server says no.
model PermissionRule {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  level     PermissionLevel
  branchId  String?
  branch    Branch?         @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  userId    String?
  user      PosUser?        @relation("PermissionRuleSubject", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  // Same trick as DiscountPolicy.scopeKey: Postgres counts NULLs as distinct,
  // so a nullable (branchId, userId) pair cannot stop a hundred duplicate
  // "company default" rows. "company" | "branch:<id>" | "user:<id>".
  scopeKey  String
  action    String
  effect    PermissionEffect
  note        String?
  updatedById String?
  updatedBy   PosUser? @relation("PermissionRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, scopeKey, action])
  @@index([companyId, level])
  @@index([branchId])
  @@index([userId])
}

// Which stores a user may act in. THE AUTHORITATIVE RULE, stated once here and
// implemented once in lib/permissions.js `storeScopeFor`:
//
//   Assignment rows REPLACE the store scope the role implies. They do not only
//   narrow it. A BRANCH_MANAGER covering two outlets gets two rows and reaches
//   both — for a store-pinned role that is a widening, and it is intended;
//   "manager of the airport and the mall" is an ordinary job. A user with no
//   rows falls back to PosUser.branchId, which is how every existing account
//   already works and is why this table could be added without a backfill.
//
// An earlier comment here said this table "only ever narrows, never widens".
// That was wrong about the code and is corrected rather than reconciled: the
// resolver has always read the rows as the scope. What never widens is the set
// of ACTIONS — scope answers "where", never "what", so no number of assignment
// rows turns a cashier into someone who can issue a refund.
//
// Widening is safe because of who may write these rows, not because of what
// they say. The route requires `user.write`, refuses any store outside the
// caller's OWN scope, and refuses a row naming the caller — so nobody can
// assign themselves anywhere, and an admin cannot hand out reach they do not
// themselves hold.
model UserStoreAssignment {
  id          String   @id @default(cuid())
  userId      String
  // companyId carried on the row so both sides are tied to one tenant by
  // foreign key: without it, a row could name this tenant's user and another
  // tenant's store, and the scope it produced would cross the boundary the
  // rest of the system is built on.
  companyId   String
  user        PosUser  @relation("StoreAssignmentUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId    String
  branch      Branch   @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   PosUser? @relation("StoreAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([companyId])
}

// Platform support reaching into a tenant. Explicit, time-boxed and granted by
// that tenant's own owner — a POS_SUPER_ADMIN is cross-tenant by construction,
// so without this table "ATC looked at my data" has no record and no consent.
// Every grant, use and revocation is audited.
model SupportAccessGrant {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // The platform operator the grant is for. Named, never a blanket grant to the
  // role: "ATC can see it" is not consent, "this person until Friday" is.
  //
  // Single-column on purpose, and the one place in this file that stays that
  // way. The subject of a grant is by definition NOT a member of this company —
  // an operator's companyId is NULL — so there is no (id, companyId) pair to
  // match. requireTenantPrincipal on the grant routes is what checks the
  // operator is an operator; a composite key here would simply be unsatisfiable.
  userId    String
  user      PosUser @relation("SupportGrantOperator", fields: [userId], references: [id], onDelete: Restrict)
  reason      String
  grantedById String
  grantedBy   PosUser  @relation("SupportGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt   DateTime @default(now())
  // Required. A grant with no end is standing access wearing a consent label.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  @@index([companyId, expiresAt])
  @@index([userId, expiresAt])
}

// ---------------------------------------------------------------------------
// LANE foundation, Phase 2 — VC-102 promotion engine.
//
// A promotion is the OWNER's discount: published company-wide or to named
// stores, applied at the till by anyone holding promo.apply, and recorded on
// the order as a PromotionRedemption row that snapshots the rule version and
// the computed amount. The redemption row, not the promotion, is what the
// bill retains — tomorrow's edit to the promotion must never restate what
// yesterday's invoice granted.
//
// Money stays in the one engine: a promotion's benefit is folded into
// Order.discountAmount by recomputeOrder, distributed across lines and taxed
// exactly like a manual discount. There is no second calculation path.
// ---------------------------------------------------------------------------

enum PromotionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum PromotionRuleKind {
  INCLUDE_CATEGORY
  EXCLUDE_CATEGORY
  INCLUDE_PRODUCT
  EXCLUDE_PRODUCT
}

// APPLIED holds a campaign slot; REVERSED has given it back. Rows are never
// deleted — a reversed redemption is the record of a benefit that was granted
// and then withdrawn, with the reason.
enum PromotionRedemptionStatus {
  APPLIED
  REVERSED
}

model Promotion {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  name      String
  // The code a till types in. Null = applied by picking from the list.
  code      String?
  status    PromotionStatus @default(DRAFT)
  // Bumped on every edit of a promotion that has ever been published.
  // Redemptions snapshot it, so "which rules produced this amount" stays
  // answerable after the promotion is edited.
  version   Int             @default(1)

  benefitType DiscountType
  // Exactly one of these is set, matching benefitType — same convention as
  // DiscountPolicy: percent is Decimal(6,3), flat money is integer paise.
  percent     Decimal?     @db.Decimal(6, 3)
  flatPaise   Int?

  // Threshold checked against the whole basket's subtotal (after line
  // discounts); the benefit itself is computed on the ELIGIBLE lines only.
  minSpendPaise   Int?
  maxBenefitPaise Int?

  // Scheduling. Dates are instants; weekday/time-of-day are evaluated in IST,
  // the calendar every other daily boundary in this system already uses.
  startsAt    DateTime?
  endsAt      DateTime?
  // Bitmask, Sunday = bit 0 … Saturday = bit 6. Null = every day.
  weekdayMask Int?
  // Minutes since IST midnight; start inclusive, end exclusive. Null = all
  // day. Windows do not wrap midnight — write two promotions instead.
  startMinute Int?
  endMinute   Int?
  // Null = every channel.
  channel     OrderType?

  // STACKING, stated once: a non-stackable promotion must be the only
  // promotion on the order. Stackable promotions combine; each benefit is
  // computed independently on the undiscounted eligible base, then the
  // combined total (manual + promotions) is clamped to the subtotal, with the
  // HIGHEST precedence number absorbing the clamp first.
  stackable  Boolean @default(false)
  precedence Int     @default(100)

  // Campaign-wide cap. Enforced by a conditional increment inside the apply
  // transaction, so two concurrent redemptions cannot both take the last slot.
  totalLimit      Int?
  redemptionCount Int  @default(0)
  // Per-customer cap. Customers have no account in this phase, so the key is
  // the normalised phone number the till supplies at apply time; a promotion
  // with this set REFUSES an apply that names no customer.
  perCustomerLimit Int?

  createdById String?
  createdBy   PosUser?  @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  itemRules   PromotionItemRule[]
  storeLinks  PromotionStore[]
  redemptions PromotionRedemption[]

  @@unique([companyId, code])
  // Referenced by the child tables so every rule, store link and redemption
  // carries the tenant and has it checked by the database.
  @@unique([id, companyId])
  @@index([companyId, status])
}

// Which lines a promotion touches. No rows = the whole menu. If any INCLUDE
// rows exist the eligible set starts from them; EXCLUDE rows are then removed.
// A product-level rule outranks its category either way.
model PromotionItemRule {
  id          String            @id @default(cuid())
  promotionId String
  companyId   String
  promotion   Promotion         @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  kind        PromotionRuleKind
  // Exactly one of these is set, matching kind. Composite with companyId so a
  // rule cannot name another tenant's menu.
  categoryId  String?
  category    Category?         @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  productId   String?
  product     Product?          @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([promotionId])
  @@index([categoryId])
  @@index([productId])
}

// Store targeting. No rows = every store in the tenant.
model PromotionStore {
  id          String    @id @default(cuid())
  promotionId String
  companyId   String
  promotion   Promotion @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  branchId    String
  branch      Branch    @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([promotionId, branchId])
  @@index([branchId])
}

// One promotion applied to one order. THIS row is what the bill retains:
// promotionVersion and amount are snapshots, never re-derived from the
// promotion. amount is rupees DECIMAL(10,2) like every other stored money
// column; it is rewritten by recomputeOrder while the order is open and
// frozen once the order leaves OPEN.
model PromotionRedemption {
  id               String                    @id @default(cuid())
  companyId        String
  promotionId      String
  promotion        Promotion                 @relation(fields: [promotionId, companyId], references: [id, companyId], onDelete: Restrict)
  orderId          String
  branchId         String
  // One composite reference carrying id + tenant + store, so a redemption
  // cannot point at another tenant's or another store's order.
  order            Order                     @relation(fields: [orderId, companyId, branchId], references: [id, companyId, branchId], onDelete: Restrict)
  // Snapshots at apply time.
  promotionName    String
  promotionVersion Int
  code             String?
  amount           Decimal                   @default(0) @db.Decimal(10, 2)
  status           PromotionRedemptionStatus @default(APPLIED)
  // Why a reversed redemption was reversed: REMOVED (staff took it off),
  // BASKET_CHANGE (re-evaluation found it no longer eligible), ORDER_VOID.
  reversedReason   String?
  reversedAt       DateTime?
  appliedById      String?
  appliedBy        PosUser?                  @relation("PromotionAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  // Normalised customer identity ("ph:<digits>") used by perCustomerLimit.
  customerKey      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  // A promotion lands on an order once; re-applying after a reversal revives
  // the same row rather than growing a second one.
  @@unique([promotionId, orderId])
  @@index([orderId])
  @@index([companyId, createdAt])
  @@index([promotionId, customerKey])
}

enum PrintTransport {
  TCP // raw socket, conventionally port 9100
  FILE // the agent's own spool directory — dry run, no printer
}

enum PrintPurpose {
  KOT
  RECEIPT
}

enum PrintJobKind {
  KOT
  RECEIPT
  TEST
}

// QUEUED     waiting for its agent
// DISPATCHED handed to the agent, lease running, outcome not yet reported
// CONFIRMED  the agent wrote every byte and the printer connection closed clean
// FAILED     definitely not printed (nothing was written), retries exhausted
// UNCERTAIN  bytes may have reached the printer and nobody can say whether
//            paper came out. NEVER retried automatically: a retry is a second
//            copy of a KOT, and a second KOT is a second dish.
enum PrintJobStatus {
  QUEUED
  DISPATCHED
  CONFIRMED
  FAILED
  UNCERTAIN
}

enum PrintJobResolution {
  REPRINTED // a person asked for a new copy (see PrintJob.reprintOfId)
  CONFIRMED_BY_STAFF // a person looked at the printer and saw the paper
  DISMISSED // a person decided no copy is needed any more
}

// The Store Agent: a small program on a Windows/Linux PC in the store that
// drives the printers the browser cannot. This is the lane's MINIMAL agent
// credential — INTEGRATION(foundation): the foundation lane owns
// Terminal/Device enrolment, and this model is meant to be replaced by (or
// linked to) that Device row; see src/lib/print/agentAuth.js.
model PrintAgent {
  id                 String           @id @default(cuid())
  companyId          String
  branchId           String
  name               String
  status             PrintAgentStatus @default(PENDING)
  // sha256 of the one-time code. Cleared the moment it is used, so a code
  // works exactly once.
  enrolCodeHash      String?          @unique
  enrolCodeExpiresAt DateTime?
  // sha256 of the agent's secret. The secret itself is shown to the agent
  // once and never stored.
  credentialHash     String?          @unique
  enrolledAt         DateTime?
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  lastIp             String?
  platform           String?
  agentVersion       String?
  hostname           String?
  // Last heartbeat as the agent reported it: queue depth, per-printer reach.
  health             Json?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  targets PrintTarget[]
  jobs    PrintJob[]

  @@unique([branchId, name])
  @@index([companyId, branchId])
}

// One printer, as its agent reaches it. `cut` and `drawerKick` say what the
// job may ASK for; whether a given printer obeys has not been tested on any
// physical hardware (see docs/lanes/KITCHEN.md).
model PrintTarget {
  id         String          @id @default(cuid())
  companyId  String
  branchId   String
  agentId    String
  agent      PrintAgent      @relation(fields: [agentId], references: [id])
  name       String
  purpose    PrintPurpose
  // KOT printers only: the station whose lines this printer gets. NULL is a
  // pass printer that gets every line. Restrict, not SET NULL: a station
  // printer silently widening into a pass printer is not a state to reach.
  stationId  String?
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: Restrict)
  transport  PrintTransport
  host       String?
  port       Int?
  // Characters per line in the printer's normal font: 48 for 80 mm, 32 for 58 mm.
  widthChars Int             @default(48)
  cut        Boolean         @default(true)
  drawerKick Boolean         @default(false)
  status     CatalogStatus   @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  jobs PrintJob[]

  @@unique([branchId, name])
  @@index([agentId])
}

model PrintJob {
  id             String              @id @default(cuid())
  companyId      String
  branchId       String
  agentId        String
  agent          PrintAgent          @relation(fields: [agentId], references: [id])
  targetId       String
  target         PrintTarget         @relation(fields: [targetId], references: [id])
  kind           PrintJobKind
  status         PrintJobStatus      @default(QUEUED)
  // "This document to this printer", stable across retries of the request
  // that created it. Unique per store, so a double-clicked print or a replayed
  // KOT is one job.
  idempotencyKey String
  // Device-neutral lines rendered here; the agent turns them into ESC/POS.
  document       Json
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  nextAttemptAt  DateTime            @default(now())
  // Client-chosen token of the claim that dispatched this attempt. A claim
  // repeated with the same token (response lost, agent restarted) gets the
  // same job back instead of a lease that expires into UNCERTAIN.
  claimToken     String?
  dispatchedAt   DateTime?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  lastError      String?
  // The agent's last report as sent — including one that arrived too late to
  // change anything, which is exactly what a person resolving an UNCERTAIN
  // job wants to see.
  lastReport     Json?
  sourceKotId    String?
  sourceOrderId  String?
  // A reprint is a new job pointing at the one it replaces. Unique: one job
  // is reprinted at most once, so a double-clicked reprint is not two copies.
  reprintOfId    String?             @unique
  reprintOf      PrintJob?           @relation("PrintJobReprint", fields: [reprintOfId], references: [id])
  reprintedAs    PrintJob?           @relation("PrintJobReprint")
  reason         String?
  resolution     PrintJobResolution?
  resolvedById   String?
  resolvedAt     DateTime?
  requestedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([branchId, idempotencyKey])
  @@index([agentId, status, nextAttemptAt])
  @@index([branchId, createdAt])
  @@index([sourceKotId])
}

// ============================================================================
// ==== LANE vc104-api ====
// VC-104 Central phone-order centre (spec A§3 VC-104, "Update 5").
//
// The sidecar principle, and the reason nothing below touches Order's money:
// a phone order IS an ordinary Order in the routed store from the moment it is
// submitted. Pricing, tax, KOT, payment and refund therefore reuse the existing
// lifecycle untouched, and recomputeOrder() in lib/orders.js stays the single
// evaluator. Everything this module adds — who called, where it goes, when it
// is wanted, which store accepted — hangs off PhoneOrder BESIDE that Order,
// never inside it.
// ============================================================================

enum PhoneFulfilment {
  PICKUP
  DELIVERY
}

enum PhoneOrderStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

// C-6, unresolved. The GST treatment of a delivery charge turns on two facts
// this project has not established: WHO supplies the delivery (the restaurant
// itself, or a third party), and whether the charge is separate consideration
// for a distinct supply or part of a composite supply of restaurant service.
//
// Those two answers point opposite ways, which is why neither is assumed here:
//   - composite supply by the restaurant  -> the charge belongs INSIDE the
//     order's tax base, at the restaurant rate
//   - separate consideration, third-party supplier -> the charge is not the
//     restaurant's supply at all and must never enter this invoice
//
// Recording the unknown as data rather than leaving it implicit in code means
// the resolution is a backfill, not a schema change — and, because issued
// invoices are immutable, it keeps us from issuing one we would have to correct.
enum DeliverySupplier {
  UNRESOLVED
  RESTAURANT
  THIRD_PARTY
}

enum DeliveryChargeTreatment {
  // The temporary fallback: quoted alongside the order, never folded into
  // Order.total, never taxed. Reversible toward either answer above.
  UNRESOLVED_POST_TAX_FALLBACK
  COMPOSITE_SUPPLY
  SEPARATE_CONSIDERATION
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  // One caller, one row per tenant. The unique pair below is what makes a
  // repeat caller findable by the number they are ringing from, instead of
  // quietly accumulating a second Anita Rao every time someone mistypes.
  phone String
  email String?
  note  String?

  createdById String?
  createdBy   PosUser? @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  addresses   CustomerAddress[]
  phoneOrders PhoneOrder[]

  @@unique([companyId, phone])
  // Composite tenant target. Children key on (id, companyId) so a child row
  // straddling two tenants is a database impossibility, not a code review.
  @@unique([id, companyId])
  @@index([companyId, name])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)

  label    String
  line1    String
  line2    String?
  landmark String?
  city     String
  pincode  String

  isDefault  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  phoneOrders PhoneOrder[]

  @@unique([id, companyId])
  @@index([customerId])
  @@index([companyId, pincode])
}

// Serviceability by pincode. Deliberately not geo: a radius needs coordinates
// this product does not collect and a maps dependency it does not have, and an
// untestable "is 2.4 km within 3 km" is worse than an explicit list the owner
// can read. Radius/polygon can replace this behind the same API later.
model BranchServiceArea {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  pincode        String
  deliveryCharge Decimal  @default(0) @db.Decimal(10, 2)
  minOrder       Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, pincode])
  @@index([companyId, pincode])
}

model BranchHours {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  // 0 = Sunday .. 6 = Saturday, in IST — the business day this product already
  // runs on (istDateOf, UTC+05:30).
  dayOfWeek Int
  // Minutes from midnight IST. closesMinute may exceed 1440 for a store that
  // trades past midnight, which is exactly why these are integers and not
  // clock strings: 23:00-02:00 has to be expressible without a second row.
  opensMinute  Int
  closesMinute Int
  closed       Boolean @default(false)

  @@unique([branchId, dayOfWeek])
  @@index([companyId])
}

// Preparation capacity as orders-per-slot. The spec names "preparation
// capacity" without defining it; this is the narrowest reading that can be
// enforced and tested, and it is per store because kitchens differ.
model BranchPrepCapacity {
  id        String @id @default(cuid())
  companyId String
  branchId  String
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  slotMinutes      Int @default(15)
  maxOrdersPerSlot Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite, not @@unique([branchId]): the relation above is defined on the
  // (branchId, companyId) pair, and a one-to-one needs the unique to cover
  // exactly the fields the relation uses.
  @@unique([branchId, companyId])
  @@index([companyId])
}

model PhoneOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // What the operator reads back down the phone. Per tenant, never reused.
  reference String

  customerId String
  customer   Customer         @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  addressId  String?
  address    CustomerAddress? @relation(fields: [addressId, companyId], references: [id, companyId], onDelete: Restrict)

  fulfilment PhoneFulfilment
  // Explicit fulfilment time. NULL means as-soon-as-possible. The spec requires
  // a SCHEDULED order to carry one, so the route refuses a scheduled order
  // without it rather than inventing a default the caller never agreed to.
  scheduledFor DateTime?

  status PhoneOrderStatus @default(SUBMITTED)

  routedBranchId String
  routedBranch   Branch @relation("PhoneOrderRouted", fields: [routedBranchId, companyId], references: [id, companyId], onDelete: Cascade)

  // Written exactly once, by the winner of the accept race. Its NULL-ness is
  // the guard the conditional UPDATE keys on, which is what makes "exactly one
  // accepting store" a database outcome rather than an application hope.
  acceptedBranchId String?
  acceptedBranch   Branch?   @relation("PhoneOrderAccepted", fields: [acceptedBranchId, companyId], references: [id, companyId], onDelete: Cascade)
  acceptedAt       DateTime?
  acceptedById     String?
  acceptedBy       PosUser?  @relation("PhoneOrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedByName   String?

  rejectedAt     DateTime?
  rejectedById   String?
  rejectedBy     PosUser?  @relation("PhoneOrderRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedByName String?
  rejectReason   String?

  // The real order. One per phone order, enforced by @unique: this is what
  // makes a retried submission incapable of minting a second Order or KOT.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Operator attribution (A§3 VC-104: "with operator attribution").
  //
  // The NAME is the attribution and it is NOT NULL; the id is a convenience
  // join that may go SetNull. Snapshotting follows the same reasoning as the
  // invoice billing snapshot: attribution that depends on a mutable row being
  // present is attribution that can be edited or lost after the fact. It also
  // means a PosUser delete cannot be blocked by this table — which is what
  // stops one suite's leftovers from failing every other suite's teardown.
  operatorId   String?
  operator     PosUser? @relation("PhoneOrderOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorName String
  // INTEGRATION(foundation): the terminal the central desk worked from, when
  // that desk is itself enrolled. No FK yet — foundation owns Terminal.
  terminalId String?

  // QUOTED, not billed. This never reaches Order.total or Order.taxAmount while
  // the treatment below is UNRESOLVED — see the enum comment. recomputeOrder()
  // remains the only thing that writes order money, and it never sees this.
  deliveryCharge          Decimal                 @default(0) @db.Decimal(10, 2)
  deliverySupplier        DeliverySupplier        @default(UNRESOLVED)
  deliveryChargeTreatment DeliveryChargeTreatment @default(UNRESOLVED_POST_TAX_FALLBACK)
  note                    String?

  idempotencyKey String
  // Fingerprint of the body this key first succeeded with. A replay carrying a
  // DIFFERENT body is a caller bug, not a retry, and must not be answered with
  // someone else's order.
  requestHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PhoneOrderEvent[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, routedBranchId, status])
  @@index([customerId])
  @@index([scheduledFor])
}

// Routing history. Separate from PosAuditLog on purpose: this is operational
// narrative the operator screen shows back ("rejected by Indiranagar, moved to
// Church Street"), whereas the audit log is the tamper-evident record. Both are
// written; neither replaces the other.
model PhoneOrderEvent {
  id           String     @id @default(cuid())
  companyId    String
  phoneOrderId String
  phoneOrder   PhoneOrder @relation(fields: [phoneOrderId], references: [id], onDelete: Cascade)

  at      DateTime @default(now())
  action  String
  actorId String?

  fromBranchId String?
  toBranchId   String?
  reason       String?
  meta         Json?

  @@index([phoneOrderId, at])
  @@index([companyId, at])
}
// ---------------------------------------------------------------------------
// LANE accounts — how a real person gets an account, and gets back into one.
//
// The shared rule across every model below: this database never holds anything
// that could be replayed if it leaked. Invitation tokens and reset codes are
// stored as keyed HMAC verifiers (lib/authcodes.js), keyed off POS_JWT_SECRET,
// which is not in the database. A dump yields verifiers that cannot be
// reversed and cannot be presented. The one recoverable secret — the TOTP seed,
// which verification has to recompute from — is encrypted with AES-256-GCM
// under a key derived from the same application secret.
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  // Expiry is derived from expiresAt, exactly as LicenseStatus derives EXPIRED:
  // there is no EXPIRED value here, so no forgotten job can resurrect a stale
  // invitation by failing to run.
}

model UserInvitation {
  id        String   @id @default(cuid())
  // null = an invitation to the platform team (a POS_SUPER_ADMIN operator),
  // which has no tenant. Every customer invitation carries its company.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  email    String
  fullName String
  role     PosRole
  // Store pinning for the invited role, applied when the invitation is
  // accepted. Null for company-wide and platform roles.
  branchId String?
  regionId String?
  // Store ids for an explicit multi-store scope, materialised into
  // UserStoreAssignment rows at acceptance. Empty = scope by role alone.
  storeIds String[] @default([])

  // sha256(token) — same idiom as PosSession.tokenHash. Rotated on every
  // resend, which is what makes the previous link stop working.
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  sentCount  Int              @default(1)
  lastSentAt DateTime         @default(now())

  createdById  String?
  createdBy    PosUser?  @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // The account the acceptance created, kept so the audit trail joins up.
  acceptedById String?
  acceptedBy   PosUser?  @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  revokedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "One open invitation per email" is enforced in the create transaction
  // (prior PENDING rows are revoked first), not by a partial unique index:
  // Prisma cannot express one, and a hand-written index would be dropped by
  // the next `migrate diff` — silently, because the drift check passes.
  @@index([companyId, status])
  @@index([email, status])
}

enum AuthChallengePurpose {
  PASSWORD_RESET
  EMAIL_CHANGE
  MFA_LOGIN
}

// A short-lived, single-account, single-purpose email-code challenge.
//
// Purpose is part of the row, so a code minted to confirm an email change can
// never be presented to reset a password. Attempts are counted in the database
// rather than in memory, so a restart does not hand an attacker a fresh budget,
// and the counter is incremented in the same transaction that checks the code.
model AuthChallenge {
  id      String               @id @default(cuid())
  userId  String
  user    PosUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose AuthChallengePurpose

  // Keyed HMAC of the 8-digit code (lib/authcodes.js). An 8-digit code behind
  // a plain hash would be enumerable offline in milliseconds from a dump.
  codeHash String
  // The address the code was sent to. For EMAIL_CHANGE this is the NEW
  // address — the one being proven — not the account's current email.
  sentTo   String

  attempts     Int       @default(0)
  expiresAt    DateTime
  // Set when a later challenge for the same user+purpose replaced this one. A
  // resend therefore invalidates its predecessor rather than leaving two live
  // codes, which would double an attacker's guessing budget.
  supersededAt DateTime?
  verifiedAt   DateTime?
  // Set the moment the resulting authorization is spent. Consumption is a
  // conditional UPDATE ... WHERE consumedAt IS NULL, so two concurrent requests
  // cannot both spend one challenge.
  consumedAt   DateTime?

  // PASSWORD_RESET only: sha256 of the opaque authorization handed back after
  // the code verifies. Verifying a code does NOT create a session — it creates
  // this, which can do exactly one thing: set a new password.
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?

  requestIp String?
  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

// An enrolled authenticator app. Secrets are encrypted, never hashed, because
// verification recomputes the expected code from the seed.
model TotpCredential {
  id     String  @id @default(cuid())
  userId String  @unique
  user   PosUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AES-256-GCM "iv.tag.ciphertext", key derived from POS_JWT_SECRET.
  secretEnc    String
  // Enrolment is two-step: the row exists from the moment the QR is shown, but
  // MFA is only enforced once a code from the app has been proven here.
  confirmedAt  DateTime?
  // The last TOTP step accepted for this user. Verification requires a
  // strictly greater step, so a code observed over someone's shoulder is
  // already spent by the login that revealed it.
  lastUsedStep BigInt    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-use fallbacks for a lost authenticator. Stored as HMAC verifiers and
// deleted as they are spent, so the row count is the remaining count.
model MfaRecoveryCode {
  id     String  @id @default(cuid())
  userId String
  user   PosUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// Delivery ledger. Deliberately no body column: every message this system
// sends carries a code, a token or a link, and a table of them would be a
// second place to steal from. What is kept is enough to answer "did it go, and
// what happened" — recipient, template, timing, provider response, error.
model EmailOutbox {
  id               String      @id @default(cuid())
  to               String
  template         String
  subject          String
  status           EmailStatus @default(QUEUED)
  attempts         Int         @default(0)
  // The SMTP server's own acceptance line, e.g. "250 2.0.0 Ok: queued as ...".
  // Provider acceptance is not inbox receipt, and this column is the evidence
  // of the former only.
  providerResponse String?
  messageId        String?
  lastError        String?
  sentAt           DateTime?
  // Joins a message back to what caused it, without naming a secret.
  companyId        String?
  userId           String?
  meta             Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([to, createdAt])
}
