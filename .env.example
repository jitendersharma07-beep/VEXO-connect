# Copy to .env and fill in. Never commit .env — it is git-ignored.

# --- Postgres (prod compose) -------------------------------------------------
POSTGRES_USER=atc_pos
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=atc_pos

# --- Postgres (dev compose, docker-compose.yml) -------------------------------
# Deliberately NOT POSTGRES_PASSWORD: the dev scripts run `env -u
# POSTGRES_PASSWORD`, so that name is known to float in shells here, and a
# stray export would silently recreate the dev container with a password the
# database does not have.
#
# This is only read at initdb. If the pos_dev_pgdata volume already exists,
# changing this value does NOT rotate anything — it just makes the container
# environment disagree with the role and breaks every script that reads the
# password back out of the container. To rotate for real:
#   docker exec atc-pos-dev-db psql -U atc_pos -c "ALTER USER atc_pos WITH PASSWORD '<new>'"
# then set the same value here.
#
# Current dev value: read it from the running container —
#   docker exec atc-pos-dev-db printenv POSTGRES_PASSWORD
POS_DEV_DB_PASSWORD=CHANGE_ME_dev_password

# --- Backend -----------------------------------------------------------------
# Dedicated secret for POS — never reuse the ATC NOC / Megatel / AGR secrets.
# Generate with: openssl rand -hex 32
POS_JWT_SECRET=CHANGE_ME_64_hex_chars
# APP_URL is currently read into config and consumed by nothing — keep it right
# anyway, because the Razorpay return/callback URL is exactly what will read it
# first, and a stale value there fails at the worst moment.
APP_URL=https://atcworkspace.com/pos
# The browser origin the API will accept. NOT the path — just scheme + host.
CORS_ORIGIN=https://atcworkspace.com
COOKIE_SECURE=true
# Refused at boot if this is not a positive number. It is what sessions are
# SIGNED with, so a typo here does not fail the deploy — it fails every login
# with a 500, hours later, for everyone.
SESSION_TTL_HOURS=12
# A session opened with a TEMPORARY password expires far sooner, because the
# password was handed over in person or over chat and is not the user's own
# credential yet. Leave this unset unless you mean to change the policy: the
# default is 30 minutes, automatically capped to SESSION_TTL_HOURS so a short
# session setting cannot leave a temporary session outliving a normal one.
# Setting it EXPLICITLY longer than SESSION_TTL_HOURS is refused at boot.
#POS_TEMP_SESSION_TTL_MINUTES=30

# --- Frontend build ----------------------------------------------------------
# Path prefix baked into the bundle at BUILD time, so changing it needs a
# rebuild, not a restart. One build cannot serve two prefixes.
VITE_BASE_PATH=/pos/

# On the dedicated vexoconnect.com domain the three values above become:
#   APP_URL=https://vexoconnect.com
#   CORS_ORIGIN=https://vexoconnect.com
#   VITE_BASE_PATH=/
# Change them together and rebuild the frontend BEFORE flipping nginx — see
# docs/DOMAIN-CUTOVER.md. deploy/go-live-domain.sh refuses to run if the built
# image and these values disagree.

# --- Edge --------------------------------------------------------------------
# Loopback port the host nginx proxies to.
HTTP_PORT=8110

# --- Payment gateway (off) -----------------------------------------------------
# Leaving POS_GATEWAY_PROVIDER unset is what keeps the gateway off, and off is
# the shipped state: with no provider named the routes are not mounted, there is
# no webhook endpoint to probe, and the Sell screen offers no online payment.
# Naming a provider without POS_GATEWAY_WEBHOOK_SECRET is refused at boot rather
# than half-configured, so these are set together or not at all.
#
#   POS_GATEWAY_PROVIDER              razorpay
#   POS_GATEWAY_KEY_ID                the provider's publishable key id
#   POS_GATEWAY_KEY_SECRET            signs API calls and the checkout handoff
#   POS_GATEWAY_WEBHOOK_SECRET        signs webhooks — a DIFFERENT secret, and
#                                     it must equal the one in the provider's
#                                     webhook form or every event is discarded
#   POS_GATEWAY_WEBHOOK_TOLERANCE_SECONDS   default 300
#   POS_GATEWAY_TIMEOUT_MS                  default 20000
#
# For sandbox work on a dev box, do not put these in a file: run
# backend/scripts/dev-gateway-up.sh, which reads them at a hidden prompt into
# one process and never writes them anywhere.

# --- Transactional email (off) -------------------------------------------------
# Same shape as the gateway: leaving SMTP_HOST unset is what keeps mail off, and
# off is the shipped state. Nothing silently degrades — bootstrapping the platform
# administrator refuses outright, and POST /api/users, POST /api/users/:id/
# reset-password and POST /api/invitations answer 503 POS_MAIL_NOT_CONFIGURED. An
# unconfigured deployment therefore cannot create an administrator nobody can
# reach, which is the failure this arrangement exists to prevent.
#
# Set these on the backend service via the deployment's SECRET STORE. SMTP_PASSWORD
# is a live mailbox credential: it does not belong in this file, in the repo (which
# is public), in a chat, or in a terminal that keeps scrollback. Every .env variant
# is git-ignored except this template — verified with `git check-ignore -v`.
#
#   SMTP_HOST                mail.vexoconnect.com  — the domain's own relay; it is
#                            the only host its SPF record names, and the only one
#                            that could DKIM-sign. See docs/ACCOUNTS-GO-LIVE.md §1
#                            for which of those facts are measured vs unverified
#   SMTP_PORT                587
#   SMTP_SECURITY            starttls (587) | tls (465) | none — 'none' is REFUSED
#                            outside dev/test, because it would put the mailbox
#                            password on the wire
#   SMTP_USERNAME            mailbox user                      <-- OWNER INPUT
#   SMTP_PASSWORD            mailbox password                  <-- OWNER INPUT,
#                            secret store only, never a file or a chat
#   MAIL_FROM                VEXO Connect <no-reply@vexoconnect.com>
#   MAIL_REPLY_TO            optional; where replies should land
#   MAIL_ALLOWED_RECIPIENTS  comma-separated allowlist, e.g. '*@vexoconnect.com'.
#                            REQUIRED outside production and refused to be empty
#                            there: it is what stops a copied-in production
#                            database from turning a test run into real mail to
#                            real customers. Leave UNSET in production
#   SMTP_TIMEOUT_MS          default 20000
#
# Half a configuration is refused at boot rather than at the first customer:
# SMTP_HOST without MAIL_FROM, or SMTP_USERNAME without SMTP_PASSWORD, both throw.
#
# Once set, prove it rather than trusting it:
#   node backend/scripts/verify-mail-delivery.mjs <an owner-confirmed recipient>
# It sends one real message through the same sendMail() the product uses and never
# prints the password. It reports SMTP acceptance, which is NOT inbox delivery —
# only a human opening the mailbox closes that gap.

# --- Seed (optional) ----------------------------------------------------------
# If unset, prisma/seed.js generates random passwords and prints them once.
# POS_SEED_ADMIN_PASSWORD=
# POS_SEED_OWNER_PASSWORD=
# POS_SEED_MANAGER_PASSWORD=
# POS_SEED_CASHIER_PASSWORD=
